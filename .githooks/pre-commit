#!/bin/sh
# FleetControl 3.0 — pre-commit
#
# Tre kontroller, hver med sin egen betingelse. Ingen af dem kører på hver
# commit: prisen betales af dem der rører det pågældende.
#
#   firebase.rules.json ændret  →  npm run test:rules
#   src/ ændret                 →  npm run test:design
#   .js/.jsx/.mjs ændret        →  npm run lint
#
# Betingelserne skal passe til det testen LÆSER. En farvetest der kun kørte
# når regelfilen var i diffet, ville aldrig fyre — farver ændres ikke i
# firebase.rules.json. Så ville man have en test der beskriver tilstanden,
# men ikke håndhæver den.
#
# Aktiveres én gang pr. klon:
#   git config core.hooksPath .githooks
#
# Hvorfor rules-delen findes: reglerne var ugyldige fra fundamentet og kunne
# slet ikke indlæses. Det overlevede gennemlæsning og flere redigeringer, og
# blev først fundet da de blev kørt. Se "Låst rækkefølge" i README.

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
FEJL=0

# ---- Designtokens ---------------------------------------------------
# Kører også når testen selv er ændret: snapshottet i den ER beslutningen,
# og en ændring der kun rører testfilen, skal stadig kunne fejle.
if printf '%s\n' "$STAGED" | grep -qE '^(src/|test/design-tokens\.test\.mjs$)'; then
  echo "src/ eller designtesten er ændret — kører npm run test:design …"

  if npm run --silent test:design; then
    echo "Designtestene er grønne."
  else
    FEJL=1
    cat <<'SLUT'

  Designtesten fejlede.

  Enten står der en farve uden for src/fleet/fleet.css, eller også er
  tokenblokken ændret. Er ændringen bevidst, så ret BESLUTNINGER.md FØRST
  og derefter snapshottet i test/design-tokens.test.mjs — i den rækkefølge.
  Retter du kun snapshottet, har du flyttet en beslutning ind i en testfil,
  hvor ingen leder efter den.

SLUT
  fi
fi

# ---- Navne der ikke findes -----------------------------------------
# Kører når som helst JavaScript er ændret — og det er hele pointen:
# `npm run build` er GRØN når en underkomponent læser en variabel der ikke
# findes i dens scope. Fejlen sker først når React render'er, og så er
# skærmen hvid. Det er sket fem gange, og hver gang blev den fundet ved at
# KLIKKE skærmen. Linten afgør det statisk for hele træet.
if printf '%s\n' "$STAGED" | grep -qE '\.(js|jsx|mjs)$'; then
  echo "JavaScript er ændret — kører npm run lint …"

  if npm run --silent lint; then
    echo "Linten er grøn."
  else
    FEJL=1
    cat <<'SLUT'

  Linten fejlede.

  `no-undef` betyder et navn der ikke findes — den fejl giver en HVID skærm
  i browseren, og buildet ser den ikke. `no-unused-vars` betyder oftest en
  import der er glemt efter en omskrivning, men kan også betyde at noget er
  REGNET og aldrig vist. Læs fundet, før du fjerner navnet.

  Reglerne står i eslint.config.js, med begrundelsen for hvorfor der er så
  få af dem.

SLUT
  fi
fi

# ---- Sikkerhedsregler -----------------------------------------------
if printf '%s\n' "$STAGED" | grep -qE '^firebase\.rules\.json$'; then
  echo "firebase.rules.json er ændret — kører npm run test:rules …"

  if npm run --silent test:rules; then
    echo "Regeltesten er grøn."

    # ⚠ ADVARER, BLOKERER IKKE. Paa dette tidspunkt ER drift forventet: du har
    # lige rettet filen og ikke udrullet endnu. En blokering her ville laere
    # folk at bruge --no-verify, og saa er baade den og regeltesten vaek.
    #
    # Testene siger noget om FILEN. Databasen haandhaever det udrullede — og
    # de to var ude af sync i maanedsvis uden at nogen opdagede det.
    # Se beslutning 29.
    if npm run --silent regler:tjek >/dev/null 2>&1; then
      echo "De udrullede regler svarer allerede til filen."
    else
      cat <<'SLUT'

  ! HUSK AT UDRULLE. De udrullede regler er ikke den fil du lige har rettet.

    npm run regler:udrul

  Commit fortsætter — men databasen håndhæver det udrullede, ikke filen.

SLUT
    fi
  else
    FEJL=1
    cat <<'SLUT'

  Regeltesten fejlede.

  Ret reglerne, og kør `npm run test:rules` indtil den er grøn.
  Er fejlen i testen og ikke i reglerne, så ret testen — men lad være med
  at svække den for at komme videre.

SLUT
  fi
fi

if [ "$FEJL" -ne 0 ]; then
  cat <<'SLUT'
  Commit afbrudt.

  Skal du absolut igennem: git commit --no-verify
  Gør det kun hvis du ved præcis hvorfor.

SLUT
  exit 1
fi

exit 0

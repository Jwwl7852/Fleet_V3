# Kopiér denne fil til .env.v1-colleague.local.
# Alle værdier er lokale og syntetiske. Filen indeholder ingen cloudnøgler.
VITE_FB_API_KEY=synthetic
VITE_FB_AUTH_DOMAIN=demo-veyro-integration.firebaseapp.com
VITE_FB_DB_URL=https://demo-veyro-integration-default-rtdb.europe-west1.firebasedatabase.app
VITE_FB_PROJECT_ID=demo-veyro-integration
VITE_FB_APP_ID=1:000000000000:web:local-v1-colleague

VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_PREVIEW=false
VITE_FIREBASE_AUTH_PORT=9099
VITE_FIREBASE_DATABASE_PORT=9000
VITE_FIREBASE_FUNCTIONS_PORT=5001

# Samme rent lokale testkonto oprettes af npm run v1:colleague:seed.
VITE_DEV_EJER_MAIL=kollegatest-admin@example.invalid
VITE_DEV_BRUGER_KODE=Veyro-Kollegatest-Only-2026!

{
  "name": "fleetcontrol",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run lint && npm run test:rules",
    "lint": "eslint .",
    "test:rules": "firebase emulators:exec --only database,storage --project fleetcontrol-rules-test \"node --test\"",
    "test:design": "node --test test/design-tokens.test.mjs",
    "provisioner:dev": "node scripts/provisioner-dev.mjs",
    "regler:tjek": "node scripts/tjek-regler.mjs",
    "regler:udrul": "npm run delt:kopier && firebase deploy --only database --project dev && npm run regler:tjek",
    "storageregler:udrul": "firebase deploy --only storage --project dev",
    "delt:kopier": "node scripts/kopier-delt.mjs",
    "funktioner:udrul": "npm run delt:kopier && firebase deploy --only functions --project dev && npm run funktioner:aabn",
    "kunde:opret": "node scripts/opret-kunde.mjs",
    "funktioner:aabn": "node scripts/funktioner-aabn.mjs",
    "kunde:moduler": "node scripts/kunde-moduler.mjs",
    "ejer:vis": "node scripts/ejer.mjs vis",
    "ejer:giv": "node scripts/ejer.mjs giv",
    "ejer:fjern": "node scripts/ejer.mjs fjern",
    "devtester:vis": "node scripts/dev-tester.mjs vis",
    "devtester:giv": "node scripts/dev-tester.mjs giv",
    "devtester:fjern": "node scripts/dev-tester.mjs fjern"
  },
  "dependencies": {
    "firebase": "^10.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.8.1",
    "firebase-admin": "^14.2.0",
    "globals": "^17.11.0",
    "vite": "^5.4.8"
  }
}

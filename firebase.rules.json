// FleetControl 3.0 — Realtime Database security rules
//
// BEMÆRK om kommentarer: RTDB-regler tillader //-kommentarer som her, men
// IKKE "//": "tekst" som nøgle. En nøgle der ikke starter med '.' læses som
// et stinavn, og et stinavn skal pege på et objekt. Filen brugte den forkerte
// form indtil punkt 0 blev afprøvet i emulatoren — reglerne kunne altså slet
// ikke indlæses. Kør `npm run test:rules` efter hver ændring her.
//
// BESLUTNING 15 — division er et FELT, ikke en sti. Tre værdier:
//   gods | bus | faelles
// Transaktioner hører til én afdeling. Stamdata kan være faelles. Reservationer
// og fravær har INGEN division — de arver fra ressourcen. Gav man en reservation
// en division, ville en chauffør med C+D få to kalendere, og så er beslutning 4
// brudt et niveau højere oppe.
{
  "rules": {
    ".read": false,
    ".write": false,

    "tenants": {
      // Tenant kommer fra custom claim, ALDRIG fra klienten. Rolleskift skal
      // følges af revokeRefreshTokens, ellers beholder brugeren sin gamle
      // adgang indtil tokenet udløber.
      //
      // _findes-MARKØREN. Hver regel herunder kræver at tenanten faktisk er
      // oprettet. Uden den sammenligner reglerne kun claim'et med
      // STISEGMENTET: en token med tenant "spoegelse" ville matche
      // tenants/spoegelse og dermed kunne skrive en helt ny tenant frem.
      // Det er ikke et adgangsbrud — man ser stadig ikke andres data — men
      // det forurener databasen med tenants ingen har oprettet, og de er
      // usynlige indtil nogen leder. Læsesiden er med af samme grund: et
      // opdigtet claim skal ikke kunne få bekræftet at en node er tom.
      //
      // Markøren kan kun sættes med Admin SDK, som går uden om reglerne. En
      // tenant kan derfor kun opstå ved provisionering — aldrig som
      // bivirkning af en skrivning.
      "$tenantId": {

        // Ingen .write. Kan markøren skrives eller slettes fra klienten, er
        // hele tjekket teater — og en sletning ville spærre ens egen tenant.
        "_findes": {
          ".write": false
        },

        // ROLLER — tenantens FAKTISKE rolledefinitioner.
        //
        // roller/<rolleId>/{ navn, perms: ["booking.foreslaa", ...] }
        //
        // perms er et ARRAY og ikke et map: RTDB-noegler maa ikke indeholde
        // punktum, og permission-navnene gor. perms/booking.foreslaa: true er
        // altsaa umuligt. Arrayet er ogsaa det permsFraRolle() returnerer.
        //
        // ROLLE_PERMS i permissions.js er provisioneringsstandarden: hvad en
        // NY tenant faar ved oprettelse. Denne node er hvad tenanten faktisk
        // har, og en kunde skal kunne fjerne fx booking.vaerdiLaes fra sin
        // disponent-rolle uden at nogen skriver kode.
        //
        // Claim'et forbliver haandhaevelsespunktet: reglerne slaar IKKE op
        // her ved hver skrivning. Den Cloud Function der udsteder claims
        // laeser noden, og en aendring traeder i kraft ved naeste
        // token-fornyelse — eller straks med revokeRefreshTokens.
        //
        // .write: false INDTIL den funktion findes, og det er med vilje haardt
        // frem for dokumenteret. Kunne man redigere en rolle nu, ville
        // claim'et ikke blive opdateret: man ville tro man havde fjernet en
        // permission, som stadig virkede. Det er den vaerste fejltilstand af
        // alle, for den ser ud som om den lykkedes. En fejl er bedre end
        // tavshed.
        //
        // Naar funktionen findes, aabnes den for admin med roller.skriv — og
        // aendringer skal auditeres.
        "roller": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": false
        },

        // KLASSIFICEREDE SATELLITTER (beslutning 17).
        // 
        // securityInformation, privatePickupAddress, sensitiveNotes, liveGPS,
        // og fravaerets art (sygdom vs. ferie — helbredsoplysning, GDPR art. 9).
        // 
        // De ligger som SOESKENDE og ikke som barn af objektet. Var sensitive et
        // barn af bookinger/<id>, skulle .read flyttes ned paa bookinger/<id>/general
        // for ikke at kaskadere — og saa kunne man ikke laengere FORESPOERGE paa
        // bookinger. RTDB kraever laeseadgang paa den node man forespoerger paa, saa
        // der ville ikke findes en bookingliste. Soeskende koster eet ekstra opslag
        // paa en detaljeskaerm og nul paa en liste.
        // 
        // Bemaerk at der IKKE er .read paa 'sensitive' selv. Laegges den der,
        // kaskaderer den ned over alle objekterne, og saa er hele opdelingen vaek.
        // 
        // Skrivning kraever BAADE objektets .skriv OG dets sensitiveLaes: kan man
        // ikke laese feltet, skal man heller ikke kunne overskrive det i blinde.
        // sensitive/bookinger er .write: false som bookinger selv.
        "sensitive": {
          "bookinger": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|booking.sensitiveLaes|')",
            ".write": false
          },
          "kunder": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|kunder.sensitiveLaes|')",
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|kunder.skriv|') && auth.token.perms != null && auth.token.perms.contains('|kunder.sensitiveLaes|')"
          },
          "koeretoejer": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.sensitiveLaes|')",
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.skriv|') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.sensitiveLaes|')"
          },
          "fravaer": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|fravaer.sensitiveLaes|')",
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|fravaer.skriv|') && auth.token.perms != null && auth.token.perms.contains('|fravaer.sensitiveLaes|')"
          }
        },
        // VAERDIANSAETTELSE — eget undertrae, ikke en del af sensitive/.
        // 
        // cargoValue og andre beloeb paa selve godset.
        // 
        // Hvorfor ikke bare i sensitive/? Fordi .read er PR. NODE, og de to skal
        // have hver sin permission. Disponenten skal vide at godset kraever
        // foelgebil (sensitive) — ikke at det er 18 millioner vaerd (vaerdi). To
        // permissions kan ikke dele een node, saa de maa ligge hver for sig.
        // 
        // De er SIDEORDNEDE, ikke trin: sensitiveLaes giver ikke vaerdiLaes.
        "vaerdi": {
          "bookinger": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|booking.vaerdiLaes|')",
            ".write": false
          }
        },
        // Aggregerede nøgletal. Skrives kun af Cloud Functions — ellers kan
        // Dashboard og modulerne komme til at vise forskellige tal igen.
        "kpi": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": false
        },

        // Konfliktfrihed kan ikke garanteres fra klienten: to disponenter kan
        // ramme samme sekund. Skrivning går gennem en Cloud Function der
        // tjekker overlap i en transaction.
        // Ingen division her — reservationen arver fra ressourcen.
        "reservationer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": false,
          "$ressourceType": {
            "$ressourceId": {
              ".indexOn": ["fra"]
            }
          }
        },

        // Tilstandsskift valideres server-side mod booking-state.js. En
        // disponent må ikke godkende sit eget forslag, og reservationen skal
        // oprettes atomisk sammen med skiftet.
        // historik under $bookingId er append-only og slettes aldrig.
        "bookinger": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|booking.laes|')",
          ".write": false,
          ".indexOn": ["tilstand", "oprettetMs", "kundeId"]
        },

        // BESLUTNING 16 — etaper ligger som EGEN node, ikke under bookingen.
        // RTDB forespoerger kun paa boernene af een node, og matchningen skal
        // kunne finde "alle aabne etaper paa tvaers af bookinger" med
        // orderByChild("tilstand").equalTo("aaben"). Laa de under hver sin
        // booking, skulle samtlige bookinger hentes ned og gennemsoeges.
        // Flyt dem ikke ind under bookinger — se README.
        //
        // .write: false af samme grund som bookinger: tilstandsskiftet skal
        // ske atomisk sammen med reservationen, ellers kan etapens
        // koeretoejId og dens reservation naa at vaere uenige.
        "etaper": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": false,
          ".indexOn": ["tilstand", "bookingId", "senestMs"],
          "$etapeId": {
            ".validate": "newData.hasChildren(['division'])",
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            }
          }
        },

        // Lagerstamdata: kapacitet og satser. Kapaciteten laeses af
        // tjekLedig() naar den summerer belastningen over et tidsrum.
        "lagre": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|lagre.skriv|')",
          "$lagerId": {
            ".validate": "newData.hasChildren(['division'])",
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            },
            "satser": { ".indexOn": ["gyldigFra"] },
            "haandteringSatser": { ".indexOn": ["gyldigFra"] }
          }
        },

        // Booking-, fragtbrev- og fakturanumre. Kun via transaction i en
        // Cloud Function.
        "countere": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": false
        },

        // Satser overskrives ALDRIG — nye poster med gyldigFra. Ellers ændrer
        // en rettelse i dag prisen på en booking fra sidste kvartal.
        "satser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|satser.skriv|')",
          "$gruppe": {
            "$postId": {
              "satser": { ".indexOn": ["gyldigFra"] }
            }
          }
        },

        "opgaver": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|opgaver.skriv|')",
          ".indexOn": ["dato", "status", "koeretoejId", "chauffoerId"],
          "$opgaveId": {
            ".validate": "newData.hasChildren(['division'])",
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            }
          }
        },

        "koeretoejer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.laes|')",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.skriv|')",
          ".indexOn": ["status", "naesteServiceMs"],
          "$koeretoejId": {
            ".validate": "newData.hasChildren(['division'])",
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" },
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            }
          }
        },

        // Chauffører må oprette, men ikke redigere andres. km er TOTAL
        // målerstand, ikke km siden sidste tankning.
        "indberetninger": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".indexOn": ["oprettetMs", "koeretoejId", "type"],
          "$id": {
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && ((auth.token.perms != null && auth.token.perms.contains('|indberetninger.skriv|')) && (!data.exists() || data.child('oprettetAf').val() === auth.uid) || auth.token.perms != null && auth.token.perms.contains('|indberetninger.skrivAlle|'))",
            ".validate": "newData.hasChildren(['division'])",
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            }
          }
        },

        // Skriver en reservation med kilde 'fravaer' på chaufføren, så en syg
        // chauffør ikke kan disponeres.
        // INGEN division: fraværet hænger på chaufføren, og en chauffør med
        // C+D er fælles — fraværet blokerer ham i begge afdelinger. Gav vi det
        // en division, ville han være syg i gods og rask i bus.
        "fravaer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|fravaer.laes|')",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|fravaer.skriv|')",
          ".indexOn": ["fra"],
          "$fravaerId": {
            "division": { ".validate": false },
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" }
          }
        },

        "facility": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|facility.skriv|')",
          // ÉN kilde til sensorværdier. Både Facility-overblik og
          // Klima-skærmen læser herfra — i mockupsene viste de forskellige
          // temperaturer for samme zoner.
          "sensorer": {
            "$zoneId": {
              "maalinger": { ".indexOn": ["ms"] }
            }
          }
        },

        // beloebOere er ALTID ekskl. moms. momsOere er et separat felt. Bland
        // dem ikke — ellers lægges inkl.-tal sammen med ekskl.-tal i en rapport.
        // faelles er en lovlig division her: én dieselleverance dækker begge
        // afdelinger. Fordelingsnøglen for fælles omkostninger er udskudt.
        "indkoeb": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|indkoeb.skriv|')",
          ".indexOn": ["dato", "leverandoerId", "fakturastatus"],
          "$indkoebId": {
            ".validate": "newData.hasChildren(['division'])",
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            }
          }
        },

        // Bogførte poster slettes ALDRIG. Kun slettet: true med spor.
        "fakturaer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": false,
          ".indexOn": ["fakturadatoMs", "leverandoerId", "godkendelsesstatus"]
        },

        // aktiv er indekseret fordi Kunder & Priser henter kundebasen med
        // orderByChild('aktiv').equalTo(true) gennem useListe. Uden indekset
        // FEJLER forespørgslen ikke — RTDB henter hele noden ned og filtrerer
        // i klienten, med en advarsel i konsollen. Vokser basen ud over ét
        // hent, skal sidsteAktivitetMs med, så listen kan skifte til et
        // tidsvindue.
        "kunder": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|kunder.laes|')",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|kunder.skriv|')",
          ".indexOn": ["navn", "aftaleUdloeberMs", "aktiv"],
          "$kundeId": {
            ".validate": "newData.hasChildren(['division'])",
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" },
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            }
          }
        },

        "idebank": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|idebank.skriv|')",
          ".indexOn": ["oprettetMs", "prioritet"]
        }
      }
    },

    // AUDITLOG — append-only.
    //
    // Hvorfor den ligger her og IKKE under tenants/<id>/audit: RTDB's .read
    // kaskaderer og kan ikke indsnaevres paa et barn. Reglen paa
    // tenants/$tenantId giver laeseadgang til alt nedenunder, og en log over
    // hvem der har set hvad er selv foelsom — den afsloerer hvilke kunder der
    // bliver kigget paa, og af hvem. Som topniveau-node kan den faa sin egen
    // laeseregel. Flyt den ikke ind under tenants/ for at "rydde op".
    //
    // .write: false for ALLE, ogsaa admin. Skrivning sker kun gennem en Cloud
    // Function med Admin SDK, som gaar uden om reglerne. Der findes derfor
    // ingen audit.skriv-permission, og den maa ikke tilfoejes: kan en
    // kompromitteret admin-konto redigere sit eget spor, er loggen vaerdiloes.
    //
    // Stien er audit/<tenantId>/<klasse>/<aar>/<maaned>/<id>. Klassen ligger i
    // stien, fordi retention varierer pr. klasse — saa er sletning "fjern hele
    // partitionen" og ikke en scanning. Se RETENTION_MAANEDER i audit.js.
    "audit": {
      "$tenantId": {
        ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && auth.token.perms != null && auth.token.perms.contains('|audit.laes|')",
        ".write": false,
        "$klasse": {
          "$aar": {
            "$maaned": {
              ".indexOn": ["ms", "brugerUid", "objekt", "korrelationsId"]
            }
          }
        }
      }
    },

    // Opslag uid → tenant. Skrives kun server-side. Bruges til at sætte custom
    // claims, ikke til autorisation i sig selv.
    "brugerTenants": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}

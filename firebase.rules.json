// FleetControl 3.0 — Realtime Database security rules
//
// BEMÆRK om kommentarer: RTDB-regler tillader //-kommentarer som her, men
// IKKE "//": "tekst" som nøgle. En nøgle der ikke starter med '.' læses som
// et stinavn, og et stinavn skal pege på et objekt. Filen brugte den forkerte
// form indtil punkt 0 blev afprøvet i emulatoren — reglerne kunne altså slet
// ikke indlæses. Kør `npm run test:rules` efter hver ændring her.
//
// BESLUTNING 15 — division er et FELT, ikke en sti. Tre værdier:
//   gods | bus | faelles
// Transaktioner hører til én afdeling. Reservationer og fravær har INGEN
// division — de arver fra ressourcen. Gav man en reservation en division,
// ville en chauffør med C+D få to kalendere, og så er beslutning 4 brudt et
// niveau højere oppe.
//
// BESLUTNING 19 — stamdata har ikke en division. En medarbejder er defineret
// ved sine KOMPETENCER, et køretøj ved sin ART. Feltet er derfor FORBUDT på
// personale/ og koeretoejer/, ikke bare valgfrit. faelles bevares på kunder,
// hvor værdien betyder at kundens forretning går på tværs.
//
// Kræver division:  opgaver, indberetninger, etaper, lagre, indkoeb, kunder
// Forbyder den:     personale, koeretoejer, kompetencer, fravaer
{
  "rules": {
    ".read": false,
    ".write": false,

    "tenants": {
      // Tenant kommer fra custom claim, ALDRIG fra klienten. Rolleskift skal
      // følges af revokeRefreshTokens, ellers beholder brugeren sin gamle
      // adgang indtil tokenet udløber.
      //
      // _findes-MARKØREN. Hver regel herunder kræver at tenanten faktisk er
      // oprettet. Uden den sammenligner reglerne kun claim'et med
      // STISEGMENTET: en token med tenant "spoegelse" ville matche
      // tenants/spoegelse og dermed kunne skrive en helt ny tenant frem.
      // Det er ikke et adgangsbrud — man ser stadig ikke andres data — men
      // det forurener databasen med tenants ingen har oprettet, og de er
      // usynlige indtil nogen leder. Læsesiden er med af samme grund: et
      // opdigtet claim skal ikke kunne få bekræftet at en node er tom.
      //
      // Markøren kan kun sættes med Admin SDK, som går uden om reglerne. En
      // tenant kan derfor kun opstå ved provisionering — aldrig som
      // bivirkning af en skrivning.
      "$tenantId": {

        // Ingen .write. Kan markøren skrives eller slettes fra klienten, er
        // hele tjekket teater — og en sletning ville spærre ens egen tenant.
        "_findes": {
          ".write": false
        },

        // ══════════════════════════════════════════════════════════════
        // DE TO NODER UDBYDEREN OGSAA MAA LAESE
        // ══════════════════════════════════════════════════════════════
        //
        // ⚠ UDBYDERKONSOLLEN LAESER IKKE KUNDEDATA. Overhovedet. Den
        // administrerer kundeposten — navn, CVR, hvilke moduler — og de to
        // noder her er ALT hvad et udbyder-claim giver adgang til under
        // tenants/. Alt operationelt kraever stadig
        // auth.token.tenant === $tenantId, praecis som foer.
        //
        // Det er samme princip som beslutning 24: support fik ikke
        // audit.laes paa kundens tenant, den fik et bundet UDTRAEK paa
        // sagen. Giv ikke adgang — lever en afgraenset artefakt.
        //
        // ⚠ REGLERNE LIGGER PAA BOERNENE, ikke paa tenants/$tenantId. En
        // .read dér ville KASKADERE ned over alt, og saa havde udbyderen
        // adgang til hver eneste kundes drift med én linje. Se noten paa
        // tenants/$tenantId om hvorfor den bevidst ikke har nogen .read.
        //
        // .write er false BEGGE steder: kundeposten skrives kun af
        // provisioneren eller en udbyderfunktion med Admin SDK. Hverken
        // kunden eller udbyderen skriver den fra en browser.

        // Virksomhedens stamoplysninger. Kunden laeser sit eget navn i
        // sidebaren; udbyderen laeser det for at kunne vise kundelisten.
        "virksomhed": {
          ".read": "auth != null && ((auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()) || auth.token.udbyder === true)",
          ".write": false
        },

        // ⚠ MODULAFKRYDSNING ER EN KOMMERCIEL KONTROL, IKKE EN
        // SIKKERHEDSKONTROL. En kunde uden Facility der taster /facility,
        // ser SIN EGEN tomme facility-node — en salgsflade, ikke et
        // databrud. At kunder ikke kan naa HINANDENS data er en anden
        // mekanisme, og den maa ikke forveksles med den her. Se
        // fleet/moduler.js.
        // ══════════════════════════════════════════════════════════════
        // ABONNEMENTET — det ENE sted en kundes tilstand staar
        // ══════════════════════════════════════════════════════════════
        //
        // status: aktiv | paused | opsagt.
        //
        // ⚠ DEN LIGGER UNDER TENANTEN, IKKE I UDBYDERINDEKSET. Den stod i
        // udbyder/kunder/<id>/status, hvor KUNDEN ikke kan laese den — og
        // saa kan skaermen ikke fortaelle ham hvorfor han er lukket ude.
        // Samme begrundelse som navnet og modulerne: ét sted, ikke
        // kopieret ind i indekset hvor de to kunne drive fra hinanden.
        //
        // ⚠ LAESEREGLEN HAR IKKE aaben-KLAUSULEN. Den maa ikke have den:
        // det er DENNE node der lukker alle de andre, og kunne den ikke
        // laeses naar den var lukket, ville appen ikke kunne sige hvorfor.
        // En spaerring der ikke kan forklare sig selv, ligner en fejl.
        //
        // ⚠ .write ER false. Statussen saettes af en udbyderfunktion med
        // Admin SDK. En klient der maa skrive den for ÉN tenant, kan
        // skrive den for dem alle — reglen kan ikke kende forskel paa
        // "min kunde" og "en anden kunde", naar begge er kunder.
        "abonnement": {
          ".read": "auth != null && ((auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()) || auth.token.udbyder === true)",
          ".write": false,
          ".validate": "newData.hasChildren(['status', 'aendretMs'])",
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|paused|opsagt)$/)" },
          "aendretMs": { ".validate": "newData.isNumber()" },
          // Hvem der gjorde det. ⚠ uid, ikke personId: det er hvem der
          // GJORDE noget, og det er en ejer uden for kundens personale.
          "aendretAf": { ".validate": "newData.isString() && newData.val().length > 0" },
          // ⚠ ALLOWLISTE, IKKE FRITEKST. Aarsagen ender i auditloggen, og
          // fritekst dér er praecis det audit-regler.js findes for at
          // holde ude.
          "aarsag": { ".validate": "newData.isString() && newData.val().matches(/^(betaling|kundeoensket|proeveperiodeUdloebet|fejloprettet)$/)" },

          // ══════════════════════════════════════════════════════════
          // ABONNEMENTSVILKAAR — skrives af kundeabonnement
          // ══════════════════════════════════════════════════════════
          //
          // ⚠ RABAT I BASISPOINT SOM HELTAL. 1500 = 15,00 %. Samme
          // begrundelse som oere (beslutning 2) og millimeter paa et
          // koeretoej: 15.5 som float giver afrundingsfejl der foerst
          // dukker op paa faktura nummer fyrre.
          //
          // ⚠ 0-10000. En rabat over 100 % ville give en NEGATIV sats,
          // altsaa en kreditnota forkleaedt som et abonnement.
          "rabatBps": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000" },

          // ⚠ RABAT PR. MODUL. Noeglen er modulnavnet; en rabat paa et
          // modul der ikke findes, ville ligge og se ud som en aftale ingen
          // kunne finde igen.
          //
          // ⚠ DEN GENERELLE rabatBps OVERRULER DE HER. Reglen staar i
          // rabatFor() i priser.js — ikke to steder. Reglerne validerer kun
          // FORMEN; hvad der vinder, afgoeres ét sted i koden.
          "rabatModulBps": {
            "$modul": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0 && newData.val() <= 10000" }
          },

          // Kun maaned indtil videre. En kvartalsfaktura er ikke en anden
          // sats — det er en anden PERIODE, og generatoren skal kende den.
          // Et felt der lover noget der ikke virker, er vaerre end intet.
          "interval": { ".validate": "newData.isString() && newData.val().matches(/^(maaned)$/)" },
          "startetMs": { ".validate": "newData.isNumber()" },

          "$andet": { ".validate": false }
        },
        // ══════════════════════════════════════════════════════════════
        // ABONNEMENTSHISTORIKKEN — append-only, og ikke en faktureringskilde
        // ══════════════════════════════════════════════════════════════
        //
        // Hvem aendrede hvad hvornaar, og hvorfor. Skrives af kundemoduler,
        // kundestatus og kundeabonnement i SAMME opdatering som aendringen
        // selv — landede den ene halvdel uden den anden, ville loggen
        // forklare en tilstand kunden ikke har.
        //
        // ⚠ DEN ER IKKE GRUNDLAGET FOR REGNINGEN. Det er
        // udbyder/maalinger/<kunde>/<dato>, som taeller DAGE. To kilder til
        // samme tal driver — og en uenighed om en faktura der allerede er
        // sendt, kan ingen afgoere bagefter. Loggen svarer paa HVEM og
        // HVORFOR, som en maaling ikke kan. Se beslutning 89.
        //
        // ⚠ .write: false, OG DET ER VEJEN DER ER LUKKET — ikke retten.
        // Samme ordning som opgaver (45), kasseudlaan (37) og roller (31b).
        // En append-only log som en klient kunne skrive i, kunne ogsaa
        // rettes i: `.write` kaskaderer, saa en tilladelse paa noden ville
        // give hver eneste post med.
        //
        // ⚠ OG .validate HERUNDER KAN IKKE NAAS AF EN KLIENT. Den beskriver
        // formen serveren skal overholde; haandhaevelsen ligger i
        // valideHistorikpost() i abonnement.js, fordi Admin SDK gaar uden om
        // baade .write og .validate. Skriv ikke en regelproeve der "afviser"
        // en forkert post — den ville vaere groen fordi vejen er lukket.
        //
        // ⚠ KUN UDBYDEREN LAESER DEN — IKKE KUNDEN, OG DET ER ALLEREDE
        // BESLUTTET ET ANDET STED. `aarsag` staar i posten, og om aarsagen
        // siger abonnement.js: *"Den vises ikke for kunden — hvorfor han er
        // lukket, hoerer i en samtale, ikke i en skaerm."* En log kunden
        // kunne laese, ville sige "betaling" paa hans egen skaerm.
        //
        // Naboen `abonnement` ER laesbar for kunden, fordi laaseskaermen skal
        // kunne tegne status. Den viser aldrig aarsagen. Historikken har
        // ingen tilsvarende grund.
        "abonnementHistorik": {
          ".read": "auth != null && auth.token.udbyder === true",
          ".write": false,
          "$postId": {
            ".validate": "newData.hasChildren(['ms', 'afUid', 'art'])",
            "ms": { ".validate": "newData.isNumber()" },
            "afUid": { ".validate": "newData.isString() && newData.val().length > 0" },
            "art": { ".validate": "newData.isString() && newData.val().matches(/^(modul|status|rabat)$/)" },

            // art = modul
            "modul": { ".validate": "newData.isString() && newData.val().length > 0" },
            "til": { ".validate": "newData.isBoolean()" },

            // art = status. Samme allowliste som auditposten bruger; to
            // lister ville betyde at en aarsag kunne staa i den ene log og
            // ikke i den anden.
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|paused|opsagt)$/)" },
            "aarsag": { ".validate": "newData.isString() && newData.val().matches(/^(betaling|kundeoensket|proeveperiodeUdloebet|fejloprettet)$/)" },

            // art = rabat. Basispoint som heltal, som paa abonnementet.
            "rabatBps": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000" },
            "foerBps": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000" },

            "$andet": { ".validate": false }
          }
        },
        "moduler": {
          ".read": "auth != null && ((auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()) || auth.token.udbyder === true)",
          ".write": false
        },

        // ══════════════════════════════════════════════════════════════
        // ⚠ HER LAA `roller/`, OG DEN ER FJERNET — BESLUTNING 31
        // ══════════════════════════════════════════════════════════════
        //
        // Noden var tenantens EGNE rolledefinitioner, .write: false "indtil
        // den Cloud Function der udsteder claims, findes". Den funktion
        // skal ikke findes.
        //
        // Beslutning 31: rollerne er FASTE. En vognmand der fjerner
        // booking.godkend fra sin egen adminrolle, har lukket sig ude — og
        // adgangen til at rette det var selv en permission. Skal en rolle
        // betyde noget andet, er det en aendring i permissions.js og i
        // denne fil, ikke et klik.
        //
        // Claim'et kommer derfor fra ROLLE_PERMS, mintet af `skiftrolle` og
        // af provisioneringen. Der er ingen vej fra en databasenode til en
        // permission, og det er med vilje: en node der KUNNE bestemme hvad
        // en bruger maa, ville vaere et andet haandhaevelsespunkt end
        // tokenet — og to haandhaevelsespunkter er eet for mange.
        //
        // ⚠ OG DEN BLEV LIGGENDE TOM I MAANEDSVIS. Ingen skrev den, ingen
        // laeste den. Det er noejagtig den doede overflade beslutning 31
        // fjernede idebanken for, med sin egen begrundelse: "en node ingen
        // skaerm laeser, er doed overflade — og doed overflade er noget
        // nogen finder paa at bruge til noget." Den begrundelse gjaldt ogsaa
        // her; den var bare ikke anvendt.
        //
        // Genindfoer den ikke uden at afgoere beslutning 31 om.
        //
        // ══════════════════════════════════════════════════════════════
        // ⚠ OG DET ER SKET — BESLUTNING 31b. NODEN ER TILBAGE.
        // ══════════════════════════════════════════════════════════════
        //
        // Kunden kan redigere sine roller. De to farer fra beslutning 31 er
        // haandteret, ikke forsvundet:
        //
        //  1. AT LAASE SIG SELV UDE. `brugere.skriv` kan ikke fjernes fra
        //     den sidste rolle der har den, og heller ikke fra ens egen.
        //     Spaerringen ligger i laaserUde() i permissions.js og haandhaeves
        //     af `rolleskriv` — ikke af skaermen.
        //
        //  2. TO HAANDHAEVELSESPUNKTER. Det var den staerkeste indvending, og
        //     svaret er hele designet:
        //
        //         roller/ er en KILDE, aldrig et HAANDHAEVELSESPUNKT.
        //
        //     ⚠ INGEN REGEL I DEN HER FIL MAA SLAA OP I roller/.
        //     Adgang afgoeres udelukkende af auth.token.perms. Slog en regel
        //     op i noden, ville der vaere to steder adgang blev afgjort — og
        //     de to ville staa og vaere uenige indtil naeste mint, fordi et
        //     token er stille og en node er levende.
        //     test/rules.roller.test.mjs faelder enhver regel der refererer
        //     noden. Skriver du en, er det den proeve du skal laese.
        //
        // .write: false. Noden skrives KUN af `rolleskriv`, som minter claims
        // i samme ombaering og tilbagekalder tokens. Kunne en klient skrive
        // den direkte, ville noden sige eet og tokenet noget andet.
        // ══════════════════════════════════════════════════════════════
        // HVILKE DASHBOARDS EN BRUGER FAAR VIST
        // ══════════════════════════════════════════════════════════════
        //
        // ⚠ DET ER EN VISNING, IKKE EN ADGANG. `kpi` ovenfor er laesbar for
        // ENHVER indlogget bruger i tenanten — ingen permission, ingen
        // modulklausul. En bruger der "naegtes" Warehouse-dashboardet, kan
        // stadig laese kpi/<division>/warehouse direkte.
        //
        // Noden skjuler altsaa et dashboard; den spaerrer det ikke. Det er
        // samme skel som modullisten: en KOMMERCIEL kontrol, ikke en
        // sikkerhedskontrol. Kaldte vi det en adgang, ville nogen slaa
        // OEkonomi fra for en chauffoer og TRO at tallene var utilgaengelige.
        //
        // Vil man have den rigtige spaerring, er det `kpi` der skal deles op
        // pr. domaene med en permission paa hver. Se dashboardvisning.js.
        //
        // .write: false — indstillingen er en ADMINISTRATORS beslutning om
        // en ANDEN bruger, og den hoerer derfor server-side. En bruger der
        // kunne skrive sin egen, kunne give sig selv det samlede overblik
        // tilbage; det ville ikke laekke noget, men indstillingen ville
        // holde op med at betyde det administratoren satte.
        // ══════════════════════════════════════════════════════════════
        // BRUGERENS EGET DASHBOARD-LAYOUT
        // ══════════════════════════════════════════════════════════════
        //
        // ⚠ DEN ENESTE NODE HVOR BRUGEREN SKRIVER SIN EGEN POST.
        //
        // Til forskel fra `dashboardvisning` ved siden af — som er en
        // ADMINISTRATORS beslutning om en ANDEN bruger og derfor er
        // .write: false — er et layout en praeference man har om SIG SELV.
        // Der er ingen grund til at sende den gennem en Cloud Function: den
        // roerer ingen andres data, den skal ikke skrives atomisk sammen med
        // noget, og der er ingen konflikt hvis to faner gemmer samtidig.
        //
        // ⚠ auth.uid === $uid, IKKE bare tenant-medlemskab. Uden det led
        // kunne enhver i virksomheden rette sine kollegers forside — og det
        // ville ikke laekke noget, men det ville vaere en aendring ingen
        // kunne forklare.
        //
        // ⚠ .read er hele tenanten, og det er med vilje: et layout er ikke
        // foelsomt, og en administrator skal kunne se hvad en bruger har
        // gjort ved sin forside naar han spoerger hvorfor et tal er vaek.
        "brugerlayout": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          "$uid": {
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.uid === $uid",
            // Eet layout pr. dashboard. Noeglerne er dashboards.js\u0027 —
            // moenstret er en afskrift, og en prove holder de to op mod
            // hinanden.
            "$dashboard": {
              ".validate": "$dashboard.matches(/^(samlet|booking|flaade|facility|indkoeb|warehouse|unitbooking|bemanding)$/)",
              // ⚠ HER STOD ET LOFT PAA TOLV — pladserne var talt til elleve.
              // Det er vaek. Loftet var en SMAGSDOM ("tyve widgets er ikke et
              // overblik"), og det er en anbefaling, ikke en kendsgerning om
              // systemet. Layoutet er brugerens egen praeference om sin EGEN
              // skaerm, og en graense han ikke kan haeve, er en beslutning
              // taget paa hans vegne uden anden begrundelse end smag.
              //
              // ⚠ DER ER STADIG EN OEVRE GRAENSE — den er bare ikke et tal vi
              // fandt paa. valideLayout() afviser ukendte noegler og dubletter,
              // saa et layout kan aldrig blive laengere end KATALOGET. Reglen
              // kan ikke slaa op i et katalog og proever derfor kun FORMEN: en
              // kort streng pr. plads, og pladsen skal vaere et tal.
              //
              // ⚠ OG DET ER IKKE EN ADGANGSAENDRING. Hvad en bruger maa se,
              // afgoeres af hans rolle og af kundens moduler — ikke af hvor
              // mange kort der er plads til. Se beslutning 43.
              "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && $i.matches(/^[0-9]+$/)" }
            }
          }
        },

        "dashboardvisning": {
          // .read er tenant-medlemskab: skaermen viser hver brugers
          // indstilling, og en bruger skal kunne se sin egen.
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false,
          "$uid": {
            // Kun dashboards vi kender, og kun sandt/falsk. Et ukendt navn
            // ville vaere en indstilling for noget der ikke findes — og den
            // ville blive staaende og se ud som om den betoed noget.
            // Ordlisten staar i dashboards.js; her et moenster, fordi den er
            // kort og lukket.
            "$dashboard": { ".validate": "newData.isBoolean() && $dashboard.matches(/^(samlet|flaade|facility|indkoeb|warehouse|unitbooking|bemanding)$/)" }
          }
        },

        // ══════════════════════════════════════════════════════════════
        // SKIVE 2B — HVILKE ARBEJDSOMRAADER (topniveaupunkter i sidebaren)
        // en bruger faar VIST. Samme snit som dashboardvisning ovenfor,
        // felt for felt — se src/fleet/navvisning.js for begrundelsen.
        //
        // ⚠ EN VISNING, ALDRIG EN ADGANG. Ingen regel nogetsteds i denne
        // fil laeser navvisning — det ville vaere den fejl der laver
        // "skjul" om til "spaer", som dashboardvisning.js's hoved advarer
        // imod. Mekanismen kan kun faa AppShell til at TEGNE mindre; den
        // roerer aldrig hvad en laesning eller skrivning et andet sted i
        // denne fil TILLADER.
        //
        // .write: false — indstillingen er en ADMINISTRATORS beslutning om
        // en ANDEN bruger, samme grund som dashboardvisning: en bruger der
        // kunne skrive sin egen, kunne aabne noget administratoren havde
        // lukket for ham.
        "navvisning": {
          // .read er tenant-medlemskab: skaermen viser hver brugers
          // indstilling, og en bruger skal kunne se sin egen.
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false,
          "$uid": {
            // Kun arbejdsomraader vi kender, og kun sandt/falsk. Et ukendt
            // navn ville vaere en indstilling for noget der ikke findes —
            // og "dashboard"/"support" staar med VILJE uden for listen,
            // fordi de to er faste og ikke kan skjules. Ordlisten staar i
            // navvisning.js's OMRAADER; her et moenster, fordi den er kort
            // og lukket.
            "$omraade": { ".validate": "newData.isBoolean() && $omraade.matches(/^(kunderOversigt|fakturacenter|leverandoerer|oekonomi|booking|flaade|facility|indkoeb|warehouse|unitbooking|bemanding|opsaetning)$/)" }
          }
        },

        "roller": {
          // .read er tenant-medlemskab: skaermen skal kunne vise hvad en
          // rolle indeholder. Det er ikke foelsomt — det er kundens eget
          // opslag over hvad hans egne roller betyder.
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false,
          "$rolle": {
            // ⚠ ORDLISTEN STAAR I permissions.js. Her et laengdetjek, som paa
            // opgaver.status: en afskrift i regelfilen ville vaere et andet
            // sted de syv rollenavne stod, med sin egen udrulningscyklus.
            ".validate": "newData.hasChildren(['perms'])",
            "perms": {
              // ⚠ ET ARRAY AF STRENGE, IKKE ET OBJEKT. Raekkefoelgen betyder
              // noget: claim-strengen sammenlignes med contains(), og to
              // brugere med de samme permissions i forskellig raekkefoelge
              // ville faa to forskellige strenge. permsForTenant() sorterer
              // efter katalogets orden foer mintningen.
              "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" }
            },
            "aendretAf": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "aendretMs": { ".validate": "newData.isNumber()" },
            "$andet": { ".validate": false }
          }
        },

        // RETENTION — beslutning 115. Kun legal hold rører databasen; selve
        // sletningen/anonymiseringen er IKKE bygget (se retention-regler.js).
        //
        // ⚠ INGEN MODULKLAUSUL — som roller/brugere/countere. Legal hold er
        // en governance-funktion, ikke knyttet til noget kommercielt modul.
        "retention": {
          "legalHold": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|retention.laes|')",
            // ⚠ .write: false. `satAf`/`satMs` skal komme fra SERVEREN, ikke
            // fra klienten — samme grund som statusmeldingens uid, og
            // handlingen skal logges atomisk med skrivningen. Kun
            // `retentionLegalHold` er vejen ind. Formen står alligevel her,
            // som på `sager` — Admin-SDK'et går uden om `.validate`, men en
            // feltliste der ikke passer til dataene, giver aldrig en fejl.
            ".indexOn": ["objekt", "objektId"],
            "$id": {
              ".write": false,
              ".validate": "newData.hasChildren(['objekt', 'objektId', 'aarsag', 'satAf', 'satMs'])",
              // ⚠ objekt+objektId ER POLYMORFT, som sagers objektId. Et hold
              // kan pege på en booking, en indberetning, en hvilken som
              // helst post — et fast eksistenstjek kan ikke skifte mål.
              "objekt": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "objektId": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "aarsag": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
              "satAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "satMs": { ".validate": "newData.isNumber()" },
              "ophaevetAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "ophaevetMs": { ".validate": "newData.isNumber()" },
              "$andet": { ".validate": false }
            }
          }
        },


        // ══════════════════════════════════════════════════════════════
        // BRUGERINDEKSET — fordi en klient ikke kan liste konti
        // ══════════════════════════════════════════════════════════════
        //
        // ⚠ FIREBASE AUTH HAR INGEN listUsers PAA KLIENTSIDEN. Skaermen
        // kunne derfor ikke vise hvem der har adgang — og en opdigtet
        // brugerliste er vaerre end ingen: den viser konti der ikke findes
        // og skjuler dem der goer.
        //
        // Noden her er et INDEKS skrevet af den Cloud Function der opretter
        // brugeren. Den er ikke sandheden — Auth er sandheden — men den er
        // det eneste en klient kan laese, og funktionen skriver begge dele i
        // samme kald.
        //
        // Alternativet var at lade funktionen liste ALLE konti og filtrere
        // paa tenant. Det skanner hver eneste kundes brugere ved hvert
        // opslag, og en filtrering man selv skriver, er en filtrering man kan
        // komme til at glemme. Et indeks pr. tenant kan ikke laekke paa
        // tvaers, fordi det ligger UNDER tenanten.
        //
        // ⚠ INGEN LOESEN, INGEN CLAIMS. Kun navn, mail, rolle og om kontoen
        // er spaerret. Claims staar i tokenet, hvor de hoerer hjemme; laa de
        // ogsaa her, ville de to kunne drive fra hinanden — og indekset ville
        // vaere det man kiggede paa.
        //
        // .read er tenant-medlemskab som paa roller: hvem der arbejder her, er
        // ikke hemmeligt for kollegerne. .write er false — indekset skrives
        // kun af funktionen, sammen med den rigtige konto.
        // ⚠ `personId` KOBLER ET LOGIN TIL EN MEDARBEJDER — beslutning 103.
        //
        // Brugerposten bar `email`, `navn`, `rolle` og `spaerret`, og INTET
        // der sagde hvilken medarbejder kontoen tilhoerer. En chauffoer kunne
        // logge ind, og systemet kunne ikke svare paa hvilke etaper der var
        // hans: etapen baerer et `personId`, tokenet baerer et `uid`, og de to
        // moedtes ingen steder.
        //
        // Det er praecis den skelnen CLAUDE.md navngiver — `uid` er hvem der
        // GJORDE noget, `personId` hvem det HANDLER om — og lige her skal de
        // to kunne bindes sammen ÉT sted. Brugerposten er stedet: den er
        // noeglet paa uid, saa en regel kan slaa op i O(1). Lagde vi `uid` paa
        // personale-posten i stedet, skulle en regel SCANNE for at svare
        // "hvem er jeg", og det kan RTDB ikke.
        //
        // ⚠ FELTET ER VALGFRIT. En admin paa kontoret er ikke noedvendigvis en
        // medarbejder i `personale`, og en chauffoer har maaske slet intet
        // login. Kun den der skal bruge appen, behoever koblingen.
        "brugere": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false,
          ".indexOn": ["rolle", "spaerret"],
          "$uid": {
            "personId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('personale').child(newData.val()).exists()" },
            // ⚠ spaerretMs — beslutning 115. Sættes kun af spaerlogin, bevares
            // af skiftrolle. Retention-arbejdet har brug for et tidspunkt at
            // regne fra, ikke bare en boolean.
            "spaerret": { ".validate": "newData.isBoolean()" },
            "spaerretMs": { ".validate": "newData.isNumber()" }
          }
        },

        // KLASSIFICEREDE SATELLITTER (beslutning 17).
        // 
        // securityInformation, privatePickupAddress, sensitiveNotes, liveGPS,
        // og fravaerets art (sygdom vs. ferie — helbredsoplysning, GDPR art. 9).
        // 
        // De ligger som SOESKENDE og ikke som barn af objektet. Var sensitive et
        // barn af bookinger/<id>, skulle .read flyttes ned paa bookinger/<id>/general
        // for ikke at kaskadere — og saa kunne man ikke laengere FORESPOERGE paa
        // bookinger. RTDB kraever laeseadgang paa den node man forespoerger paa, saa
        // der ville ikke findes en bookingliste. Soeskende koster eet ekstra opslag
        // paa en detaljeskaerm og nul paa en liste.
        // 
        // Bemaerk at der IKKE er .read paa 'sensitive' selv. Laegges den der,
        // kaskaderer den ned over alle objekterne, og saa er hele opdelingen vaek.
        // 
        // Skrivning kraever BAADE objektets .skriv OG dets sensitiveLaes: kan man
        // ikke laese feltet, skal man heller ikke kunne overskrive det i blinde.
        // sensitive/bookinger er .write: false som bookinger selv.
        "sensitive": {
          "bookinger": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|booking.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
            ".write": false
          },
          "kunder": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|kunder.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('kunder').val() === true)",
            // ⚠ .write LIGGER PAA POSTEN, IKKE PAA NODEN — beslutning 53.
            // Laa den her, kunne ET kald tomme hele den klassificerede
            // satellit. MAALT: det kunne den, for alle fire.
            "$id": {
              // ⚠ newData.exists(): en klassificeret post forsvinder ikke.
              // Reglerne binder KLIENTEN; en sletning der virkelig skal ske —
              // en GDPR-sletning af en medarbejder — hoerer hos servicekontoen,
              // som gaar uden om reglerne. Retten til at blive glemt bliver
              // altsaa ikke spaerret her; den flyttes hen hvor den kan besluttes
              // og logges.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|kunder.skriv|') && auth.token.perms != null && auth.token.perms.contains('|kunder.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('kunder').val() === true) && newData.exists()"
            }
          },
          "koeretoejer": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)",
            // ⚠ .write LIGGER PAA POSTEN, IKKE PAA NODEN — beslutning 53.
            // Laa den her, kunne ET kald tomme hele den klassificerede
            // satellit. MAALT: det kunne den, for alle fire.
            "$id": {
              // ⚠ newData.exists(): en klassificeret post forsvinder ikke.
              // Reglerne binder KLIENTEN; en sletning der virkelig skal ske —
              // en GDPR-sletning af en medarbejder — hoerer hos servicekontoen,
              // som gaar uden om reglerne. Retten til at blive glemt bliver
              // altsaa ikke spaerret her; den flyttes hen hvor den kan besluttes
              // og logges.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.skriv|') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true) && newData.exists()"
            }
          },
          "personale": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|personale.sensitiveLaes|')",
            // ⚠ .write LIGGER PAA POSTEN, IKKE PAA NODEN — beslutning 53.
            // Laa den her, kunne ET kald tomme hele den klassificerede
            // satellit. MAALT: det kunne den, for alle fire.
            "$id": {
              // ⚠ newData.exists(): en klassificeret post forsvinder ikke.
              // Reglerne binder KLIENTEN; en sletning der virkelig skal ske —
              // en GDPR-sletning af en medarbejder — hoerer hos servicekontoen,
              // som gaar uden om reglerne. Retten til at blive glemt bliver
              // altsaa ikke spaerret her; den flyttes hen hvor den kan besluttes
              // og logges.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|personale.skriv|') && auth.token.perms != null && auth.token.perms.contains('|personale.sensitiveLaes|') && newData.exists()"
            }
          },
          "fravaer": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|fravaer.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true)",
            // ⚠ .write LIGGER PAA POSTEN, IKKE PAA NODEN — beslutning 53.
            // Laa den her, kunne ET kald tomme hele den klassificerede
            // satellit. MAALT: det kunne den, for alle fire.
            "$id": {
              // ⚠ newData.exists(): en klassificeret post forsvinder ikke.
              // Reglerne binder KLIENTEN; en sletning der virkelig skal ske —
              // en GDPR-sletning af en medarbejder — hoerer hos servicekontoen,
              // som gaar uden om reglerne. Retten til at blive glemt bliver
              // altsaa ikke spaerret her; den flyttes hen hvor den kan besluttes
              // og logges.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|fravaer.skriv|') && auth.token.perms != null && auth.token.perms.contains('|fravaer.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true) && newData.exists()"
            }
          },

          // ⚠ NODEN FANDTES IKKE — men CLAUDE.md beskrev dens regel som
          // gaeldende: "sensitive/…/underskrift er write-once i reglerne
          // (!data.exists())". Den regel stod ingen steder. En dokumenteret
          // spaerring uden haandhaevelse er den vaerste slags: den staar i
          // vejen for at nogen bygger den, og den stopper ingenting.
          //
          // indberetninger.js har hele tiden sagt hvad der skulle ske:
          // PERM_SENSITIVE_LAES_PLANLAGT tilfoejes "i SAMME ombaering som
          // reglerne og deres tests — ikke foer". Det er den ombaering.
          //
          // ⚠ NODEN FINDES FOR ALLE ARTER, ogsaa de fleste med et TOMT objekt.
          // At et felt er skjult, er i sig selv en oplysning: skjulte vi kun
          // skadebeskrivelsen naar der ER en skade, kunne man laese af
          // haengelaasen at der skete noget. Samme indsigt som cargoValue.
          "indberetninger": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|indberetninger.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)",

            "$id": {
              // Den der skriver den klassificerede del, skal baade kunne
              // skrive indberetningen og se det klassificerede — ellers kunne
              // man skrive noget ind man ikke selv maatte laese igen.
              //
              //
              // ⚠ SIDSTE LED: EN UNDERSKREVET POST ER FROSSET.
              //
              // Underskriften havde `.validate: "!data.exists()"`, og to proever
              // sagde at den holdt. Ingen af dem SLETTEDE foerst — og en
              // .validate koeres IKKE ved en sletning. MAALT i emulatoren kunne
              // en bruger med indberetninger.skriv + sensitiveLaes:
              //   remove() underskriften                  → TILLADT
              //   update({underskrift: null})             → TILLADT
              //   remove() HELE den klassificerede post   → TILLADT
              // og derefter skrive en ny underskrift      → TILLADT.
              // Write-once var altsaa brudt i to trin.
              //
              // ⚠ OG DET DAEKKER MERE END UNDERSKRIFTEN SELV. Kunne
              // skadeBeskrivelsen rettes bagefter, ville underskriften bevise
              // noget andet end det der blev skrevet under paa — og saa er den
              // lige saa lidt vaerd som en der kunne redigeres. Derfor er hele
              // posten frossen, ikke kun feltet. En rettelse er en NY
              // indberetning der henviser til den gamle; det er det samme svar
              // som feltet allerede gav.
              //
              // ⚠ DET KAN IKKE LOESES PAA BARNET. .write kaskaderer ned, og et
              // strammere barn kan ikke tilbagekalde en forfaders tilladelse —
              // samme kendsgerning som beslutning 17 bygger paa for .read.
              // Leddet staar derfor HER, hvor skrivningen tillades.
              //
              // ⚠ RAEKKEFOELGEN ER DERMED BESTEMT: beskrivelse og modpart
              // FOERST, underskrift SIDST. Det er ogsaa den rigtige vej rundt —
              // man skriver under paa noget der staar der i forvejen. Skaermen
              // er ren visning i dag, saa der er intet floew at braekke; det
              // blev maalt, ikke antaget.
              //
              // Samme fejlklasse som beslutning 38 navngav: en .validate siger
              // hvad der maa STAA, aldrig hvad der maa FORSVINDE.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|indberetninger.skriv|') && auth.token.perms != null && auth.token.perms.contains('|indberetninger.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true) && !data.child('underskrift').exists()",

              "skadeBeskrivelse": { ".validate": "newData.isString() && newData.val().length <= 2000" },

              "modpart": {
                "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
                "rolle": { ".validate": "newData.isString() && newData.val().length <= 120" },
                "telefon": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "$andet": { ".validate": false }
              },

              // ⚠ WRITE-ONCE. Reglen CLAUDE.md allerede beskrev: en
              // underskrift skrives én gang og rettes ALDRIG. En rettelse er
              // en NY indberetning der henviser til den gamle. Et bevis der
              // kan redigeres, beviser ingenting.
              //
              // !data.exists() paa selve underskriften — ikke paa et enkelt
              // felt i den. Kunne man rette navnet bagefter, var det stadig
              // en redigeret underskrift.
              "underskrift": {
                ".validate": "!data.exists() && newData.hasChildren(['navn', 'ms'])",
                "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
                "billedeSti": { ".validate": "newData.isString() && newData.val().length <= 200" },
                // personId, ikke uid: det er hvem underskriften HANDLER OM.
                // Modparten har som regel slet intet login, og feltet er
                // derfor ofte null — navnet og stedet baerer beviset.
                //
                // ⚠ MEN STAAR DER ET personId, SKAL PERSONEN FINDES.
                // Feltet er valgfrit; en underskrift uden er en modpart uden
                // login. En underskrift MED et personId der peger paa
                // ingenting, er derimod et bevis der udpeger en medarbejder
                // ingen kan slaa op — og posten er FROSSET (beslutning 52),
                // saa den kan ikke rettes bagefter. Se beslutning 101.
                "personId": { ".validate": "newData.isString() && newData.val().length <= 60 && root.child('tenants').child($tenantId).child('personale').child(newData.val()).exists()" },
                "stedTekst": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "ms": { ".validate": "newData.isNumber()" },
                "$andet": { ".validate": false }
              },

              "$andet": { ".validate": false }
            }
          },

          // SENSITIVE/SAGER — beslutning 20/112. Braedteksten er fritekst fra
          // internettet: navne, telefonnumre, foer eller siden en
          // helbredsoplysning. Samme deling som beslutning 17: .read kaskaderer,
          // saa den kan ikke ligge som barn af sagen uden at ogsaa laase
          // sagslisten.
          //
          // ⚠ .write LIGGER PAA $sagId, IKKE PAA NODEN — samme fejl som beslutning
          // 53 rettede paa de fire andre klassificerede satellitter: laa den paa
          // noden, kunne ET kald tomme hele traaden for enhver sag.
          "sager": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|sag.sensitiveLaes|')",
            "$sagId": {
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|sag.skriv|') && auth.token.perms != null && auth.token.perms.contains('|sag.sensitiveLaes|') && newData.exists()",
              "beskeder": {
                "$id": {
                  // ⚠ SKIVE 3D — kanal ER NU PÅKRÆVET. sagMailSend skriver
                  // "mail", sagBeskedSkriv skriver "internNote" eksplicit —
                  // se sammes ændring i functions/index.js. Uden feltet kunne
                  // en intern note og en rigtig udgående mail ikke skelnes i
                  // SAMME tråd, og de deler bevidst node: modtagere stod her
                  // klar siden beslutning 20, længe før 3D skrev noget i det.
                  //
                  // ⚠ OG EN DIREKTE KLIENTSKRIVNING KAN KUN VÆRE "internNote".
                  // Denne node har haft en reel betinget klient-.write siden
                  // Skive 3C (sag.skriv + sag.sensitiveLaes, se $sagId
                  // ovenfor) — af den grund kan en klient med de to
                  // permissions TEKNISK skrive direkte uden om
                  // sagBeskedSkriv, ligesom kommentaren ved rules.sager.test
                  // altid har sagt. Uden dette ekstra tjek kunne den samme
                  // klient forfalske en "mail" ved at sætte kanal: "mail" og
                  // mailStatus: "accepteret" direkte — en tråd der PÅSTÅR en
                  // ekstern mail blev sendt, uden at sagMailSend's
                  // modtageropløsning, rate limit eller audit nogensinde blev
                  // rørt. Kun Admin SDK (sagMailSend) kan skrive kanal:
                  // "mail" — Admin SDK går uden om .validate, så dette
                  // rammer kun en direkte klientskrivning.
                  ".validate": "newData.hasChildren(['ms', 'retning', 'tekst', 'kanal']) && newData.child('kanal').val() === 'internNote'",
                  "ms": { ".validate": "newData.isNumber()" },
                  "retning": { ".validate": "newData.isString() && newData.val().matches(/^(indgaaende|udgaaende)$/)" },
                  "kanal": { ".validate": "newData.isString() && newData.val().matches(/^(internNote|mail)$/)" },
                  // ⚠ ENVELOPE-AFSENDEREN, ALDRIG From:. Se vurderAfsender() i
                  // sager.js — From: er fritekst afsenderen selv skriver.
                  "afsender": { ".validate": "newData.isString() && newData.val().length <= 254" },
                  "afsenderNavn": { ".validate": "newData.isString() && newData.val().length <= 120" },
                  "modtagere": { "$mid": { ".validate": "newData.isString() && newData.val().length <= 254" } },
                  "emne": { ".validate": "newData.isString() && newData.val().length <= 250" },
                  "tekst": { ".validate": "newData.isString() && newData.val().length <= 10000" },
                  "afsenderStatus": { ".validate": "newData.isString() && newData.val().matches(/^(kendt|karantaene|afvist)$/)" },
                  "dmarc": { ".validate": "newData.isString() && newData.val().matches(/^(pass|fail|none)$/)" },
                  // ⚠ SKIVE 3D — kun til stede når kanal === "mail". partId er
                  // en kontrolleret reference til DENNE sags egen parter —
                  // ikke en fri adresse. mailStatus er lukket vokabular, aldrig
                  // fritekst. providerId/fejlAarsag er korte, upersonlige felter
                  // fra transportlaget, aldrig en fuld exception-stak.
                  "partId": { ".validate": "newData.isString() && newData.val().length <= 60" },
                  "mailStatus": { ".validate": "newData.isString() && newData.val().matches(/^(anmodet|accepteret|fejlet)$/)" },
                  "providerId": { ".validate": "newData.isString() && newData.val().length <= 200" },
                  "fejlAarsag": { ".validate": "newData.isString() && newData.val().length <= 250" },
                  // ⚠ FEJLER LUKKET — se maaHentes() i sager.js. Status starter
                  // og bliver paa afventerScan indtil en scanner har sagt andet;
                  // den bliver ALDRIG antaget ren.
                  "vedhaeftninger": {
                    "$vid": {
                      ".validate": "newData.hasChildren(['navn', 'status'])",
                      "navn": { ".validate": "newData.isString() && newData.val().length <= 200" },
                      "status": { ".validate": "newData.isString() && newData.val().matches(/^(afventerScan|ren|blokeret)$/)" },
                      "$andet": { ".validate": false }
                    }
                  },
                  "$andet": { ".validate": false }
                }
              },
              "karantaene": {
                "$id": {
                  ".validate": "newData.hasChildren(['ms', 'retning', 'tekst', 'aarsag'])",
                  "ms": { ".validate": "newData.isNumber()" },
                  "retning": { ".validate": "newData.isString() && newData.val().matches(/^(indgaaende|udgaaende)$/)" },
                  "afsender": { ".validate": "newData.isString() && newData.val().length <= 254" },
                  "afsenderNavn": { ".validate": "newData.isString() && newData.val().length <= 120" },
                  "modtagere": { "$mid": { ".validate": "newData.isString() && newData.val().length <= 254" } },
                  "emne": { ".validate": "newData.isString() && newData.val().length <= 250" },
                  "tekst": { ".validate": "newData.isString() && newData.val().length <= 10000" },
                  "afsenderStatus": { ".validate": "newData.isString() && newData.val().matches(/^(kendt|karantaene|afvist)$/)" },
                  "dmarc": { ".validate": "newData.isString() && newData.val().matches(/^(pass|fail|none)$/)" },
                  "vedhaeftninger": {
                    "$vid": {
                      ".validate": "newData.hasChildren(['navn', 'status'])",
                      "navn": { ".validate": "newData.isString() && newData.val().length <= 200" },
                      "status": { ".validate": "newData.isString() && newData.val().matches(/^(afventerScan|ren|blokeret)$/)" },
                      "$andet": { ".validate": false }
                    }
                  },
                  "aarsag": { ".validate": "newData.isString() && newData.val().length <= 250" },
                  "$andet": { ".validate": false }
                }
              },
              // ⚠ MAILEN ER IKKE EN FEMTE kilde.type. Det bekraeftede forslag
              // bliver et vaerkstedsbesoeg (kilde.type: vaerksted, prioritet
              // 40) eller en facilitySag (prioritet 20) — se
              // reservationFraAftale() i sager.js. ressourceType matcher
              // praecis reservationer/<type>.
              "aftaleforslag": {
                "$id": {
                  ".validate": "newData.hasChildren(['tilstand', 'ressourceType', 'ressourceId'])",
                  "tilstand": { ".validate": "newData.isString() && newData.val().matches(/^(forslag|aftalt|afvist)$/)" },
                  "fra": { ".validate": "newData.isNumber()" },
                  "til": { ".validate": "newData.isNumber()" },
                  "sted": { ".validate": "newData.isString() && newData.val().length <= 120" },
                  "ressourceType": { ".validate": "newData.isString() && newData.val().matches(/^(koeretoej|medarbejder|facilityAktiv|lokation|lager)$/)" },
                  "ressourceId": { ".validate": "newData.isString() && newData.val().length <= 60" },
                  // ⚠ DATOEN ER ET GAET — udtrukketSaetning er citatet det blev
                  // laest af, saa mennesket kan se hvad maskinen laeste. Aldrig
                  // forudfyldt og bekraeftet i ét klik.
                  "udtrukketFra": { ".validate": "newData.isString() && newData.val().length <= 60" },
                  "udtrukketSaetning": { ".validate": "newData.isString() && newData.val().length <= 500" },
                  "bekraeftetAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
                  "bekraeftetMs": { ".validate": "newData.isNumber()" },
                  "$andet": { ".validate": false }
                }
              },
              "$andet": { ".validate": false }
            }
          }
        },
        // VAERDIANSAETTELSE — eget undertrae, ikke en del af sensitive/.
        // 
        // cargoValue og andre beloeb paa selve godset.
        // 
        // Hvorfor ikke bare i sensitive/? Fordi .read er PR. NODE, og de to skal
        // have hver sin permission. Disponenten skal vide at godset kraever
        // foelgebil (sensitive) — ikke at det er 18 millioner vaerd (vaerdi). To
        // permissions kan ikke dele een node, saa de maa ligge hver for sig.
        // 
        // De er SIDEORDNEDE, ikke trin: sensitiveLaes giver ikke vaerdiLaes.
        "vaerdi": {
          "bookinger": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|booking.vaerdiLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
            ".write": false
          }
        },
        // PERSONALE — beslutning 18. Ligger i BASEN: enhver
        // abonnementskombination har medarbejdere.
        //
        // Noeglen er et personId, ikke et uid. En person findes foer sit login
        // og efter det — en chauffoer har maaske aldrig et, en vikar sjaeldent.
        // uid er hvem der GJORDE noget (indberetninger.oprettetAf, auditloggen);
        // personId er hvem det HANDLER OM (reservationer, fravaer, opgaver,
        // etaper, kompetencer). Bytter man om, holder ejerskabstjekket i
        // reglerne op med at virke.
        //
        // .write ligger paa $personId og ikke paa samlingen, saa
        // newData.exists() kan afvise en SLETNING. En fratraadt medarbejder
        // bliver staaende — der haenger reservationer og indberetninger paa
        // id'et. Paa samlingen ville newData stadig findes efter at een person
        // var slettet.
        //
        // INGEN DIVISION — beslutning 19. Stamdata har ikke en division. En
        // medarbejder er defineret ved sine KOMPETENCER, ikke ved en afdeling:
        // hun oprettes een gang og virker i alle moduler tenanten har adgang
        // til. Feltet er derfor forbudt her, ikke bare valgfrit — et felt der
        // maa staa der, men ikke betyder noget, bliver udfyldt og derefter
        // laest af nogen. Samme behandling som fravaer og kompetencer.
        "personale": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|personale.laes|')",
          ".indexOn": ["uid", "status"],
          "$personId": {
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|personale.skriv|') && newData.exists()",
            ".validate": "newData.hasChildren(['navn', 'status'])",
            "division": { ".validate": false },
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|orlov|fratraadt)$/)" },
            "ansaettelsesform": { ".validate": "newData.isString() && newData.val().matches(/^(fastansat|vikar|ekstern)$/)" },
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" },
            // ⚠ uid ER HVEM DER GJORDE NOGET. personId er hvem det HANDLER om,
            // og noeglen her ER et personId. Feltet er VALGFRIT med vilje: en
            // chauffoer har maaske aldrig et login, og en vikar har det
            // sjaeldent. Personen findes foer sin konto og efter den.
            "uid": { ".validate": "newData.isString() && newData.val().length > 0" },

            // Felterne herunder kom med skrivningen. De kunne laeses laenge
            // foer reglerne kendte dem — saa laenge ingen skrev, var det
            // harmloest.
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },

            // ⚠ FUNKTIONER ER ET MAP, IKKE ET ARRAY. funktioner/{chauffoer:true}
            // kan indekseres og forespoerges ("hvem er mekanikere"); et array
            // kan ikke. Noeglen skal vaere en kendt funktion — ellers staar en
            // tastefejl som en funktion ingen skaerm kender.
            "funktioner": {
              "$funktion": {
                ".validate": "newData.isBoolean() && $funktion.matches(/^(chauffoer|buschauffoer|mekaniker|lager|terminal|disponent|administration)$/)"
              }
            },

            // ⚠ IKKE EN ENUM — samme begrundelse som hjemsted paa et koeretoej.
            // Stederne er DENNE tenants, og et nyt depot maa ikke kraeve en
            // udrulning.
            "stationeret": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },

            "telefon": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "ansatMs": { ".validate": "newData.isNumber()" },
            // ⚠ EN FRATRAADT MEDARBEJDER HARDSLETTES ALDRIG. Der haenger
            // reservationer, indberetninger og bookinger paa personId'et —
            // .write kraever i forvejen newData.exists(). Datoen er sporet.
            "fratraadtMs": { ".validate": "newData.isNumber()" },

            // CPR og privatadresse hoerer i sensitive/personale, ikke her.
            "cpr": { ".validate": false },
            "privatAdresse": { ".validate": false }
          }
        },

        // KOMPETENCER — egen node, ikke en undernode af personale.
        //
        // Samme begrundelse som etaper i beslutning 16: "hvilke kompetencer
        // udloeber inden for 30 dage?" kan ikke stilles under
        // personale/<id>/kompetencer/, fordi RTDB kun forespoerger paa
        // boernene af een node. Man ville skulle hente hele personalet ned og
        // lede. Det er tredje gang samme argument afgoer en placering — se
        // moenstret i ARKITEKTUR.
        //
        // Ingen division: den arves fra personen, som reservationer og fravaer.
        // Ingen laes-permission: der er ingen klassificeret satellit at
        // kontrastere imod — se noten ved bookingLaes i permissions.js.
        "kompetencer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true)",
          ".indexOn": ["udloeberMs", "personId", "type"],
          "$kompetenceId": {
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|kompetencer.skriv|') && newData.exists() && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true)",
            ".validate": "newData.hasChildren(['personId', 'type', 'udloeberMs'])",
            "udloeberMs": { ".validate": "newData.isNumber()" },
            "division": { ".validate": false }
          }
        },

        // Aggregerede nøgletal. Skrives kun af Cloud Functions — ellers kan
        // Dashboard og modulerne komme til at vise forskellige tal igen.
        // ⚠ kpi/ ER DELT PAA DOMAENE. Der er INGEN .read her paa noden.
        //
        // Foer stod der een .read paa hele kpi/, og den kraevede kun
        // tenant-medlemskab: ingen permission, ingen modulklausul. En kunde
        // UDEN Oekonomi-modulet kunne laese
        // tenants/<id>/kpi/gods/current/oekonomi direkte — netop det tal han
        // ikke havde koebt adgang til at se en skaerm for. Sidebaren skjulte
        // modulet, og widgetvaelgeren skjulte kortet; ingen af delene
        // spaerrede tallet.
        //
        // Det stod skrevet ned i dashboardvisning.js som en KENDT
        // begraensning: "en afkrydsning SKJULER et dashboard; den spaerrer det
        // ikke. Vil man have den rigtige spaerring, er det kpi/ der skal deles
        // op — pr. domaene, med en permission eller en modulklausul paa hver."
        //
        // ⚠ .read KASKADERER, saa den SKAL vaek fra toppen. Blev den staaende,
        // ville en klausul paa domaenet vaere dekoration: en laesning af
        // kpi/<division>/current ville stadig give alt.
        //
        // ⚠ FOELGEN ER AT useKpi() HENTER PR. DOMAENE. Man kan ikke laese
        // foraelderen laengere — heller ikke som admin. Det er prisen, og den
        // er betalt eet sted.
        "kpi": {
          ".write": false,
          // ⚠ HER LAA ET "$division"-NIVEAU — kpi/<division>/<snapshot>/<domaene>.
          // Aksen er fjernet i beslutning 70: ingen abonnent har baade gods
          // og bus, saa jobbet skrev to grene med de samme tal for flaaden og
          // bemandingen og forskellige for resten.
          //
          // ⚠ NIVEAUET VAR ET WILDCARD, IKKE EN OPREMSNING. Reglen matchede
          // hvad som helst der stod dér, saa den her aendring ER en
          // regelaendring og ikke bare en anden sti: laeste klienten et niveau
          // hoejere UDEN at reglen fulgte med, ville "current" have matchet
          // $division, domaenet have matchet $snapshot, og .read paa $domaene
          // aldrig vaere naaet. Sti, regel og udrullede data flytter sammen.
          "$snapshot": {
            // Modulnavnet ER domaenenavnet for syv af ti, og derfor kan
            // reglen slaa det op uden et katalog. De tre undtagelser staar
            // eksplicit:
            //   opgaver, afvigelser  spaender FLERE moduler — samme
            //                        carve-out som noderne opgaver/satser/
            //                        fakturaer i beslutning 33
            //   disponering          hoerer til modulet 'booking'
            // Listen staar i KPI_DOMAENE i kpi-aggregering.js, og en proeve
            // holder de to op mod hinanden.
            // ⚠ OG ET LED TIL: DOMAENET ARVER SIN KILDES LAESE-PERMISSION.
            //
            // Modulklausulen ovenfor gaelder TENANTEN. Det her gaelder
            // BRUGEREN: et noegletal er ikke mildere end sit grundlag. Maa
            // man ikke laese `kunder/`, skal man heller ikke kunne laese
            // ANTALLET af kunder ad bagvejen — et aggregat er stadig kundens
            // data, det er bare talt op.
            //
            // ⚠ KUN `kunder` I DAG, og det er ikke en halv loesning. Af de
            // noder aggregeringen faktisk laeser, er `kunder` den ENESTE der
            // kraever en laese-permission; etaper, grundlag, opgaver,
            // indkoeb, fakturaer, leverandoerer, facility og indberetninger
            // kraever kun tenant-medlemskab. At skrive flere led ville vaere
            // at gate paa noget der ikke er grundlaget.
            //
            // Det aendrer INTET i dag — alle syv roller har kunder.laes.
            // Vaerdien er at leddet ER der: den dag en laese-permission
            // strammes, foelger noegletallet med af sig selv.
            //
            // KPI_KILDER og KPI_PERM i kpi-aggregering.js siger hvad hvert
            // domaene er regnet af, og test/rules.kpi.test.mjs udleder
            // kravet af REGLERNE for hver kilde og fejler hvis de to er
            // uenige. Faar `flaade` en dag `koeretoejer` som kilde, bliver
            // proeven roed indtil koeretoejer.laes staar begge steder.
            // ⚠ SEKS LED, OG DE FEM ER UDLEDT — BESLUTNING 104.
            // KPI_KILDER siger hvad hvert domaene er REGNET af; naar en
            // kilde faar en laese-permission, arver domaenet den. De fem nye
            // blev ikke skrevet i haanden: rules.kpi.test.mjs udledte dem af
            // kildernes egne regler og sagde praecis hvilke der manglede.
            //
            // ⚠ EN CHAUFFOER MISTER FEM AF TI DOMAENER, og det er meningen:
            // de fem er regnet af priser, fakturagrundlag og indkoeb.
            // useKpi() spoerger kun om dem laesbareDomaener() siger ja til,
            // saa han faar ingen permission-denied — kortene er der bare ikke.
            //
            // ⚠ SKIVE 4A — flaade OG indkoeb KRAEVER NU TO PERMISSIONS, IKKE
            // ÉN. Begge domaener regnes delvist af `fakturaer` (flaade.
            // ikkeLinkedeFakturaer, indkoeb.fakturaerTilGodkendelse), som fik
            // sin egen laese-permission i 4A — fakturaer.laes, forskellig fra
            // indkoeb.laes. Et noegletal er ikke mildere end sit grundlag
            // (se rules.kpi.test.mjs's hoved), saa begge skal kraeves. I
            // praksis aendrer det ingenting: de to permissions gives til
            // NOEJAGTIG de samme roller (se ROLLE_PERMS i permissions.js).
            //
            // ⚠ SKIVE 4B — facility KRAEVER NU leverandoerer.laes, IKKE
            // indkoeb.laes, OG indkoeb KRAEVER NU OGSAA leverandoerer.laes.
            // `leverandoerer` mistede sin indkoeb-klausul og fik sin egen
            // permission (Model B) — begge domaener der regner paa noden
            // (facility.leverandoerNavn, indkoeb.leverandoerNavn) foelger med.
            "$domaene": {
              ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || $domaene.matches(/^(opgaver|afvigelser)$/) || ($domaene === 'disponering' ? root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true : root.child('tenants').child($tenantId).child('moduler').child($domaene).val() === true)) && ($domaene !== 'kunder' || (auth.token.perms != null && auth.token.perms.contains('|kunder.laes|'))) && ($domaene !== 'oekonomi' || (auth.token.perms != null && auth.token.perms.contains('|grundlag.laes|'))) && ($domaene !== 'flaade' || (auth.token.perms != null && auth.token.perms.contains('|indkoeb.laes|') && auth.token.perms.contains('|fakturaer.laes|'))) && ($domaene !== 'facility' || (auth.token.perms != null && auth.token.perms.contains('|leverandoerer.laes|'))) && ($domaene !== 'indkoeb' || (auth.token.perms != null && auth.token.perms.contains('|indkoeb.laes|') && auth.token.perms.contains('|fakturaer.laes|') && auth.token.perms.contains('|leverandoerer.laes|')))"
            }
          }
        },

        // Konfliktfrihed kan ikke garanteres fra klienten: to disponenter kan
        // ramme samme sekund. Skrivning går gennem en Cloud Function der
        // tjekker overlap i en transaction.
        // Ingen division her — reservationen arver fra ressourcen.
        //
        // ⚠ OG INGEN MODULKLAUSUL — NODEN HOERER I BASEN (beslutning 92).
        //
        // Her stod `moduler.booking === true`, og det laaste en kunde ude af
        // sine EGNE data. Noden er hele pointen i beslutning 4: booking,
        // vaerksted, facility-sag og fravaer skriver til den SAMME node, saa
        // de fire kan se hinanden. Gates den paa den ene, forsvinder de tre
        // andre.
        //
        // Maalt paa DEV-kunden `nordvest` (Fleet, Facility, Bemanding,
        // Procure — ingen Planning): 37 reservationer, og ikke én af dem kom
        // fra en booking. 18 vaerksted, 9 facility-sag, 10 fravaer. Hans
        // Driftskalender og Servicekalender fik permission-denied paa data
        // hans egne moduler havde skrevet — og `opgaveplanlaeg` skrev dem
        // for ham med admin-SDK, som gaar uden om reglerne.
        //
        // Samme grund som `opgaver`, `satser` og `fakturaer` staar i basen.
        // NODE_MODUL i moduler.js er sandheden, og rules.moduler.test.mjs
        // udleder sig af den: kommer linjen tilbage i tabellen, kommer
        // klausulen tilbage her — og laasen med den.
        // ══════════════════════════════════════════════════════════════
        // CHAUFFOERENS MELDINGER — beslutning 103
        // ══════════════════════════════════════════════════════════════
        //
        // `rutestatus.js` har laest dem siden beslutning 22, og noden fandtes
        // hverken her eller i seedet: Rute & status stod med "Ingen meldinger"
        // paa hver eneste tur, for alle. Skaermen var ikke i stykker — der var
        // bare ingen der kunne skrive.
        //
        // ⚠ NOEGLET PAA ETAPEN. En melding hoerer til én tur, og en tur hentes
        // som én node. Laa de fladt med et `etapeId`, skulle hver visning
        // filtrere hele historikken for at finde tre meldinger.
        //
        // ⚠ .write: false — VEJEN ER LUKKET, IKKE RETTEN. `statusmelding` er
        // den ene vej ind, og den skal slaa op i BRUGERPOSTEN for at finde
        // chauffoerens `personId` og afvise en melding paa en andens tur. En
        // regel kan ikke goere det arbejde: den kan sammenligne to felter, men
        // ikke afgoere om `uid` er `personId` uden opslaget — og et opslag
        // klienten selv sendte med, kunne vaere hvad som helst.
        //
        // ⚠ MODULET ER `booking`, som paa `etaper`. En melding uden sin etape
        // er en raekke uden betydning.
        //
        // ⚠ TIDSPUNKTET KOMMER FRA TELEFONEN. Se noten i rutestatus.js: en
        // melding sendt kl. 14 uden daekning maa ikke staa kl. 16 fordi det var
        // da signalet kom igen. `klientId` goer en gensendelse ufarlig.
        // ══════════════════════════════════════════════════════════════
        // STEMPLINGER — beslutning 107
        // ══════════════════════════════════════════════════════════════
        //
        // ⚠ NAVNET ER TREDJE FORSOEG, og de to foerste var taget:
        // `vagter/` er RESERVERET til en VAGTPLAN (hvad vi aftalte), og
        // `tidsregistrering` er et FELT paa en indberetning (ankomst og
        // afgang paa et vaerkstedsbesoeg). Tredje gang to ting er ved at
        // hedde det samme i dette repo — se `lagre` mod `lager`.
        //
        // ⚠ NOEGLET PAA personId, OG DET ER DET DER GOER REGLEN MULIG.
        // Paa `statushaendelser` (beslutning 103) laa ejerskabet INDE i
        // posten, og en regel kunne ikke afgoere om etapen var chauffoerens
        // — derfor en Cloud Function. Her staar personId i STIEN, saa
        // reglen kan slaa `brugere/<uid>/personId` op og sammenligne. Vejen
        // behoever derfor ikke vaere lukket.
        //
        // ⚠ HAN LAESER KUN SINE EGNE. Laa `.read` paa `stemplinger` selv,
        // ville den kaskadere, og enhver chauffoer kunne se hvornaar hver
        // kollega moedte. Kontoret laeser med `personale.laes` — det er
        // arbejdstid, ikke en helbredsoplysning, saa den bredere
        // personale-permission raekker.
        //
        // ⚠ EN LUKKET VAGT ER FROSSET. `.write` afvises naar posten allerede
        // har et `udMs` — ellers kunne en chauffoer rette gaarsdagens timer
        // efter at kontoret havde set dem. Leddet staar paa POSTEN og ikke
        // paa feltet: `.write` kaskaderer, og en `.validate` koeres slet
        // ikke ved en sletning. Samme figur som underskriften i
        // beslutning 52.
        //
        // ⚠ OG DER ER INGEN POSITION. Specifikationen siger at positionen
        // registreres; beslutning 22 siger INGEN GPS. Spoergsmaalet er
        // stillet og ikke besvaret, saa der skrives ingen koordinater — og
        // felterne staar heller ikke her, for et felt reglen tillader og
        // ingen skriver, kan fyldes med hvad som helst.
        "stemplinger": {
          "$personId": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true) && (root.child('tenants').child($tenantId).child('brugere').child(auth.uid).child('personId').val() === $personId || (auth.token.perms != null && auth.token.perms.contains('|personale.laes|')))",
            ".indexOn": ["indMs"],
            "$id": {
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true) && root.child('tenants').child($tenantId).child('brugere').child(auth.uid).child('personId').val() === $personId && !data.child('udMs').exists() && newData.exists()",
              ".validate": "newData.hasChildren(['indMs'])",
              "indMs": { ".validate": "newData.isNumber()" },
              // ⚠ SLUT EFTER START, og hoejst et doegn. En glemt udstempling
              // ville ellers give en vagt paa hundrede timer, som staar i en
              // opgoerelse som om nogen arbejdede. Det er en AFVISNING og
              // ikke en afkortning: vi ved ikke hvornaar han gik.
              "udMs": { ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('indMs').val() && newData.val() - newData.parent().child('indMs').val() <= 86400000" },
              "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "$andet": { ".validate": false }
            }
          }
        },
        "statushaendelser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
          ".write": false,
          "$etapeId": {
            ".indexOn": ["ms"],
            "$meldingId": {
              ".validate": "newData.hasChildren(['type', 'ms', 'uid', 'klientId'])",
              // Ordlisten bor i HAENDELSE i rutestatus.js. Reglen validerer
              // FORMEN; hvad hver type betyder, afgoeres ét sted i koden.
              "type": { ".validate": "newData.isString() && newData.val().matches(/^(afgang|ankomstLaesning|afgangLaesning|graense|pause|ankomstLosning|afsluttet|forsinkelse)$/)" },
              "ms": { ".validate": "newData.isNumber()" },
              // ⚠ uid, IKKE personId. En melding er hvem der GJORDE noget.
              // Serveren saetter den fra tokenet; en klient der maatte skrive
              // sit eget, kunne melde i en kollegas navn.
              "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
              "klientId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
              "stopId": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "forsinketMin": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
              // ⚠ FRITEKST, OG DEN BLIVER I NODEN. Noten er chauffoerens egne
              // ord om hvad der skete; den hoerer PAA meldingen og aldrig i
              // auditloggen, hvor allowlisten findes for at holde tastet tekst
              // ude (se LOGBARE_FELTER).
              "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "$andet": { ".validate": false }
            }
          }
        },

        "reservationer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false,
          "$ressourceType": {
            "$ressourceId": {
              ".indexOn": ["fra"]
            }
          }
        },

        // Tilstandsskift valideres server-side mod booking-state.js. En
        // disponent må ikke godkende sit eget forslag, og reservationen skal
        // oprettes atomisk sammen med skiftet.
        // historik under $bookingId er append-only og slettes aldrig.
        "bookinger": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|booking.laes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
          ".write": false,
          ".indexOn": ["tilstand", "oprettetMs", "kundeId"],
          "$bookingId": {
            // ⚠ NODEN VALIDEREDE SEKS FELTER — OG POSTERNE BAERER ATTEN.
            // tilstand, harAabneEtaper, kundeId, division, kundeRef og historik
            // stod her. Alt andet var frit: et nummer som tal, en omsaetning som
            // float, en transporttype vi ikke kender. Samme hul som opgaver
            // havde foer beslutning 45.
            //
            // ⚠ OG BLOKKEN KAN IKKE NAAS AF EN KLIENT. Noden er .write: false, og
            // admin-SDK'et gaar uden om reglerne — den her blok er altsaa
            // BESKRIVELSEN af den form serveren skal overholde, ikke en
            // haandhaevelse. Haandhaevelsen ligger i valideBooking() og
            // bookingOpdatering(), som begge sider kalder. Skriv ikke en
            // regelproeve der "afviser" en booking: den ville vaere groen fordi
            // skrivningen er lukket, ikke fordi posten var forkert. Se
            // beslutning 45 og 55.
            //
            // ⚠ INGEN $andet: false. Otte demo-bookinger baerer felter der ikke er
            // skrevet ned endnu (fraAdresse-lignende fritekst, krav-lister), og et
            // afvisende $andet ville sige at posterne var ugyldige uden at nogen
            // kunne se hvilket felt. Formen strammes naar skaermene er faerdige.
            ".validate": "newData.hasChildren(['kundeId', 'tilstand'])",

            // ⚠ NUMMERET KOMMER FRA COUNTEREN (beslutning 8) og har EET format.
            // En afskrift af formatet her er billig og fanger den dag nogen
            // skriver et loebenummer uden aarstal.
            "nummer": { ".validate": "newData.isString() && newData.val().matches(/^BKG-[0-9]{4}-[0-9]{5}$/)" },

            "fraSted": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "tilSted": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },

            // Ordlisterne staar i booking-state.js. Laengdetjek her, som paa
            // opgaver.status: en afskrift ville vaere et andet sted de stod.
            "transporttype": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "rutepraeference": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "afhentningFleks": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "leveringFleks": { ".validate": "newData.isString() && newData.val().length <= 20" },

            "onsketAfhentningMs": { ".validate": "newData.isNumber()" },
            // ⚠ LEVERING EFTER AFHENTNING. Et forloeb med omvendt raekkefoelge kan
            // ikke planlaegges, og fejlen ville foerst vise sig som en etape hvor
            // til < fra — langt fra det felt der blev tastet forkert.
            "onsketLeveringMs": { ".validate": "newData.isNumber() && (!newData.parent().child('onsketAfhentningMs').exists() || newData.val() > newData.parent().child('onsketAfhentningMs').val())" },

            // ⚠ HELE OERE, EKSKL. MOMS — beslutning 2. En float bliver 1849,999 i
            // en sum, og det her tal ender paa et fakturagrundlag.
            "omsaetningOere": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },

            // ⚠ uid, IKKE ET NAVN. Det er hvem der GJORDE det. Demosaettet skrev
            // "Mette Kjaer" paa alle otte poster, mens indberetningerne skrev et
            // uid — to slags vaerdi i det samme felt.
            "oprettetAf": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
            "oprettetMs": { ".validate": "newData.isNumber()" },

            "kundekrav": { ".validate": "newData.isString() && newData.val().length <= 500" },
            // ⚠ TILSTANDEN ER AFLEDT AF ETAPERNE. forloebstilstand() regner
            // den ud, og den skrives af PRAECIS EEN ting: etapeskift, i samme
            // opdatering som etapeskiftet selv. Der findes ikke et
            // bookingskift — skal et forloeb skifte, skifter man dets etaper.
            //
            // Moenstret er en AFSKRIFT af TILSTAND i booking-state.js. Kommer
            // der en tilstand mere i domaenet uden at reglen faar den, afviser
            // en fremtidig skrivning noget skaermen viser som gyldigt.
            "tilstand": { ".validate": "newData.isString() && newData.val().matches(/^(kladde|afventerPlan|aaben|afventerKoord|reserveret|returneret|delvist|afvist|annulleret|udfoert)$/)" },
            // ⚠ ET FORLOEB ER FOERST UDFOERT NAAR HVER ENESTE ETAPE ER DET.
            // Feltet afgoer om et fakturagrundlag kan godkendes — se
            // kanGodkende() — og det er derfor det staar paa
            // LOGBARE_FELTER i audit-regler.js.
            "harAabneEtaper": { ".validate": "newData.isBoolean()" },
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            "division": { ".validate": false },
            // ⚠ KUNDENS EGET NUMMER, IKKE VORES — WAREHOUSE.md etape 16.
            // Det staar paa transportlabelen, fordi modtageren soeger paa DET
            // og ikke paa vores bookingnummer. Fri tekst med vilje: en kundes
            // rekvisitionsnummer foelger hans system, ikke vores.
            "kundeRef": { ".validate": "newData.isString() && newData.val().length <= 60" },
            // Append-only, som paa etapen: et tilstandsskift der kunne
            // slettes bagefter, kunne ikke forklares et halvt aar senere.
            "historik": {
              "$ms": { ".validate": "!data.exists()" }
            }
          }
        },

        // BESLUTNING 16 — etaper ligger som EGEN node, ikke under bookingen.
        // RTDB forespoerger kun paa boernene af een node, og matchningen skal
        // kunne finde "alle aabne etaper paa tvaers af bookinger" med
        // orderByChild("tilstand").equalTo("aaben"). Laa de under hver sin
        // booking, skulle samtlige bookinger hentes ned og gennemsoeges.
        // Flyt dem ikke ind under bookinger — se README.
        //
        // .write: false af samme grund som bookinger: tilstandsskiftet skal
        // ske atomisk sammen med reservationen, ellers kan etapens
        // koeretoejId og dens reservation naa at vaere uenige.
        "etaper": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
          ".write": false,
          ".indexOn": ["tilstand", "bookingId", "senestMs"],
          "$etapeId": {
            // ⚠ SAMME SOM PAA kunder: her stod hasChildren(['division']), og det var
            // nodens eneste krav. En etape UDEN bookingId er ikke en etape — den hoerer
            // til et forloeb, og uden referencen kan bookingens tilstand ikke afledes
            // (beslutning 40). Se beslutning 70.
            ".validate": "newData.hasChildren(['bookingId'])",
                        "division": { ".validate": false },
            // ⚠ EN ETAPE BAERER EN LISTE AF KOERETOEJER, IKKE EET.
            // En saettevognstur er traekker PLUS trailer, og de fem
            // disponeringstjek er skrevet til det: kanDisponeres() afviser en
            // trailer uden traekkende enhed, og kanBaere() laegger kapaciteten
            // sammen. Bar etapen eet id, kunne den regel aldrig udloeses.
            //
            // Formen er { <id>: true } og ikke et array: RTDB har ingen
            // arrays, og et array ville faa noeglerne 0, 1, 2 — hvorefter en
            // sletning midt i ville rykke resten.
            "koeretoejIder": {
              "$koeretoejId": {
                ".validate": "newData.isBoolean() && root.child('tenants').child($tenantId).child('koeretoejer').child($koeretoejId).exists()"
              }
            },
            // ⚠ personId, IKKE uid. Det er hvem etapen HANDLER OM — en
            // chauffoer har maaske slet intet login. Se CLAUDE.md.
            "personId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('personale').child(newData.val()).exists()" },
            "bookingId": { ".validate": "newData.isString() && newData.val().length <= 60" },
            // ⚠ ADRESSEN UDEN BYEN — WAREHOUSE.md etape 16. Transportlabelen
            // skal baere en adresse man kan koere efter, og `fraSted`/`tilSted`
            // er kun BYEN. Byen staar derfor IKKE her igen: samme kendsgerning
            // to steder driver, og planlaegningen laeser fraSted. Maerkatet
            // saetter dem sammen: navn, gade, "postnr fraSted".
            // ══════════════════════════════════════════════════════════
            // ⚠ fraAdresse OG tilAdresse ER FORBUDT — BESLUTNING 110
            // ══════════════════════════════════════════════════════════
            //
            // De var STRUKTUREREDE — {navn, gade, postnr} — med en
            // .validate paa hvert led, og de blev SKREVET AF INGENTING.
            // Maalt i den udrullede base: 2 af 8 etaper havde dem (fra
            // seedet), een fil laeste dem, ingen skrev dem.
            //
            // Samtidig bar `fraSted`/`tilSted` hele driften — 8 af 8,
            // laest af TI filer — og de staar slet ikke i den her
            // feltliste. To felter for eet spoergsmaal, og det designede
            // af dem var det ubrugte.
            //
            // Adressen hoerer nu paa STOPPET nedenfor, hvor den ogsaa kan
            // baere et tidsvindue, en kontakt og det gods der skal af og
            // paa. `fraSted` bliver: det er et NAVN til prissaetning og
            // ruteopslag, ikke en adresse man koerer til.
            //
            // ⚠ FORBUDT, IKKE FJERNET — som `division` i beslutning 70. En
            // manglende regel ville TILLADE feltet, og saa kunne den tredje
            // form vende tilbage som data uden at nogen havde besluttet det.
            "fraAdresse": { ".validate": false },
            "tilAdresse": { ".validate": false },

            // ══════════════════════════════════════════════════════════
            // STOPPENE — beslutning 110
            // ══════════════════════════════════════════════════════════
            //
            // ⚠ NOEGLET PAA ET NUMMER, ikke en array. RTDB har ingen
            // arrays, og `forslag` kostede tre lukkede overgange i
            // produktion netop fordi demo brugte arrays mens noden var
            // noeglet (beslutning 76). Raekkefoelgen kommer af noeglen.
            //
            // ⚠ VEJEN IND ER LUKKET, som resten af etapen: `etaper` er
            // `.write: false`, og `bookingopret` skriver de to stop en
            // A→B-tur altid har. Reglen her beskriver formen serveren skal
            // overholde — den kan ikke naas af en klient.
            //
            // ⚠ OG ORDRELINJERNE HOERER PAA STOPPET, ikke paa etapen. Et
            // multi-drop har gods til flere kunder paa samme tur, og en
            // liste paa etapen kunne ikke sige hvad der skal af HVOR.
            "stop": {
              "$nr": {
                ".validate": "newData.hasChildren(['art', 'navn'])",
                "art": { ".validate": "newData.isString() && newData.val().matches(/^(afhentning|levering)$/)" },
                "navn": { ".validate": "newData.isString() && newData.val().length <= 120" },
                "gade": { ".validate": "newData.isString() && newData.val().length <= 120" },
                "postnr": { ".validate": "newData.isString() && newData.val().length <= 12" },
                "by": { ".validate": "newData.isString() && newData.val().length <= 80" },
                // ⚠ KONTAKTEN HOERER PAA STOPPET, ikke paa kunden. Det er
                // rampens telefon — den man ringer til naar porten er
                // laast — og den er sjaeldent kundens hovednummer.
                "telefon": { ".validate": "newData.isString() && newData.val().length <= 40" },
                // ⚠ ET TIDSVINDUE ER TO TAL ELLER INGEN. Reglen kan kun se
                // eet felt ad gangen, saa `valideStop()` haandhaever parret;
                // her sikres kun at hvert af dem er et tidspunkt, og at til
                // ikke ligger foer fra.
                "fraMs": { ".validate": "newData.isNumber()" },
                "tilMs": { ".validate": "newData.isNumber() && (!newData.parent().child('fraMs').exists() || newData.val() >= newData.parent().child('fraMs').val())" },
                "ordrer": {
                  "$ordreId": {
                    "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
                    "nummer": { ".validate": "newData.isString() && newData.val().length <= 40" },
                    // ⚠ HELE TAL. Et halvt kolli findes ikke, og et kg med
                    // decimaler ville laegge sig sammen til en vaegt der ser
                    // praecis ud.
                    "kolli": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                    "kg": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                    "gods": { ".validate": "newData.isString() && newData.val().length <= 200" },
                    "$andet": { ".validate": false }
                  }
                },
                "$andet": { ".validate": false }
              }
            },
            // ⚠ FORSLAGET LIGGER PAA ETAPEN — BESLUTNING 40. Det laa BAADE her
            // og paa bookingen: dér tid, pris og transittid, her enheder og
            // chauffoer. For et forloeb med een etape var det det samme loefte
            // skrevet to steder. Det man disponerer, er en etape (beslutning
            // 16), saa forslaget hoerer her — med alle sine felter.
            "forslag": {
              "$forslagId": {
                ".validate": "newData.hasChildren(['personId'])",
                "nr": { ".validate": "newData.isNumber()" },
                "koeretoejIder": {
                  "$koeretoejId": {
                    ".validate": "newData.isBoolean() && root.child('tenants').child($tenantId).child('koeretoejer').child($koeretoejId).exists()"
                  }
                },
                "personId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('personale').child(newData.val()).exists()" },
                "afhentningMs": { ".validate": "newData.isNumber()" },
                "leveringMs": { ".validate": "newData.isNumber() && newData.val() > newData.parent().child('afhentningMs').val()" },
                "transitTimer": { ".validate": "newData.isNumber()" },
                // ⚠ HELE OERER. Beslutning 2 — et estimat er et beloeb, og et
                // beloeb i dette hus er en integer i oere, ekskl. moms.
                "estimatOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
                "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
                // ⚠ ET TRUKKET FORSLAG SLETTES IKKE — DET FAAR ET TIDSPUNKT.
                //
                // Loftet er tre, og uden en vej tilbage var en etape med tre forslag
                // laast for altid: koordinatoren kan RETURNERE den og bede om nye,
                // og disponenten kunne ikke lave dem. Det var en blindgyde bygget
                // ind i beslutning 58.
                //
                // ⚠ OG DET ER EN STATUS, IKKE EN SLETNING — beslutning 53. Et forslag
                // koordinatoren HAR set, og som saa forsvandt, kan ikke forklares et
                // halvt aar senere. Samme regel som paa etapens historik.
                //
                // ⚠ REGLEN KAN IKKE HINDRE AT valgtForslagId PEGER PAA ET TRUKKET
                // FORSLAG — en .validate ser eet felt ad gangen. `etapeskift` afviser
                // det, og det staar i en proeve. Se beslutning 59.
                "trukketMs": { ".validate": "newData.isNumber()" },
                // uid: hvem der GJORDE det. Ikke personId — det er ikke hvem forslaget
                // handler om.
                "trukketAf": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
                "$andet": { ".validate": false }
              }
            },
            // ⚠ ET VALG SKAL PEGE PAA ET FORSLAG DER FINDES. Ellers kunne
            // etapeskift godkende noget der ikke er der.
            "valgtForslagId": { ".validate": "newData.isString() && newData.parent().child('forslag').child(newData.val()).exists()" },
            "tilstand": { ".validate": "newData.isString() && newData.val().matches(/^(kladde|afventerPlan|aaben|afventerKoord|reserveret|returneret|delvist|afvist|annulleret|udfoert)$/)" },
            "fra": { ".validate": "newData.isNumber()" },
            "til": { ".validate": "newData.isNumber() && newData.val() > newData.parent().child('fra').val()" },
            // ⚠ APPEND-ONLY. Et tilstandsskift der kunne slettes bagefter,
            // kunne ikke forklares et halvt aar senere — og historikken er det
            // eneste sted en afvist booking staar med sin begrundelse.
            "historik": {
              "$ms": { ".validate": "!data.exists()" }
            }
          }
        },

        // Lagerstamdata: kapacitet og satser. Kapaciteten laeses af
        // tjekLedig() naar den summerer belastningen over et tidsrum.
        "lagre": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true)",
          "$lagerId": {
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|lagre.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true) && newData.exists()",
            // ⚠ NODEN VALIDEREDE KUN division, og de to satslister havde et
            // indeks men ingen form. Et beloeb kunne komme ind som FLOAT eller
            // som en streng, og beslutning 2 stod dermed kun i en kommentar.
            // Det er samme hul som "indkoeb" havde — og her var det vaerre,
            // fordi INTET skrev til noden: den var tom, og en tom node kan
            // ikke afsloere sin egen manglende validering.
            ".validate": "newData.hasChildren(['navn'])",

            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "division": { ".validate": false },

            // Kapaciteten er PLADSER, ikke oere. Den er ikke en sats og hoerer
            // derfor paa lageret selv.
            "kapacitet": { ".validate": "newData.isNumber() && newData.val() > 0" },

            // ⚠ TO SATSARTER, OG DE MAALER IKKE DET SAMME.
            // haandteringSatser er ind/ud — ét greb, uanset hvor laenge godset
            // staar. satser er doegnene. Slog man dem sammen, ville et ophold
            // paa én dag koste det samme som et paa tredive, eller omvendt.
            //
            // Formen er den SAMME som satser/$gruppe/satser, og forbeholdet
            // derovre gaelder ordret: reglen kan ikke forbyde en overskrivning
            // uden ogsaa at forbyde en rettelse af en tastefejl samme dag. Den
            // haandhaever FORMEN; beslutning 7 haandhaeves af skaermen.
            "satser": {
              ".indexOn": ["gyldigFra"],
              "$satsId": {
                ".validate": "newData.hasChildren(['gyldigFra', 'beloebOere', 'metode'])",
                "gyldigFra": { ".validate": "newData.isNumber()" },
                // Hele oere, som alt andet. En float bliver 1849,999 i en sum.
                "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000000000" },
                // ⚠ INGEN ENUM HER, OG DET FOELGER PRAECEDENSEN i
                // satser/$gruppe/satser. Ordlisten er METODER i pricing.js, og
                // en afskrift i regelfilen ville vaere et andet sted den stod —
                // med sin egen udrulningscyklus. Foerste udkast af den her regel
                // skrev prPalleDoegn og prKvadratmeterDoegn; de rigtige hedder
                // prPalledoegn og prKvadratmeterdoegn. En proeve i
                // test/pricing-forloeb.test.mjs holder demo-satserne op mod
                // ALLE_METODER, saa formen prøves dér hvor listen bor.
                "metode": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
                // ⚠ FRIDAGENE LIGGER PAA SATSEN, ikke i beregningen. Aendrer
                // lageret sin friperiode, er det en NY sats med gyldigFra — en
                // konstant i koden ville aendre prisen paa ophold der allerede
                // er afregnet.
                "friDage": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },
                "valuta": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}$/)" },
                "aktiv": { ".validate": "newData.isBoolean()" },
                "oprettetAf": { ".validate": "newData.isString()" },
                "oprettetMs": { ".validate": "newData.isNumber()" },
                "$andet": { ".validate": false }
              }
            },

            "haandteringSatser": {
              ".indexOn": ["gyldigFra"],
              "$satsId": {
                ".validate": "newData.hasChildren(['gyldigFra', 'beloebOere', 'metode'])",
                "gyldigFra": { ".validate": "newData.isNumber()" },
                "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000000000" },
                "metode": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
                "valuta": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}$/)" },
                "aktiv": { ".validate": "newData.isBoolean()" },
                "oprettetAf": { ".validate": "newData.isString()" },
                "oprettetMs": { ".validate": "newData.isNumber()" },
                "$andet": { ".validate": false }
              }
            },

            "$andet": { ".validate": false }
          }
        },

        // Booking-, fragtbrev- og fakturanumre. Kun via transaction i en
        // Cloud Function.
        "countere": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false
        },

        // MAILRATELIMIT — SKIVE 3D, GATE A PUNKT 6. Rene tællere, ét
        // minutvindue pr. bruger, skrevet af sagMailSend via transaction().
        // Ligesom countere er den kun her for at høre til under
        // tenant-isolationens selv-opdaterende sweep (test/rules.tenant.test.mjs
        // udleder sin liste af NETOP denne fil) — ingen klient skriver den
        // nogensinde, Admin SDK'et går uden om reglerne som overalt ellers.
        "mailRatelimit": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|audit.laes|')",
          ".write": false
        },

        // FAKTURAGRUNDLAGET — beslutning 25.
        //
        // ⚠ .write: false FOR ALLE, OGSAA ADMIN. Et grundlag faar sit nummer
        // fra en counter i en transaction (beslutning 8), skifter tilstand
        // efter kanGodkende()'s regler, og et LAAST grundlag maa aldrig kunne
        // aendres. Ingen af de tre kan haandhaeves af en klient, og et
        // regnskabsdokument der kan rettes i haanden, beviser ingenting.
        // Skrivning sker gennem en Cloud Function — den findes endnu ikke, og
        // nummerserier staar som et kendt hul i README.
        //
        // ⚠ INGEN MODULKLAUSUL, som fakturaer og satser. Grundlaget roeres af
        // BOOKING (turen), WAREHOUSE (lagerafregningen) og OEKONOMI
        // (skaermen). En klausul paa eet af dem ville spaerre de to andre.
        //
        // ⚠ HARDSLETTES ALDRIG. Regnskabsdata tages ud af drift med en
        // tilstand og en erstatning — erstat() i grundlag.js — ikke ved at
        // forsvinde. Der er derfor heller ingen vej til en sletning her.
        // ⚠ .read KRÆVER grundlag.laes — BESLUTNING 104.
        // Grundlaget er hvad HVER ENKELT kunde bliver faktureret, linje for
        // linje. Det stod aabent for enhver i tenanten: en chauffoer kunne
        // laese hvad hver kunde betaler, og hvad marginen er.
        // Den er den SMALLESTE af de tre — hverken chauffoer, disponent
        // eller lagermedarbejder har den.
        "grundlag": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|grundlag.laes|')",
          ".write": false,
          ".indexOn": ["kundeId", "bookingId", "tilstand", "udarbejdetMs"],
          "$grundlagId": {
            // ⚠ ENTEN ET FORLOEB ELLER EN PERIODE — aldrig begge, aldrig
            // ingen af delene. En tur faktureres pr. forloeb; en
            // lagerafregning goer en PERIODE op for een kunde. Et grundlag
            // uden ophav kan ikke efterproeves, naar kunden ringer.
            ".validate": "newData.hasChildren(['kundeId', 'tilstand', 'udarbejdetMs']) && (newData.hasChild('bookingId') != newData.hasChild('periode'))",
            "periode": {
              ".validate": "newData.hasChildren(['fra', 'til']) && newData.child('til').val() > newData.child('fra').val()",
              "fra": { ".validate": "newData.isNumber()" },
              "til": { ".validate": "newData.isNumber()" },
              "$andet": { ".validate": false }
            },
            // GRL-AAAA-NNNNN. Eet format, een mekanisme (beslutning 8).
            "nummer": { ".validate": "newData.isString() && newData.val().matches(/^GRL-[0-9]{4}-[0-9]{5}$/)" },
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            "bookingId": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "division": { ".validate": false },
            "tilstand": { ".validate": "newData.isString() && newData.val().matches(/^(kladde|godkendt|laast)$/)" },
            // ⚠ uid, IKKE personId. Det er hvem der GJORDE noget.
            "udarbejdetAf": { ".validate": "newData.isString()" },
            "udarbejdetMs": { ".validate": "newData.isNumber()" },
            "godkendtAf": { ".validate": "newData.isString()" },
            "godkendtMs": { ".validate": "newData.isNumber()" },
            "laastMs": { ".validate": "newData.isNumber()" },
            "eksportReference": { ".validate": "newData.isString() && newData.val().length <= 120" },
            // ⚠ REFERENCEN GAAR BEGGE VEJE. erstat() kraever nytId op front,
            // fordi et erstattet grundlag stadig findes og ellers ville taelle
            // med — en rettelse maa ikke vaere en fordobling.
            "erstatterId": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "erstattetAfId": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "linjer": {
              "$linjeId": {
                ".validate": "newData.hasChildren(['art', 'antal', 'satsOere'])",
                "art": { ".validate": "newData.isString() && newData.val().matches(/^(koersel|ventetid|tillaeg|materiale|lager|manuel)$/)" },
                "tekst": { ".validate": "newData.isString() && newData.val().length <= 200" },
                // Maengder som TUSINDEDELE og beloeb i hele OERE — ANTAL_SKALA
                // i beloeb.js. To skalaer fakturerer 1000x forkert.
                "antal": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
                "satsOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
                "enhed": { ".validate": "newData.isString() && newData.val().length <= 20" },
                // ⚠ MOMSSATSEN GAETTES IKKE. Feltet maa MANGLE — det er det
                // rigtige svar indtil en bogholder har svaret — men staar den
                // der, skal den vaere et tal. Se validerLinje() i grundlag.js.
                "momssats": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
                "kilde": {
                  ".validate": "newData.hasChildren(['type', 'id'])",
                  "type": { ".validate": "newData.isString() && newData.val().matches(/^(etape|indberetning|bevaegelse)$/)" },
                  "id": { ".validate": "newData.isString() && newData.val().length <= 60" },
                  "$andet": { ".validate": false }
                },
                "$andet": { ".validate": false }
              }
            },
            "historik": {
              "$postId": {
                ".validate": "newData.hasChildren(['hvad', 'ms'])",
                "hvad": { ".validate": "newData.isString() && newData.val().matches(/^(oprettet|aendret|godkendt|laast|erstattet)$/)" },
                "af": { ".validate": "newData.isString()" },
                "ms": { ".validate": "newData.isNumber()" },
                "reference": { ".validate": "newData.isString() && newData.val().length <= 120" },
                "begrundelse": { ".validate": "newData.isString() && newData.val().length <= 300" },
                "$andet": { ".validate": false }
              }
            },
            "$andet": { ".validate": false }
          }
        },

        // OMKOSTNINGER — hvad turen KOSTER os. IKKE hvad kunden betaler.
        //
        // ⚠ TO NODER, FORDI TALLENE IKKE MAA BLANDES. `satser` er kundens
        // pris; her staar km-omkostningen paa bilen, faergen, broen,
        // agentparkeringen og vejafgiften. Beslutning 11 findes praecis for
        // den forskel: driftsomkostning pr. km er ikke kalkulationspris pr.
        // km. Storebaelt koster 887 kr og faktureres maaske til 950 — laa de
        // to i samme node, ville en sum blande indtaegt og udgift.
        //
        // ⚠ PERMISSIONEN ER SATSER.SKRIV, og det er en beslutning: det er den
        // samme person der saetter begge, og en permission mere skulle gives
        // til noejagtig de samme. Noderne er delt fordi tallene ikke maa
        // blandes, ikke fordi adgangen skulle deles.
        //
        // ⚠ SATSARKET STOD SOM EN const I Bookingopsaetning.jsx indtil
        // PRISER.md etape 5. Skaermen viste et satsark ingen kunne rette.
        // ⚠ .read KRÆVER satser.laes — BESLUTNING 104.
        // Samme permission som priserne, af samme grund som de deler
        // skrive-permission: det er den samme person der saetter begge.
        // Noderne er delt fordi TALLENE ikke maa blandes (beslutning 11),
        // ikke fordi adgangen skulle deles.
        "omkostninger": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true) && auth.token.perms != null && auth.token.perms.contains('|satser.laes|')",
          "$id": {
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|satser.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true) && newData.exists()",
            // ⚠ EN BILOMKOSTNING BAERER INTET NAVN OG INGEN DIVISION.
            // Navnet staar paa koeretoejet — skrives det ogsaa her, driver de
            // to fra hinanden, og det var netop advarslen i den gamle
            // JSX-fil. Og en bil har ingen division (beslutning 19): et
            // koeretoej er defineret ved sin ART, ikke ved en afdeling, og
            // reglerne afviser feltet paa koeretoejer/. En km-sats maa ikke
            // indfoere det ad bagvejen.
            ".validate": "newData.hasChildren(['art']) && (newData.child('art').val() === 'bil' || newData.hasChild('navn'))",
            "art": { ".validate": "newData.isString() && newData.val().matches(/^(bil|passage|agent)$/)" },
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "kategori": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "division": { ".validate": false },
            // Vejafgiften kommer med uden at nogen vaelger den. Antallet af
            // faerger kommer fra RUTEN; vejafgiften goer ikke.
            "altidPaaBooking": { ".validate": "newData.isBoolean()" },
            "aktiv": { ".validate": "newData.isBoolean()" },
            "satser": {
              ".indexOn": ["gyldigFra"],
              "$satsId": {
                // Samme form som en kundesats — og samme regel: en sats
                // overskrives ALDRIG, den faar en ny post med gyldigFra.
                ".validate": "newData.hasChildren(['gyldigFra', 'beloebOere'])",
                "gyldigFra": { ".validate": "newData.isNumber()" },
                "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "metode": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "valuta": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}$/)" },
                "friDage": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                // LAENGDEBAAND — trin 3 af beslutning 18.
                //
                // En faerge tager betaling efter kajmeter: Roedby-Puttgarden
                // koster 1.338 kr for 10 m og 2.530 kr for 18 m. Baandet
                // ligger PAA satsen og ikke i et niveau for sig, saa
                // kundepriser og omkostninger beholder samme form og hvert
                // baand kan versioneres med sin egen gyldigFra.
                //
                // ⚠ MILLIMETER SOM INTEGER, som paa koeretoejet. Grænsen
                // ligger ved 10 og 18 m, og 9,998 mod 10,002 afgoer prisen —
                // en float ved en graense er en fejl der venter.
                //
                // Intervallet er (fra, til]: oevre graense INKLUSIV, fordi
                // rederierne udgiver taksten som "indtil 10 m". Reglen kan
                // ikke haandhaeve det — den haandhaever FORMEN. Laesningen
                // staar i satsOpslag() i pricing.js, og en proeve holder den.
                "laengdeFraMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "laengdeTilMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0" },
                "aktiv": { ".validate": "newData.isBoolean()" },
                "oprettetAf": { ".validate": "newData.isString()" },
                "oprettetMs": { ".validate": "newData.isNumber()" },
                "$andet": { ".validate": false }
              }
            },
            "$andet": { ".validate": false }
          }
        },

        // Satser overskrives ALDRIG — nye poster med gyldigFra. Ellers ændrer
        // en rettelse i dag prisen på en booking fra sidste kvartal.
        // ⚠ .read KRÆVER satser.laes — BESLUTNING 104.
        // Kun admin maatte AENDRE en pris, og enhver i huset maatte LAESE
        // den. Det var ikke en beslutning; det var hvad der skete da
        // laesegating kun blev sat paa de fire noder der har en
        // sensitive/-satellit. Se noten ved bookingLaes i permissions.js.
        "satser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|satser.laes|')",
          "$gruppe": {
            "$postId": {
              // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
              // newData.exists(). Begge dele er noedvendige, og de stopper hver
              // sin ting: laa reglen paa noden, kunne ET kald tomme hele
              // registret — og uden leddet kunne en enkelt post hardslettes.
              // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
              // Se beslutning 53.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|satser.skriv|') && newData.exists()",
              // ⚠ VALIDERINGEN KOM MED PRISERNE. Noden har vaeret her siden
              // beslutning 7, men INTET skrev til den — satsarket stod som en
              // const i Bookingopsaetning.jsx. Nu skal den baere kundepriser,
              // og en node uden validering er en node hvor et beloeb kan vaere
              // en streng.
              "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
              "kategori": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "aktiv": { ".validate": "newData.isBoolean()" },
              "satser": {
                ".indexOn": ["gyldigFra"],
                "$satsId": {
                  ".validate": "newData.hasChildren(['gyldigFra', 'beloebOere'])",
                  // ⚠ EN SATS OVERSKRIVES ALDRIG (beslutning 7). Rettes prisen
                  // i dag, kommer der en NY post med sin egen gyldigFra —
                  // ellers aendrer en rettelse prisen paa en booking fra sidste
                  // kvartal, og saa kan fakturaen ikke forklares.
                  //
                  // Reglen kan ikke forbyde en overskrivning uden ogsaa at
                  // forbyde en rettelse af en tastefejl samme dag. Den
                  // haandhaever formen; beslutningen haandhaeves af skaermen
                  // og af proeven paa den.
                  "gyldigFra": { ".validate": "newData.isNumber()" },
                  // Beloeb i hele OERE som alt andet. En float ville give en
                  // oere til eller fra paa hver eneste linje.
                  "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                  "metode": { ".validate": "newData.isString() && newData.val().length <= 40" },
                  "valuta": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}$/)" },
                  // Samme laengdebaand som paa omkostninger — se noten dér.
                  // ⚠ FELTET STAAR BEGGE STEDER FORDI FORMEN ER EEN. Videre-
                  // fakturerer vognmanden faergen til kunden, er det samme
                  // spoergsmaal: hvor mange kajmeter fylder vogntoget. Stod
                  // det kun paa omkostningssiden, skulle kundeprisen enten
                  // gaette eller finde paa sin egen model.
                  "laengdeFraMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                  "laengdeTilMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0" },
                  "aktiv": { ".validate": "newData.isBoolean()" },
                  "oprettetAf": { ".validate": "newData.isString()" },
                  "oprettetMs": { ".validate": "newData.isNumber()" },
                  "$andet": { ".validate": false }
                }
              },
              "$andet": { ".validate": false }
            }
          }
        },

        // BESLUTNING 21 — art styrer feltskemaet paa en opgave.
        //
        // ARTEN ER vaerksted | facility, IKKE vaerksted | langtur.
        // README sagde laenge det sidste, men den formulering er aeldre end
        // beslutning 16. Da etaper kom som egen node, blev langtur en DUBLET:
        // fraSted, tilSted, koeretoejId, personId, maengde og senestMs staar
        // allerede paa etapen, og matchAabneEtaper() soeger paa ETAPER. To
        // poster for een tildeling er praecis den fejl beslutning 16 lukkede
        // (DE-QR 777 mod DE-KL 404 i prototypen).
        //
        // Disponering laeser derfor BEGGE noder: dagsvisningen er opgaver med
        // art 'vaerksted', ugesvisningen er etaper.
        //
        // Feltskemaet pr. art staar i fleet/opgaver.js, ikke her. Reglerne
        // haandhaever kun det der vil oedelaegge en beregning eller en
        // forespoergsel — art og division. At kode hvert felts lovlige arter
        // ind i RTDB-regler ville goere filen ulaeselig uden at goere noget
        // sikrere. Samme afvejning som paa koeretoejer.
        //
        // .indexOn har faaet 'art'. Dagsvisningen henter dog paa 'dato' over
        // eet doegns vindue — naar langturene ligger i etaper, er der ingen
        // langture i opgaver at traekke med, og filtreringen paa art koster
        // derfor kun een dags raekker klientside.
        // ⚠ .write ER FALSE. VEJEN IND ER `opgaveplanlaeg`.
        //
        // Det er IKKE en manglende rettighed: casehandler, disponent,
        // koordinator og admin HAR alle `opgaver.skriv`, og funktionen
        // kraever den. Det er VEJEN der er lukket — samme snit som
        // kasseudlaan (beslutning 37) og enheder (39).
        //
        // En opgave og dens RESERVATION baerer den samme kendsgerning: at
        // enheden er optaget. De skal skrives sammen eller slet ikke.
        // `reservationer` er .write: false for alle, saa en klient kunne kun
        // skrive den ENE halvdel — og en opgave uden reservation ser FRI ud i
        // disponeringen. Det er beslutning 4's fejl, en bil der kan bookes til
        // Hamburg mens den staar paa liften.
        //
        // Dertil goer funktionen fire ting en regel ikke kan:
        //   · saetter `art` selv, saa den ene formular ikke kan oprette den
        //     andens poster
        //   · afviser en SOLGT eller SKROTTET enhed
        //   · slaar leverandoeren op og afviser et vaerksted der ikke findes
        //   · proever perioden med tjekLedigMod() — og OVERSKRIVER ikke, heller
        //     ikke naar prioritet 40 kunne. To disponenter kan ramme samme
        //     sekund, og et klientsidetjek kan ikke forhindre det.
        //
        // Doeren stod aaben mens `opgaveplan.js` skrev i sit eget hoved at
        // "der skrives intet herfra direkte". En kontrol der kun findes i
        // frontend, er ikke adgangskontrol — den er en paen knap.
        //
        // .validate herunder er FORMEN serveren skal overholde. Den
        // haandhaeves ikke paa admin-SDK'et — det goer valideOpgaveplan() og
        // opgaveMangler() i functions/delt/, som er DE SAMME filer klienten
        // proever mod. Samme ordning som kasseudlaan.
        //
        // ⚠ TO VEJE ER LUKKET MED, og de skal genaabnes med hver sin funktion
        // frem for ved at loesne den her linje:
        //   · en FACILITY-opgave. opgaveplanlaeg saetter art: "vaerksted".
        //   · et STATUSSKIFT (indberettet → planlagt → igang → udfoert).
        // Ingen af de to blev skrevet af en klient i forvejen. Se beslutning 43.
        "opgaver": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false,
          // ⚠ startMs, IKKE dato. Indekset navngav et felt INGEN post har:
          // opgaverne baerer startMs. Det overlevede fordi ingen skaerm
          // forespurgte paa noden — den var demo-drevet. Et indeks paa et
          // felt der ikke findes, koster ingenting og beskytter ingenting,
          // og den dag nogen sorterer paa startMs, henter RTDB hele noden
          // ned og sorterer i klienten: en advarsel i konsollen og en regning
          // i stilhed.
          ".indexOn": ["startMs", "status", "art", "koeretoejId", "personId"],
          "$opgaveId": {
            // ⚠ NODEN VALIDEREDE KUN art OG division. Alt andet var frit — en
            // status vi ikke kender, et starttidspunkt som streng, en
            // omkostning som float. Og opgaven RESERVERER nu sin ressource,
            // saa et forkert tidspunkt spaerrer en bil i et vindue ingen har
            // ment noget med.
            ".validate": "newData.hasChildren(['art', 'status', 'startMs'])",

            "art": { ".validate": "newData.isString() && newData.val().matches(/^(vaerksted|facility)$/)" },
            "division": { ".validate": false },

            // Ordlisten staar i opgaver.js. Laengdetjek her, af samme grund som
            // paa lagre.metode: en afskrift ville vaere et andet sted den stod.
            "status": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },

            // ⚠ TRE TRIN, SKREVET UD — IKKE ET LAENGDETJEK.
            // Modsat "status" ovenfor staar ordlisten HER som en regex, og de
            // to er ikke inkonsekvente: en ukendt status er en tilstand
            // skaermen ikke kan tegne, men den er stadig en tilstand. En
            // ukendt PRIORITET er noget andet — den bliver sorteret, taalt og
            // taelt, og en post med prioritet "mellem" (labelet, ikke
            // vaerdien) ville lande usynligt mellem de tre trin og aldrig
            // dukke op i nogen af de tre tal paa Driftskalenderen.
            //
            // ⚠ FELTET ER IKKE I hasChildren, OG DET ER MED VILJE. En
            // indberetning kommer fra en chauffoer i marken; prioriteten
            // saettes af den vaerkfoerer der triagerer. Kraevede vi den ved
            // oprettelsen, ville chauffoeren gaette, og saa var alt "Mellem".
            // "Ikke vurderet" er et svar — se prioritet.js.
            //
            // Vaerdierne er de samme som paa plukordrer: lav|normal|hoej.
            // Labelet paa den midterste er "Mellem"; vaerdien er "normal" og
            // skifter ikke, fordi den staar paa hver oprettet plukordre.
            "prioritet": { ".validate": "newData.isString() && newData.val().matches(/^(lav|normal|hoej)$/)" },

            // ⚠ startMs, IKKE dato. Indekset navngav "dato", som ingen post
            // har — og MODULETS feltkatalog sagde det samme forkerte.
            "startMs": { ".validate": "newData.isNumber()" },

            // ⚠ ESTIMAT OG MAALING ER TO FELTER. estimeretMin er hvad vi tror
            // og er det reservationen regnes af; faktiskMin er hvad der gik.
            // Slog man dem sammen, ville en reservation flytte sig naar
            // arbejdet var faerdigt.
            "estimeretMin": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "faktiskMin": { ".validate": "newData.isNumber() && newData.val() >= 0" },

            "beskrivelse": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "sted": { ".validate": "newData.isString() && newData.val().length <= 60" },

            // ⚠ personId, IKKE uid. Det er hvem opgaven HANDLER OM — den der
            // skal udfoere den. En mekaniker har maaske slet intet login.
            "personId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('personale').child(newData.val()).exists()" },

            "koeretoejId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('koeretoejer').child(newData.val()).exists()" },

            // ⚠ arbejdstype, IKKE "type". Noden har allerede "art"
            // (vaerksted|facility), og et felt ved siden af der hed "type",
            // ville vaere den forveksling der allerede har kostet os to gange:
            // indberetningers indeks navngav "type" mens posterne baerer
            // "art", og opgavers indeks navngav "dato", som ingen post har.
            // Et forkert feltnavn FEJLER ikke — RTDB henter hele noden ned og
            // filtrerer i klienten. Ordlisten staar i opgaver.js; her et
            // laengdetjek, som paa "status".
            //
            // Valgfrit: en facility-opgave har ingen arbejdstype.
            "arbejdstype": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },

            // ⚠ ET OPSLAG, IKKE EN FRITEKST. Vaerkstedets navn stod som
            // streng i tre demo-filer med hver sin stavemaade at drive med,
            // foer leverandoerer/ blev kilden. Et eksistenstjek her er samme
            // spaerring som paa koeretoejId: en opgave kan ikke pege paa et
            // vaerksted der ikke findes, og en fejlstavning bliver en
            // AFVISNING frem for en ny leverandoer ingen kan finde igen.
            "leverandoerId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('leverandoerer').child(newData.val()).exists()" },

            "aktivId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('aktiver').child(newData.val()).exists()" },
            "lokationId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('lokationer').child(newData.val()).exists()" },
            // ⚠ HVILKEN INDBERETNING UDLOESTE BESOEGET — beslutning 109.
            //
            // Der fandtes INGEN kobling: chauffoeren melder en revnet
            // forskaerm, kontoret planlaegger et vaerkstedsbesoeg, og intet
            // pegede fra det ene til det andet. Indberetningens forloeb gik
            // til "planlagt" og "paaVaerksted" — tilstande der forudsaetter
            // et besoeg — uden at nogen kunne sige HVILKET. Chauffoerappen
            // kunne derfor ikke svare paa hvornaar driften havde planlagt
            // hans melding, og det er dét kortet lover.
            //
            // ⚠ RETNINGEN ER VALGT. Opgaven peger paa indberetningen og
            // ikke omvendt: `indberetninger` er skrivbar fra klienten, saa
            // et `opgaveId` dér kunne saettes af chauffoeren selv. `opgaver`
            // er `.write: false`, og `opgaveplanlaeg` er vejen ind.
            "indberetningId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('indberetninger').child(newData.val()).exists()" },
            "besoegId": { ".validate": "newData.isString() && newData.val().length <= 60" },

            // ⚠ EN OMKOSTNING, IKKE EN INDTAEGT. Vaerkstedet servicerer egen
            // flaade; et beloeb her kan ikke faktureres videre. Hele oere.
            "beloebOere": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },

            // ⚠ TRE FELTER SERVEREN SKREV, SOM BLOKKEN IKKE KENDTE.
            // `opgaveplanlaeg` har hele tiden skrevet oprettetAf og oprettetMs,
            // og demo-saettet baerer sagId — men $andet: false herunder sagde
            // nej til alle tre. Det gjorde ingen skade, fordi noden er
            // .write: false og admin-SDK'et gaar uden om reglerne. Og netop
            // DERFOR er det vaerd at rette: blokken er det eneste sted formen
            // staar skrevet, og en form der ikke passer paa de poster der
            // faktisk ligger i noden, er en beskrivelse man ikke kan bruge til
            // noget. Se beslutning 45 og 49.
            //
            // ⚠ oprettetAf ER ET uid — hvem der GJORDE det. Ikke personId, som
            // er hvem opgaven handler om. De to maa ikke byttes om.
            "oprettetAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "oprettetMs": { ".validate": "newData.isNumber()" },
            // ⚠ sagId, IKKE sagsnummer. Nummeret er fritekst der kan drive fra
            // sagen; id'et er referencen. `sager/` staar ikke i filen her endnu
            // (beslutning 20 er fase 0), saa der er ingen eksistenskontrol at
            // haenge den op paa — den kommer naar noden goer.
            // ⚠ sagId, IKKE sagsnummer — OG NU MED ET MAAL. `sager/` findes,
            // saa en opgave kan ikke laengere pege paa en sag der ikke findes.
            // Beslutning 111 laerte lektionen: en feltliste der ikke passer
            // til dataene, giver aldrig en fejl paa en .write:false-node.
            "sagId": { ".validate": "newData.isString() && newData.val().length <= 60 && root.child('tenants').child($tenantId).child('sager').child(newData.val()).exists()" },

            "$andet": { ".validate": false }
          }
        },

        // SAGER — beslutning 20/112. Sagsbaseret mail, fase 1: modtagevej og
        // afsendelse (skive 2) mangler stadig, men datamodellen er nu haandhaevet.
        //
        // ⚠ INGEN MODULKLAUSUL, som opgaver, satser, fakturaer og
        // reservationer. `art` er fleet|facility — en node der hoerer til to
        // moduler, kan ikke gates af det ene uden at det andet gaar i
        // stykker. Se moduler.js.
        //
        // ⚠ .write: false FOR ALLE. Sagen faar sit nummer fra en counter i en
        // transaction (samme mekanisme som booking, beslutning 8), og
        // modtagevejen er UAUTENTIFICERET input fra internettet — ingen
        // klient maa nogensinde skrive denne node direkte. `sagOpret`,
        // `sagBeskedSkriv`, `sagKarantaeneFrigiv` og `sagAftaleBekraeft` er de
        // eneste veje ind.
        "sager": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|sag.laes|')",
          ".write": false,
          ".indexOn": ["art", "tilstand", "nummer", "objektId"],
          "$sagId": {
            ".validate": "newData.hasChildren(['nummer', 'art', 'tilstand', 'emne', 'modul', 'oprettetAf', 'oprettetMs'])",
            "nummer": { ".validate": "newData.isString() && newData.val().matches(/^(FLT|FAC)-[0-9]{4}-[0-9]{5}$/)" },
            "art": { ".validate": "newData.isString() && newData.val().matches(/^(fleet|facility)$/)" },
            "tilstand": { ".validate": "newData.isString() && newData.val().matches(/^(aaben|afventerSvar|afsluttet)$/)" },
            "emne": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "modul": { ".validate": "newData.isString() && newData.val().matches(/^(flaade|facility)$/)" },
            // ⚠ POLYMORF REFERENCE, IKKE ÉT MAAL. objektType afgoer hvilken
            // node objektId peger i — en vaerkstedssag mod en opgave, en
            // facility-sag mod et aktiv. Et fast eksistenstjek her kan ikke
            // skifte maal med typen. Se test/referencetjek.test.mjs.
            "objektType": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "objektId": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "modpartNavn": { ".validate": "newData.isString() && newData.val().length <= 120" },
            // ⚠ ADGANGSLISTEN, IKKE KONTAKTINFO — se sager.js. En raa
            // e-mailadresse kan ikke vaere en RTDB-noegle (@ og . er
            // forbudte tegn), saa parter er push-noeglet, ikke adresse-noeglet.
            "parter": {
              "$id": { ".validate": "newData.isString() && newData.val().length <= 254" }
            },
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" },
            "sidsteBeskedMs": { ".validate": "newData.isNumber()" },
            "antalBeskeder": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            // ⚠ SKIVE 3D — antalMails ER IKKE ET NYT TAL VED SIDEN AF
            // antalBeskeder. En sendt mail ER en besked (kanal: "mail") og
            // tælles allerede der; antalMails tæller kun HVOR MANGE af dem
            // der reelt blev sendt eksternt — svaret på "har vi rørt
            // omverdenen på denne sag", ikke en dublet af beskedtallet.
            "antalMails": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "antalKarantaene": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "harAftale": { ".validate": "newData.isBoolean()" },
            "aftaleTilstand": { ".validate": "newData.isString() && newData.val().matches(/^(forslag|aftalt|afvist)$/)" },
            "aftaleFraMs": { ".validate": "newData.isNumber()" },
            // ⚠ oprettetAf ER ET uid — hvem der GJORDE det. Sagen handler
            // ikke om en person, saa der er intet personId-modstykke her.
            "oprettetAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "oprettetMs": { ".validate": "newData.isNumber()" },
            // ⚠ SKIVE 3C — additivt felt, ikke et redesign. `sagAfslut` er den
            // foerste funktion der reelt LUKKER en sag, og en kort begrundelse
            // er hvad der adskiller "kunden svarede aldrig" fra "loest og
            // lukket" naeste gang nogen aabner sagen igen. Samme princip som
            // indberetningers ingenOmkostning.begrundelse — fritekst, men KORT
            // og administrativ, ikke braedtekst fra internettet, og derfor paa
            // BASEN og ikke i sensitive/.
            "afslutningsAarsag": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
            "$andet": { ".validate": false }
          }
        },

        // INGEN DIVISION — beslutning 19. Et koeretoej er defineret ved sin
        // ART, ikke ved en afdeling. En paahaengsvogn eller en varevogn kan
        // tilhoere begge slags vognmaend, og det er praecis derfor feltet ikke
        // siger noget: det ville skulle udfyldes paa hver bil uden at kunne
        // begrundes paa nogen af dem. Forbudt frem for valgfrit, af samme
        // grund som paa personale.
        //
        // Bemaerk at opgaver, indberetninger og etaper STADIG kraever
        // division. De er transaktioner (beslutning 15) — men vaerdien kan
        // ikke laengere kopieres fra bilen, og skriveren skal saette den selv.
        "koeretoejer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.laes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)",
          ".indexOn": ["status", "art", "naesteServiceMs"],
          "$koeretoejId": {
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.skriv|') && newData.exists() && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)",
            ".validate": "newData.hasChildren(['art', 'status'])",
            "art": { ".validate": "newData.isString() && newData.val().matches(/^(traekker|lastbil|varevogn|bus|minibus|scooter|truck|trailer|paahaeng)$/)" },
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|vaerksted|udeAfDrift|solgt|skrottet)$/)" },
            "laengdeMm": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "driftPrKmOere": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "kapacitet": {
              "m3": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "kg": { ".validate": "newData.isNumber() && newData.val() >= 0" }
            },
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" },
            "division": { ".validate": false },

            // ⚠ FELTERNE HERUNDER KOM MED SKRIVNINGEN, IKKE FOER DEN.
            //
            // Skaermen kunne laese dem laenge foer reglerne kendte dem:
            // hjemsted og naesteServiceKm blev lagt i demo-saettet da Flaade
            // skulle vise lokation og "om 1.250 km". Saa laenge ingen skrev,
            // var det harmloest. I det oejeblik en formular skriver, er et
            // uvalideret felt en aaben doer.
            //
            // ⚠ hjemsted er IKKE en enum. Kolding, Aalborg, Vejle og Odense er
            // DENNE tenants steder — en anden vognmand har andre. Et katalog i
            // regelfilen ville betyde at et nyt depot krevede en udrulning.
            // Laengden begraenses i stedet, saa fritekst ikke havner i et felt
            // der vises i en tabel.
            "hjemsted": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },

            // Maalerstand og servicemaal er HELE kilometer. Et komma gav
            // "om 1.249,7 km" i tabellen, og floats summerer ikke praecist
            // over en flaade.
            "kmStand": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "naesteServiceKm": { ".validate": "newData.isNumber() && newData.val() >= 0" },

            // Fristerne er epoch-millisekunder. En dato som streng ville
            // sortere alfabetisk og stille 10-01 foer 9-12.
            "naesteServiceMs": { ".validate": "newData.isNumber()" },
            "synMs": { ".validate": "newData.isNumber()" },

            // Kaldenavnet er det man slaar op paa. Tomt er ikke et navn.
            "kaldenavn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },

            // ⚠ NUMMERPLADEN ER DEN MAN SLAAR OP PAA. Bil 104 havde to i
            // prototypen, og det er den fejl der er dyrest at opdage sent.
            "registrering": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },

            "tachografNr": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "saeder": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "kranTonmeter": { ".validate": "newData.isNumber() && newData.val() >= 0" },

            // ⚠ AFGANG SLETTER IKKE. En solgt bil beholder sin post — der
            // haenger indberetninger og omkostningshistorik paa id'et, og
            // .write kraever i forvejen newData.exists(). Felterne her er
            // sporet efter hvorfor den gik ud af drift.
            "afgangMs": { ".validate": "newData.isNumber()" },
            "afgangAarsag": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" }
          }
        },

        // Chauffører må oprette, men ikke redigere andres. km er TOTAL
        // målerstand, ikke km siden sidste tankning.
        // ⚠ forloeb KRAEVES KUN AF DRIFTSHAENDELSER — BESLUTNING 106.
        //
        // README har beskrevet skellet siden noden blev bygget:
        // driftshaendelser (reparation, skade, daek, service, andet) starter
        // et FORLOEB; udgiftsregistreringer (tankning, parkering, truckwash,
        // kvittering) goer ikke. Reglen kraevede feltet af dem alle, saa en
        // parkeringsbillet stod med "Ny" i en tilstandsmaskine med seks trin
        // om et beloeb der bare skal bogfoeres.
        //
        // ⚠ ORDLISTEN STAAR TO STEDER, og det kan den ikke undgaa: en regel
        // kan ikke importere HAENDELSE_ART. Proeven i
        // test/indberetningsarter.test.mjs udleder listen af kataloget og
        // faelder hvis de to driver — samme ordning som meldingstyperne paa
        // noden statushaendelser (beslutning 103).
        "indberetninger": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)",
          // ⚠ HER STOD "type". Posterne baerer "art" — godsskade, reparation,
          // koeretoejsskade, braendstof. TREDJE gang et indeks navngiver et
          // felt der ikke findes (opgaver."dato", fakturaer."godkendelsesstatus").
          // Det FEJLER ikke: RTDB henter hele noden ned og filtrerer i
          // klienten med en advarsel i konsollen. Regningen kommer stille.
          ".indexOn": ["oprettetMs", "koeretoejId", "art"],
          "$id": {
            //
            // ⚠ SIDSTE LED: EN UNDERSKREVET INDBERETNING KAN IKKE SLETTES.
            //
            // Ejeren maa slette sin egen post — en fejloprettet indberetning
            // skal kunne trækkes tilbage, og der er ingen `annulleret` i
            // FORLOEB at saette den til i stedet. Men den klassificerede
            // satellit er FROSSET naar den er underskrevet, og den ligger paa
            // det SAMME id. Uden det her led kunne hovedposten forsvinde under
            // en underskrift der ikke kan slettes: et bevis der peger paa
            // ingenting, og en skade ingen kan finde igen.
            //
            // ⚠ DET ER SPAERRINGEN PAA DEN KLASSIFICEREDE POST DER GOER DET
            // NOEDVENDIGT. Foer den kunne begge dele slettes, og de to var i
            // det mindste enige. Halvdelen af en spaerring er en ny fejl.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && ((auth.token.perms != null && auth.token.perms.contains('|indberetninger.skriv|')) && (!data.exists() || data.child('oprettetAf').val() === auth.uid) || auth.token.perms != null && auth.token.perms.contains('|indberetninger.skrivAlle|')) && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true) && (newData.exists() || !root.child('tenants').child($tenantId).child('sensitive').child('indberetninger').child($id).child('underskrift').exists())",
            // ⚠ NODEN VALIDEREDE KUN division. Alt andet var frit — en art
            // vi ikke kender, et forloeb der ikke findes, en omkostning som
            // streng. Og chauffoerer SKRIVER til den: det er den ene node
            // hvor den mindst betroede rolle opretter poster.
            ".validate": "newData.hasChildren(['art', 'oprettetAf', 'oprettetMs']) && (newData.child('art').val().matches(/^(braendstof|parkering|truckwash|kvittering)$/) || newData.hasChildren(['forloeb']))",

            "division": { ".validate": false },

            // Ordlisterne staar i indberetninger.js (HAENDELSE_ART, FORLOEB).
            // Her staar de som laengdetjek af samme grund som lagre.metode:
            // en afskrift i regelfilen ville vaere et andet sted de stod, med
            // sin egen udrulningscyklus. Proeverne holder demo op mod modulet.
            "art": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "forloeb": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },

            // ⚠ SAMME TRE TRIN SOM PAA opgaver/ OG plukordrer/, OG SAMME
            // REGEX. Kataloget staar i prioritet.js. Skrev vi en fjerde
            // ordliste her, ville "Driftskalenderens fem kasser" taelle
            // indberetninger og opgaver med hver sit ordforraad — og de to
            // staar side om side i den samme koe.
            //
            // Valgfrit, som paa opgaver: det er VAERKFOEREREN der prioriterer,
            // ikke chaufføren der indberetter.
            "prioritet": { ".validate": "newData.isString() && newData.val().matches(/^(lav|normal|hoej)$/)" },

            // ⚠ uid, IKKE personId. Det er hvem der GJORDE noget — og
            // .write ovenfor sammenligner netop det felt med auth.uid.
            // Bytter man om, holder ejerskabstjekket op med at virke, fordi
            // et personId aldrig matcher et uid.
            //
            // ⚠ OG DEN SKAL VAERE SKRIVERENS EGET uid VED OPRETTELSE.
            // .write siger `!data.exists() || data.child(oprettetAf) == auth.uid`
            // — altsaa: ejerskabet proeves kun ved REDIGERING. Ved oprettelse
            // var feltet frit, og en chauffoer kunne oprette en indberetning i
            // en KOLLEGAS navn. Han kunne saa ikke rette den bagefter, men
            // sporet ville pege paa den forkerte, og auditloggen med.
            // Fundet af proeven i test/rules.indberetninger.test.mjs.
            //
            // skrivAlle maa saette et andet uid: det er hele meningen med den
            // permission — vaerkfoereren retter chauffoerens post.
            "oprettetAf": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80 && (newData.val() === auth.uid || (auth.token.perms != null && auth.token.perms.contains('|indberetninger.skrivAlle|')))" },
            "oprettetMs": { ".validate": "newData.isNumber()" },

            "koeretoejId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('koeretoejer').child(newData.val()).exists()" },
            // ⚠ EN INDBERETNING KAN HOERE TIL EN TUR — OG SAA SKAL TUREN FINDES.
            // Feltet er valgfrit: en kunde uden Planning har udmaerket
            // indberetninger, de er bare ikke bundet til en booking (seedet
            // nuller det, se beslutning 100). Men staar der et bookingId, er
            // det koblingen mellem en skade og den tur der forvoldte den —
            // og et id der peger paa ingenting, er et spor der ender blindt
            // netop naar nogen leder. Se beslutning 101.
            "bookingId": { ".validate": "newData.isString() && newData.val().length <= 60 && root.child('tenants').child($tenantId).child('bookinger').child(newData.val()).exists()" },
            // ⚠ `sager/` findes nu — beslutning 112. Feltet er stadig
            // valgfrit (samme grund som bookingId), men staar der en vaerdi,
            // skal den pege paa en sag der findes.
            "sagId": { ".validate": "newData.isString() && newData.val().length <= 60 && root.child('tenants').child($tenantId).child('sager').child(newData.val()).exists()" },
            "indkoebId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('indkoeb').child(newData.val()).exists()" },
            "beskrivelse": { ".validate": "newData.isString() && newData.val().length <= 500" },

            // Oere som integer. En float bliver 1849,999 i en sum.
            "omkostningOere": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },
            // ⚠ SKIVE 3B — HER STOD "newData.isBoolean()". indberetninger.js'
            // kanAfslutte() har hele tiden læst `ingenOmkostning.begrundelse`
            // — et OBJEKT, ikke et flueben — og demo-indberetninger.js skrev
            // allerede formen `{ begrundelse, af, ms }`. Reglen var den ene
            // brik der ikke fulgte med: en bruger der rent faktisk prøvede at
            // afslutte uden omkostning, kunne ALDRIG skrive den begrundelse
            // kanAfslutte() krævede, fordi reglen kun tog imod en boolean.
            // Uden begrundelsen kan "dækket af garantien" ikke skelnes fra
            // "vi glemte fakturaen" — se kanAfslutte()'s eget hoved.
            "ingenOmkostning": {
              ".validate": "newData.hasChildren(['begrundelse'])",
              "begrundelse": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
              // af/ms: KONTORETS afgørelse og hvornår — samme snit som
              // underskriftens ms, sat af den Cloud Function der lukker
              // indberetningen, ikke af klienten.
              "af": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "ms": { ".validate": "newData.isNumber()" },
              "$andet": { ".validate": false }
            },

            // Braendstof: km er TOTAL maalerstand, ikke km siden sidst.
            "kmStand": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "liter": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "adBlueLiter": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "prisPrLiterOere": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },

            "tidsregistrering": {
              "ankomstMs": { ".validate": "newData.isNumber()" },
              "afgangMs": { ".validate": "newData.isNumber()" },
              "registreretAf": { ".validate": "newData.isString() && newData.val().length <= 80" },
              "registreretMs": { ".validate": "newData.isNumber()" },
              "$andet": { ".validate": false }
            },

            "materialelinjer": {
              "$linjeId": {
                ".validate": "newData.hasChildren(['vare', 'maengde'])",
                "vare": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
                "varenummer": { ".validate": "newData.isString() && newData.val().length <= 60" },
                // TUSINDEDELE — MAENGDE_SKALA i indberetninger.js importeres
                // fra grundlag.js. To skalaer fakturerer 1000x forkert.
                "maengde": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
                "enhed": { ".validate": "newData.isString() && newData.val().length <= 20" },
                // ⚠ INGEN EKSISTENSTJEK — OG DET ER ET AABENT SPOERGSMAAL,
                // ikke en forglemmelse. `lagre` beskrives tre steder som
                // "reservedelslageret under Indkoeb" (moduler.js,
                // unitbooking.js, README), men `pricing.js` slaar op i
                // `satsark.lagre[lagerId]` for LAGEROPHOLD paa en booking, med
                // `prLagerdoegn`-satser. To betydninger, én node.
                //
                // ⚠ OG BESLUTNING 92 GJORDE IKKE SPOERGSMAALET MINDRE.
                // Demo-linjerne hed "lager-hoved" og "lager-vaerksted" og pegede
                // paa ingenting; de peger nu paa `lag-kolding`, som er en
                // OPBEVARINGSLOKATION med doegnsats. Referencen resolver —
                // semantikken goer ikke. En reservedel er hentet fra et
                // reservedelslager, ikke fra en kundes opbevaringsplads.
                //
                // Et opslag her ville laase noden fast paa den ene laesning
                // uden at nogen havde besluttet hvilken. Se README's liste over
                // uafklarede spoergsmaal og beslutning 101.
                "lagerId": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "faktureret": { ".validate": "newData.isBoolean()" },
                "$andet": { ".validate": false }
              }
            },

            // ⚠ DE TRE KLASSIFICEREDE FELTER MAA IKKE STAA HER.
            // skadeBeskrivelse, modpart og underskrift hoerer i
            // sensitive/indberetninger — beslutning 17. Uden de her tre
            // linjer kunne en skadebeskrivelse skrives paa hovedposten, som
            // ENHVER med flaademodulet kan laese, og adskillelsen ville vaere
            // en konvention frem for en spaerring.
            "skadeBeskrivelse": { ".validate": false },
            "modpart": { ".validate": false },
            "underskrift": { ".validate": false },

            "$andet": { ".validate": false }
          }
        },

        // Skriver en reservation med kilde 'fravaer' på chaufføren, så en syg
        // chauffør ikke kan disponeres.
        // INGEN division: fraværet hænger på chaufføren, og en chauffør med
        // C+D er fælles — fraværet blokerer ham i begge afdelinger. Gav vi det
        // en division, ville han være syg i gods og rask i bus.
        // ⚠ EN ANSOEGNING OM FRIHED — BESLUTNING 108.
        //
        // `.write` kraevede `fravaer.skriv`, som ingen chauffoer har. Han
        // faar nu EN gren: en ansoegning paa SIG SELV, i status 'ansoegt',
        // uden kontorets svarfelter, og kun som en NY post. Uden det sidste
        // led kunne han rette en afvist ansoegning tilbage til ansoegt.
        //
        // ⚠ MAN ANSOEGER IKKE OM SYGDOM, og det er dét der goer det muligt.
        // `art` er en helbredsoplysning og bor i `sensitive/fravaer`, hvis
        // `.write` kraever BAADE fravaer.skriv OG fravaer.sensitiveLaes.
        // Det han soeger om — ferie, feriefridag, afspadsering — er ingen af
        // delene, og staar derfor som `oensket` paa BASISNODEN.
        //
        // ⚠ `oensket` OG `art` ER IKKE SAMME FELT TO STEDER: det ene er hvad
        // han BAD OM, det andet hvad der blev REGISTRERET. De kan vaere
        // forskellige — han beder om ferie og faar afspadsering.
        //
        // ⚠ OG ET FRAVAER UDEN `ansoegning` ER KONTORETS EGEN REGISTRERING.
        // Hvert eksisterende fravaer opfoerer sig praecis som foer.
        "fravaer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|fravaer.laes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true)",
          ".indexOn": ["fra"],
          "$fravaerId": {
            "ansoegning": {
              ".validate": "newData.hasChildren(['status', 'oensket', 'ansoegtMs'])",
              "status": { ".validate": "newData.isString() && newData.val().matches(/^(ansoegt|godkendt|afvist)$/)" },
              // ⚠ KUN DE TRE. Slap `sygdom` igennem her, ville en chauffoer
              // have skrevet en helbredsoplysning paa en node uden
              // fravaer.sensitiveLaes. Listen staar to steder — koden kan
              // ikke importeres i en regel — og en proeve holder dem sammen.
              "oensket": { ".validate": "newData.isString() && newData.val().matches(/^(ferie|feriefridag|afspadsering)$/)" },
              "ansoegtMs": { ".validate": "newData.isNumber()" },
              // ⚠ SVARET KRAEVER fravaer.skriv. Feltet kan kun skrives af
              // den gren ovenfor der har permissionen — chauffoerens gren
              // afviser posten hvis et af de tre findes.
              "afgjortAf": { ".validate": "newData.isString() && newData.val().length > 0" },
              "afgjortMs": { ".validate": "newData.isNumber()" },
              "svar": { ".validate": "newData.isString() && newData.val().length <= 300" },
              "$andet": { ".validate": false }
            },
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && ((auth.token.perms.contains('|fravaer.skriv|')) || (newData.child('personId').val() === root.child('tenants').child($tenantId).child('brugere').child(auth.uid).child('personId').val() && newData.child('ansoegning').child('status').val() === 'ansoegt' && !newData.child('ansoegning').child('afgjortAf').exists() && !newData.child('ansoegning').child('afgjortMs').exists() && !newData.child('ansoegning').child('svar').exists() && !data.exists())) && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true) && newData.exists()",
            ".validate": "newData.hasChildren(['personId'])",
            "division": { ".validate": false },
            "art": { ".validate": false },
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" }
          }
        },

        // ⚠ NODEN HAVDE INGEN VALIDERING OVERHOVEDET. Kun .write bag en
        // permission — alt derunder var frit. En lokation uden navn, et anlaeg
        // med en opdigtet art, et areal som streng: alt blev taget imod. Saa
        // laenge ingen skrev, var det harmloest. Piloten skriver.
        "facility": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('facility').val() === true)",

          "lokationer": {
            ".indexOn": ["type"],
            "$lokationId": {
              // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
              // newData.exists(). Begge dele er noedvendige, og de stopper hver
              // sin ting: laa reglen paa noden, kunne ET kald tomme hele
              // registret — og uden leddet kunne en enkelt post hardslettes.
              // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
              // Se beslutning 53.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|facility.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('facility').val() === true) && newData.exists()",
              ".validate": "newData.hasChildren(['navn', 'type'])",
              "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "type": { ".validate": "newData.isString() && newData.val().matches(/^(hovedkontor|depot|lager|vaerksted)$/)" },
              // ⚠ sted er IKKE en enum — samme begrundelse som hjemsted paa et
              // koeretoej. Stederne er DENNE tenants; et katalog i regelfilen
              // ville betyde at et nyt depot krevede en udrulning.
              "sted": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
              // Kvadratmeter som HELT tal. Et areal maales i hele meter i BBR,
              // og et komma her ville antyde en praecision vi ikke har.
              "arealM2": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "adresse": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "division": { ".validate": false }
            }
          },

          "aktiver": {
            ".indexOn": ["lokationId", "status", "naesteServiceMs"],
            "$aktivId": {
              // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
              // newData.exists(). Begge dele er noedvendige, og de stopper hver
              // sin ting: laa reglen paa noden, kunne ET kald tomme hele
              // registret — og uden leddet kunne en enkelt post hardslettes.
              // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
              // Se beslutning 53.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|facility.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('facility').val() === true) && newData.exists()",
              ".validate": "newData.hasChildren(['navn', 'art', 'status', 'lokationId'])",
              "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              // ⚠ art ER UDSTYRSTYPEN, ikke opgave.art. Samme feltnavn, to
              // vokabularer — se ARKITEKTUR. Blandes de, faar et koeleanlaeg
              // arten 'facility' og forsvinder ud af enhver liste.
              "art": { ".validate": "newData.isString() && newData.val().matches(/^(port|koeleanlaeg|ventilation|vaskehal|ladestander|alarm|truck)$/)" },
              "status": { ".validate": "newData.isString() && newData.val().matches(/^(idrift|fejl|service|udeAfDrift)$/)" },
              // Anlaegget SKAL staa et sted. Et anlaeg uden lokation kan ikke
              // vises i driftsstatus og taeller ikke med noget sted.
              "lokationId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('lokationer').child(newData.val()).exists()" },
              "zoneId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('zoner').child(newData.val()).exists()" },
              "serviceIntervalDage": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "naesteServiceMs": { ".validate": "newData.isNumber()" },
              // ⚠ personId, ALDRIG uid. Den ansvarlige er hvem det HANDLER om;
              // en facilityansvarlig har maaske intet login. Se beslutning 18.
              "ansvarligPersonId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('personale').child(newData.val()).exists()" },
              "division": { ".validate": false }
            }
          },

          // ⚠ ZONEN BAERER GRAENSERNE. Ligger taersklen paa sensoren, skriver
          // en justering i MAALEDATA — og saa er historikken aendret bagud.
          "zoner": {
            ".indexOn": ["lokationId"],
            "$zoneId": {
              // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
              // newData.exists(). Begge dele er noedvendige, og de stopper hver
              // sin ting: laa reglen paa noden, kunne ET kald tomme hele
              // registret — og uden leddet kunne en enkelt post hardslettes.
              // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
              // Se beslutning 53.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|facility.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('facility').val() === true) && newData.exists()",
              ".validate": "newData.hasChildren(['navn', 'art', 'lokationId'])",
              "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "art": { ".validate": "newData.isString() && newData.val().matches(/^(frost|koel|tempereret|kontor)$/)" },
              "lokationId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('lokationer').child(newData.val()).exists()" },
              "graenser": {
                ".validate": "newData.hasChildren(['minC', 'maksC'])",
                // ⚠ MIN SKAL VAERE UNDER MAKS. En zone med byttede graenser
                // alarmerer ALDRIG — alarmTilstand() finder ingen maaling der
                // ligger uden for et interval der er tomt. Det ser ud som om
                // alt er i orden, og det er den vaerste fejltilstand.
                "minC": { ".validate": "newData.isNumber() && newData.val() < newData.parent().child('maksC').val()" },
                "maksC": { ".validate": "newData.isNumber() && newData.val() > newData.parent().child('minC').val()" }
              },
              "division": { ".validate": false }
            }
          },

          // ÉN kilde til sensorværdier. Både Facility-overblik og
          // Klima-skærmen læser herfra — i mockupsene viste de forskellige
          // temperaturer for samme zoner.
          "sensorer": {
            "$zoneId": {
              // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
              // newData.exists(). Begge dele er noedvendige, og de stopper hver
              // sin ting: laa reglen paa noden, kunne ET kald tomme hele
              // registret — og uden leddet kunne en enkelt post hardslettes.
              // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
              // Se beslutning 53.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|facility.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('facility').val() === true) && newData.exists()",
              // ⚠ INGEN graenser HER. Se noten paa zoner. .validate: false
              // afviser feltet, saa fejlen ikke kan indfoeres ved et uheld.
              "graenser": { ".validate": false },
              "aktuel": {
                ".validate": "newData.hasChildren(['tempC', 'ms'])",
                "tempC": { ".validate": "newData.isNumber()" },
                "fugtPct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
                "ms": { ".validate": "newData.isNumber()" }
              },
                "maalinger": {
                ".indexOn": ["ms"],
                "$maalingId": {
                  "tempC": { ".validate": "newData.isNumber()" },
                  "fugtPct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
                  "ms": { ".validate": "newData.isNumber()" }
                }
              }
            }
          },

          "fejl": {
            ".indexOn": ["aktivId", "status", "meldtMs"],
            "$fejlId": {
              // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
              // newData.exists(). Begge dele er noedvendige, og de stopper hver
              // sin ting: laa reglen paa noden, kunne ET kald tomme hele
              // registret — og uden leddet kunne en enkelt post hardslettes.
              // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
              // Se beslutning 53.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|facility.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('facility').val() === true) && newData.exists()",
              ".validate": "newData.hasChildren(['aktivId', 'status', 'alvor', 'meldtMs'])",
              "aktivId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('aktiver').child(newData.val()).exists()" },
              "status": { ".validate": "newData.isString() && newData.val().matches(/^(ny|planlagt|igang|udbedret)$/)" },
              // Samme tre trin som alvorTone() i format.js. Fire vaerdier her
              // og tre dér ville give en pille uden farve.
              "alvor": { ".validate": "newData.isString() && newData.val().matches(/^(hoej|mellem|lav)$/)" },
              "meldtMs": { ".validate": "newData.isNumber()" },
              "beskrivelse": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
              "meldtAf": { ".validate": "newData.isString() && newData.val().length <= 80" },
              "division": { ".validate": false }
            }
          },

          // Bygningsomkostningens KOMPONENTER. Totalen gemmes aldrig — den
          // beregnes af bygningsomkostningOere(). Et gemt totalfelt ville
          // kunne drive fra komponenterne; her er der ingen at drive fra.
          "omkostning": {
            "$post": {
              // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
              // newData.exists(). Begge dele er noedvendige, og de stopper hver
              // sin ting: laa reglen paa noden, kunne ET kald tomme hele
              // registret — og uden leddet kunne en enkelt post hardslettes.
              // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
              // Se beslutning 53.
              ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|facility.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('facility').val() === true) && newData.exists()",
              ".validate": "newData.isNumber() && newData.val() >= 0 && $post.matches(/^(el|varme|vand|ventilation|alarm)$/)"
            }
          }
        },

        // ══════════════════════════════════════════════════════════════
        // LEVERANDOEREN SOM ENTITET — beslutning 18, femte gang
        // ══════════════════════════════════════════════════════════════
        //
        // ⚠ NODEN FANDTES SLET IKKE I DENNE FIL. Modellen har regnet med den
        // hele tiden: BAADE "indkoeb" og "fakturaer" har indekseret
        // leverandoerId, siden de blev skrevet. Der var bare ikke noget at
        // slaa op i, og imens stod leverandoerens navn som FRITEKST i tre
        // demo-filer med hver sin stavemaade — "Mercedes Greve" i
        // demo-vaerksted, i demo-sag og naesten i demo-indkoeb. Det er Bil 104
        // med to nummerplader igen.
        //
        // ⚠ DIVISION: JA, SOM PAA KUNDER — IKKE SOM PAA PERSONALE.
        // Proeven er om feltet beskriver LEVERANDOERENS forretning eller VORES
        // organisation. Beslutning 19 forbyder det paa personale og
        // koeretoejer, fordi vaerdien dér ville beskrive vores egen opdeling.
        // Paa en leverandoer kan den begrundes: Mercedes Greve er et
        // lastbilvaerksted, Crawford leverer porte til begge.
        //
        // ⚠ SKIVE 4B — .read KRÆVER leverandoerer.laes, IKKE indkoeb.laes.
        // Model B (Korrektion 3): fuldt ugatet base-node, ingen modulklausul
        // — samme mønster som fakturaer/satser/grundlag, IKKE reolpladser'
        // inline modul-OR. Se moduler.js.
        // ⚠ OG DEN LAESES AF ELLEVE SKAERME, ogsaa uden for Procure:
        // Disponering, Servicekalender, Arbejdskoeen og
        // Vaerkstedskalender slaar alle op i kartoteket. Derfor har
        // disponenten og lagermedarbejderen den ogsaa — det blev maalt,
        // ikke antaget.
        "leverandoerer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|leverandoerer.laes|')",
          ".indexOn": ["aktiv", "kategori", "navn"],

          "$leverandoerId": {
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            // ⚠ SKIVE 4B — kræver leverandoerer.skriv, ingen modulklausul.
            // Skrives direkte af klienten (gem() i skriv.js) — samme
            // disciplin som kunder og reolpladser. Ingen Cloud Function.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|leverandoerer.skriv|') && newData.exists()",
            ".validate": "newData.hasChildren(['navn', 'kategori'])",

            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },

            // ⚠ CVR ER OTTE CIFRE, OG DET ER IKKE ET TAL. Et CVR med foranstillet
            // nul ville miste nullet som number, og saa matcher det ikke
            // registret. Samme grund som at et telefonnummer er en streng.
            "cvr": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8}$/)" },

            "kategori": { ".validate": "newData.isString() && newData.val().matches(/^(vaerksted|reservedele|daek|braendstof|facility|kontor|transport)$/)" },
            "division": { ".validate": false },
            // ⚠ EN LEVERANDOER SLETTES IKKE — han taget UD AF DRIFT. Hans
            // fakturaer og indkoebslinjer peger paa ham, og et regnskab der
            // henviser til en post der ikke findes, kan ikke efterproeves.
            // Feltet er derfor ikke pynt: det er sletningens erstatning.
            "aktiv": { ".validate": "newData.isBoolean()" },

            "kontaktEmail": { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().contains('@')" },
            "kontaktTelefon": { ".validate": "newData.isString() && newData.val().length <= 40" },

            "aftale": {
              ".validate": "newData.hasChildren(['type'])",
              // ⚠ AFTALEFORMEN AFGOER HVAD EN PRISAFVIGELSE BETYDER. En
              // fastaftale der afviger 4 %, er et brud paa aftalen; et spotkoeb
              // der goer det, er markedet. Samme tal, to betydninger — se
              // prisafvigelseTone() i leverandoerer.js.
              "type": { ".validate": "newData.isString() && newData.val().matches(/^(fastaftale|rammeaftale|spot)$/)" },
              "gyldigFra": { ".validate": "newData.isNumber()" },
              "gyldigTil": { ".validate": "newData.isNumber()" },
              "$andet": { ".validate": false }
            },

            // ⚠ PRISLISTEN LIGGER PAA LEVERANDOEREN, IKKE I EN EGEN NODE.
            // Den ER hans aftale med os, og prisPaa() slaar op i den. Laa den
            // for sig, skulle to steder holdes i sync om hvem prisen tilhoerer.
            //
            // ⚠ OG DEN ER VERSIONERET PAA DATO. Enhver pris i et regnskab skal
            // kunne slaas op PAA EN DATO: en faktura fra marts skal maales mod
            // den pris der gjaldt i marts. Rettes prisen i stedet, ville
            // afvigelsen pege paa leverandoeren frem for paa os.
            //
            // Formen er den SAMME som satser/$gruppe/satser — og forbeholdet
            // derovre gaelder ordret her: reglen kan ikke forbyde en
            // overskrivning uden ogsaa at forbyde en rettelse af en tastefejl
            // samme dag. Den haandhaever FORMEN; beslutningen om at en ny pris
            // er en NY post, haandhaeves af skaermen og af proeven paa den.
            "prisliste": {
              ".indexOn": ["gyldigFra", "varenummer"],
              "$prisId": {
                ".validate": "newData.hasChildren(['varenummer', 'prisOere', 'gyldigFra'])",
                "varenummer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
                "vare": { ".validate": "newData.isString() && newData.val().length <= 120" },
                "enhed": { ".validate": "newData.isString() && newData.val().length <= 20" },
                // Hele oere som alt andet, og med samme loft som indkoebets
                // pris: en tastefejl med tre nuller for meget skal fanges her,
                // ikke opdages i en afstemning.
                "prisOere": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0 && newData.val() <= 10000000000" },
                "gyldigFra": { ".validate": "newData.isNumber()" },
                "oprettetAf": { ".validate": "newData.isString()" },
                "oprettetMs": { ".validate": "newData.isNumber()" },
                "$andet": { ".validate": false }
              }
            },

            "$andet": { ".validate": false }
          }
        },

        // ══════════════════════════════════════════════════════════════════
        // INDKOEBSBEHOV — trin 1 i Procures proces (beslutning 78)
        // ══════════════════════════════════════════════════════════════════
        //
        // Et BEHOV er ikke en ordre. Det er en medarbejder der siger "vi
        // mangler traeplader" — fra snedkeriet, lageret, kontoret eller som
        // et kontantkoeb. Det er trin 1 af fem, og det fandtes ikke: noden
        // `indkoeb` er LINJER der allerede er koebt, altsaa en registrering
        // BAGUD.
        //
        // ⚠ .write: false, OG DET ER VEJEN DER ER LUKKET, IKKE RETTEN.
        // Casehandler, disponent og admin HAR `indkoeb.skriv`. Men et behov
        // der bliver til en ordre, aendrer TO poster — behovet faar sin
        // ordrereference, og ordren faar sin linje — og de skal skrives
        // atomisk eller slet ikke. Kunne en klient skrive den ene halvdel,
        // ville et behov kunne staa som "bestilt" uden en ordre der findes.
        // Samme ordning som opgaver (45), kasseudlaan (37) og enheder (39).
        //
        // ⚠ KILDEN ER ET FELT MED FIRE VAERDIER, ikke en fri streng. Planchen
        // grupperer indbakken paa den, og en femte stavemaade ville lave en
        // gruppe mere som ingen har besluttet.
        "indkoebsbehov": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true) && auth.token.perms != null && auth.token.perms.contains('|indkoeb.laes|')",
          ".write": false,
          // Indbakken sorteres paa tidspunkt og filtreres paa kilde og status.
          ".indexOn": ["oprettetMs", "kilde", "status"],
          "$behovId": {
            // ⚠ VAREN ER FRITEKST HER, og det er med vilje: den der melder
            // ind, ved hvad han mangler, ikke hvad det hedder i kataloget.
            // Koblingen til `forbrugsvarer` sker naar nogen laegger behovet i
            // en bestilling — ikke naar det meldes.
            ".validate": "newData.hasChildren(['vare', 'kilde', 'status', 'oprettetMs', 'oprettetAf'])",
            "vare": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "kilde": { ".validate": "newData.isString() && newData.val().matches(/^(snedkeri|lager|kontor|kontantkoeb)$/)" },
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(nyt|klarTilBestilling|iKladde|bestilt|afvist)$/)" },
            "prioritet": { ".validate": "newData.isString() && newData.val().matches(/^(lav|mellem|hoej)$/)" },
            "antal": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "enhed": { ".validate": "newData.isString() && newData.val().length <= 20" },
            // ⚠ HVEM DET HANDLER OM, IKKE HVEM DER GJORDE DET. `anmoderId` er
            // et personId; `oprettetAf` er et uid. Byttes de om, holder
            // ejerskabstjek op med at virke — se CLAUDE.md. Beslutning 111.
            "anmoderId": { ".validate": "newData.isString() && newData.val().length <= 60 && root.child('tenants').child($tenantId).child('personale').child(newData.val()).exists()" },
            "oprettetAf": { ".validate": "newData.isString()" },
            "oprettetMs": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 250" },
            "varenummer": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "leverandoerId": { ".validate": "newData.isString()" },
            // Saettes naar behovet laegges i en bestilling.
            "ordreId": { ".validate": "newData.isString()" },
            "afvistAf": { ".validate": "newData.isString()" },
            "afvistMs": { ".validate": "newData.isNumber()" },
            "begrundelse": { ".validate": "newData.isString() && newData.val().length <= 250" },
            // ⚠ INGEN division — aksen er fjernet i beslutning 70.
            "division": { ".validate": false },
            "$andet": { ".validate": false }
          }
        },

        // ══════════════════════════════════════════════════════════════════
        // INDKOEBSORDRER — trin 2 (beslutning 78)
        // ══════════════════════════════════════════════════════════════════
        //
        // ⚠ NUMMERET KOMMER FRA EN TAELLER, IKKE FRA EN OPTAELLING.
        // `countere/indkoebsordre/<aar>`, samme mekanisme som bookingnumrene
        // (beslutning 8 og 55). En optaelling som nummerkilde giver to ordrer
        // det samme nummer den dag to bestillinger rammer samme sekund.
        //
        // ⚠ OG LINJERNE LIGGER PAA ORDREN, ikke som en node ved siden af.
        // En ordre UDEN linjer er ikke en ordre; laa de hver for sig, kunne
        // den ene halvdel lande.
        "indkoebsordrer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true) && auth.token.perms != null && auth.token.perms.contains('|indkoeb.laes|')",
          ".write": false,
          ".indexOn": ["status", "leverandoerId", "oprettetMs"],
          "$ordreId": {
            ".validate": "newData.hasChildren(['nummer', 'leverandoerId', 'status', 'oprettetMs', 'oprettetAf'])",
            // BST-2026-00001. Formatet er laast her, saa en haandskrevet post
            // ikke kan komme ind i serien med et andet moenster.
            "nummer": { ".validate": "newData.isString() && newData.val().matches(/^BST-[0-9]{4}-[0-9]{5}$/)" },
            "leverandoerId": { ".validate": "newData.isString() && newData.val().length > 0" },
            // ⚠ godkendt OG afvist er egne tilstande, ikke et flag ved siden
            // af. Godkendelsen er trin 3, og en ordre der er sendt uden at
            // vaere godkendt, skal kunne ses paa tilstanden alene.
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(kladde|afventerGodkendelse|godkendt|afvist|sendt|modtaget|annulleret)$/)" },
            "oprettetAf": { ".validate": "newData.isString()" },
            "oprettetMs": { ".validate": "newData.isNumber() && newData.val() > 0" },
            // ⚠ SAMME PAR SOM anmoderId. `bestillerId` er hvem ordren er
            // lagt PÅ VEGNE AF — et personId, ikke et login. Beslutning 111.
            "bestillerId": { ".validate": "newData.isString() && newData.val().length <= 60 && root.child('tenants').child($tenantId).child('personale').child(newData.val()).exists()" },
            "godkendtAf": { ".validate": "newData.isString()" },
            "godkendtMs": { ".validate": "newData.isNumber()" },
            // ⚠ ET FLAG DER SIGER OM ET MENNESKE KIGGEDE.
            // En ordre under beloebsgraensen godkendes uden at nogen har set
            // den, og den faar derfor INGEN godkendtAf — et uid dér ville
            // paastaa at en person sagde god for den. Uden flaget kan man
            // ikke se forskel paa et indkoeb nogen godkendte, og et der bare
            // var lille nok. Samme forhold som 'afkortet' paa reservationen.
            "godkendtAutomatisk": { ".validate": "newData.isBoolean()" },
            // ⚠ OG PAA SELVGODKENDELSE. Reglen navngiver ÉN godkender, og
            // laegger han selv ordren, kan kun han godkende den — ellers var
            // posten en blindgyde. Det er tilladt, og det skal kunne SES.
            "selvgodkendt": { ".validate": "newData.isBoolean()" },
            "afvistAf": { ".validate": "newData.isString()" },
            "afvistMs": { ".validate": "newData.isNumber()" },
            "begrundelse": { ".validate": "newData.isString() && newData.val().length <= 250" },
            "sendtMs": { ".validate": "newData.isNumber()" },
            "modtagetMs": { ".validate": "newData.isNumber()" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 250" },
            "linjer": {
              "$linjeId": {
                ".validate": "newData.hasChildren(['vare', 'antal', 'prisPrEnhedOere'])",
                "vare": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
                "varenummer": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "antal": { ".validate": "newData.isNumber() && newData.val() > 0" },
                "enhed": { ".validate": "newData.isString() && newData.val().length <= 20" },
                // ⚠ HELE OERE SOM INTEGER, ekskl. moms — som alle beloeb.
                // ⚠ `% 1 === 0` OG IKKE `toInt()`. RTDB-regler har ingen
                // toInt — filen kunne slet ikke indlaeses, og emulatoren
                // sagde det med det samme. Det er den fejl der engang
                // overlevede gennemlaesning i maanedsvis, fordi ingen koerte
                // reglerne. Loftet er 100 mio. kr. pr. enhed, som paa de
                // oevrige beloeb.
                "prisPrEnhedOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000000000" },
                // Behovet linjen kom fra, saa sporet gaar begge veje.
                "behovId": { ".validate": "newData.isString()" },
                "forbrugsvareId": { ".validate": "newData.isString()" },
                "$andet": { ".validate": false }
              }
            },
            "division": { ".validate": false },
            "$andet": { ".validate": false }
          }
        },

        // ══════════════════════════════════════════════════════════════════
        // FORBRUGSVARER — Procures EGET varelager (beslutning 85)
        //
        // ⚠ IKKE "varer". Den node er Warehouses, hvor godset er KUNDENS og
        // kundeId er PAAKRAEVET. Det her er vores egne forbrugsvarer:
        // handsker, straekfilm, papir, filtre. Fjerde gang et lagernavn skal
        // skilles fra et andet i den her base — se noten i forbrugsvarer.js.
        //
        // ⚠ OG SKELLET ER IKKE PEDANTERI. Overblikkets kort "Lav
        // lagerbeholdning" stod som null indtil den her node fandtes, netop
        // fordi alternativet — at regne det af varer/beholdning — ville faa
        // Procure til at bede os bestille noget en KUNDE mangler.
        // Se beslutning 84.
        //
        // ⚠ write:false PAA BEGGE, OG DET ER VEJEN DER ER LUKKET.
        // Beholdningen og bevaegelsen baerer den SAMME kendsgerning — det ene
        // som et tal, det andet som en raekke — og de skrives atomisk sammen
        // eller slet ikke. Deler man skrivningen i to kald, kan halvdelen
        // lande, og saa er uenigheden vores egen. Samme ordning som
        // enheder/beholdning (beslutning 39) og kasseudlaan (37).
        "forbrugsvarer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true) && auth.token.perms != null && auth.token.perms.contains('|indkoeb.laes|')",
          ".write": false,
          ".indexOn": ["navn", "varenummer"],
          "$vareId": {
            ".validate": "newData.hasChildren(['navn', 'enhed'])",
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "varenummer": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "enhed": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            // ⚠ MINIMUM ER VALGFRIT. En vare uden graense har ingen "lav"-tilstand.
            // Nul som standard ville betyde ALDRIG lav; et tal ville vaere en
            // indkoebspolitik vi havde opfundet paa kundens vegne. Manglen taelles
            // af udenGraense() og vises paa skaermen.
            "minimumBeholdning": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            // ⚠ BEHOLDNINGEN SKRIVES KUN SAMMEN MED EN BEVAEGELSE. Den maa gerne
            // vaere negativ: et forbrug der bringer tallet under nul, SKETE — og
            // afviste vi det, ville den rigtige haendelse gaa tabt for at beskytte
            // et tal der allerede var galt. Den negative beholdning er beviset paa
            // at der mangler en bevaegelse. Svaret er en OPTAELLING.
            "beholdning": { ".validate": "newData.isNumber()" },
            "leverandoerId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('leverandoerer').child(newData.val()).exists()" },
            "lokationId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('lokationer').child(newData.val()).exists()" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 250" },
            "oprettetAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "oprettetMs": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "sidstBevaegetMs": { ".validate": "newData.isNumber()" },
            "division": { ".validate": false },
            "$andet": { ".validate": false }
          }
        },

        // Bevaegelserne. Append-only i praksis: en post rettes ikke, den
        // modsvares af en ny. En OPTAELLING er rettelsen.
        "forbrugsvarebevaegelser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true) && auth.token.perms != null && auth.token.perms.contains('|indkoeb.laes|')",
          ".write": false,
          ".indexOn": ["forbrugsvareId", "ms"],
          "$bevaegelseId": {
            ".validate": "newData.hasChildren(['forbrugsvareId', 'art', 'antal', 'ms', 'uid'])",
            "forbrugsvareId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('forbrugsvarer').child(newData.val()).exists()" },
            // ⚠ FIRE ARTER, IKKE ET FORTEGN. antal: -3 alene siger at tallet faldt
            // — ikke OM det var forbrug, svind eller en optaelling der rettede en
            // fejl. De tre kraever hver sin handling.
            "art": { ".validate": "newData.isString() && newData.val().matches(/^(modtaget|forbrug|svind|optaelling)$/)" },
            // ⚠ ALTID POSITIVT. Retningen kommer af ARTEN. Et minus paa et forbrug
            // ville traekke to gange.
            "antal": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "ms": { ".validate": "newData.isNumber() && newData.val() > 0" },
            // uid — hvem der GJORDE det. Ikke personId.
            "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 250" },
            // Beholdningen FOER og EFTER, saa en raekke kan laeses alene.
            "foer": { ".validate": "newData.isNumber()" },
            "efter": { ".validate": "newData.isNumber()" },
            // Kom varen ind paa en bestilling, staar sporet her.
            "ordreId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('indkoebsordrer').child(newData.val()).exists()" },
            "division": { ".validate": false },
            "$andet": { ".validate": false }
          }
        },
        // ══════════════════════════════════════════════════════════════════
        // GODKENDELSESREGLER — Procures trin 3 (beslutning 82, planche 2)
        //
        // Virksomhedens EGEN politik: skal et indkoeb over et beloeb
        // godkendes, og af hvem. To regler, hver med sin kontakt, og begge
        // KAN SLAAS FRA — kunden bad udtrykkeligt om det: en lille virksomhed
        // hvor samme person bestiller og godkender, faar intet ud af et
        // ekstra trin.
        //
        // ⚠ NODEN ER ET OBJEKT, IKKE EN LISTE. Der er ÉN politik pr. tenant.
        // En liste ville invitere til to raekker der er uenige om graensen,
        // og saa ville "hvilken gaelder" vaere et spoergsmaal uden svar.
        //
        // ⚠ ".write: false", OG DET ER IKKE EN MANGLENDE RETTIGHED.
        // Vejen gaar gennem godkendelsesregelskriv, som kraever
        // brugere.skriv — IKKE indkoeb.skriv. Den der rammer loftet, maa
        // ikke kunne haeve det; et loft der kan haeves af den der rammer det,
        // er ikke et loft. Det er praecis den skelnen beslutning 24 rettede
        // 23 paa, og her koster den penge.
        //
        // ⚠ OG DEN ER LAESBAR FOR ALLE I TENANTEN. Hvem der skal godkende, er
        // ikke foelsomt — og en skaerm der ikke kan laese reglen, kan ikke
        // sige HVORFOR en ordre venter.
        "godkendelsesregler": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true) && auth.token.perms != null && auth.token.perms.contains('|indkoeb.laes|')",
          ".write": false,
          ".validate": "newData.hasChildren(['overBeloeb', 'fakturagodkendelse'])",
          "overBeloeb": {
            ".validate": "newData.hasChild('aktiv')",
            "aktiv": { ".validate": "newData.isBoolean()" },
            // Hele oere som integer, som alle beloeb — 5.000 kr er 500000.
            // ⚠ % 1 === 0 og ikke toInt(): RTDB-regler har ingen toInt, og
            // filen kunne slet ikke indlaeses den dag det blev proevet.
            "graenseOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000000000" },
            // ⚠ uid, IKKE personId. Godkenderen GOER noget — han skal have et
            // login. En chauffoer har maaske slet intet.
            "godkenderUid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
            "$andet": { ".validate": false }
          },
          "fakturagodkendelse": {
            ".validate": "newData.hasChild('aktiv')",
            "aktiv": { ".validate": "newData.isBoolean()" },
            "godkenderUid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
            "$andet": { ".validate": false }
          },
          "aendretAf": { ".validate": "newData.isString()" },
          "aendretMs": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "division": { ".validate": false },
          "$andet": { ".validate": false }
        },

        // beloebOere er ALTID ekskl. moms. momsOere er et separat felt. Bland
        // dem ikke — ellers lægges inkl.-tal sammen med ekskl.-tal i en rapport.
        // faelles er en lovlig division her: én dieselleverance dækker begge
        // afdelinger. Fordelingsnøglen for fælles omkostninger er udskudt.
        // ⚠ .read KRÆVER indkoeb.laes — BESLUTNING 104.
        // Otte Procure-noder deler den: hvad vi betaler, og hvilke vilkaar
        // vi har hos hvem. Alle roller undtagen chaufføren har den.
        "indkoeb": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true) && auth.token.perms != null && auth.token.perms.contains('|indkoeb.laes|')",
          ".indexOn": ["dato", "leverandoerId", "fakturastatus"],
          "$indkoebId": {
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|indkoeb.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true) && newData.exists()",
            ".validate": "newData.hasChildren(['dato', 'leverandoerId', 'vare', 'antal', 'prisPrEnhedOere', 'fakturastatus'])",
            "division": { ".validate": false },

            // ⚠ NODEN VALIDEREDE KUN division. En pris kunne komme ind som
            // FLOAT — 18.5 i stedet for 1850 — og beslutning 2 stod dermed
            // kun i en kommentar. Det er den fejl der ender som 1849,999 i en
            // sum over hundrede linjer, og saa gaar afstemningen mod
            // leverandoerens faktura ikke op med en oere ingen kan forklare.
            //
            // ⚠ HELE OERE. isNumber() alene raekker ikke: 1850.5 er ogsaa et
            // tal. Loftet paa 10 mia. oere (100 mio. kr) er ikke en
            // forretningsregel — det fanger en tastefejl med tre nuller for
            // meget, og et beloeb over det er noget nogen skal se paa.
            "prisPrEnhedOere": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0 && newData.val() <= 10000000000"
            },
            // ⚠ LINJENS BELOEB GEMMES IKKE. Det beregnes af antal x pris —
            // to kilder til samme tal kan drive fra hinanden, og saa mangler
            // en post uden at totalen afsloerer det.
            "beloebOere": { ".validate": false },

            "antal": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "enhed": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "vare": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "varenummer": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "dato": { ".validate": "newData.isNumber()" },
            "aftaltLeveringMs": { ".validate": "newData.isNumber()" },
            "leveretMs": { ".validate": "newData.isNumber()" },

            // ⚠ LEVERANDOEREN ER EN ENTITET, ikke en fritekststreng. Feltet
            // har hele tiden vaeret indekseret; noden fandtes bare ikke.
            // Imens stod navnene i tre demo-filer med hver sin stavemaade.
            //
            // Nu FINDES den, og opslaget er derfor et rigtigt opslag. Det er
            // ikke en formalitet: uden det kan en indkoebslinje pege paa et
            // leverandoer-id der aldrig har eksisteret, og saa staar der en
            // tom celle i tabellen som ingen kan spore. Samme tjek staar paa
            // fakturaer.leverandoerId — de to blev strammet SAMMEN, som
            // noterne begge steder lovede.
            "leverandoerId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('leverandoerer').child(newData.val()).exists()" },
            "kategori": { ".validate": "newData.isString() && newData.val().matches(/^(vaerksted|reservedele|daek|braendstof|facility|kontor|transport)$/)" },
            "fakturastatus": { ".validate": "newData.isString() && newData.val().matches(/^(mangler|modtaget|godkendt|bogfoert|afvist)$/)" },

            // ══════════════════════════════════════════════════════════
            // KONTANTKOEB (beslutning 83) — IKKE EN NODE VED SIDEN AF.
            //
            // Et kontant koeb ER en indkoebslinje: "indkoeb" er det vi HAR
            // koebt, en registrering bagud, og et kontantkoeb er noejagtig
            // det — bare betalt paa en anden maade. En egen node ville vaere
            // den samme kendsgerning to steder: leverandoerernes noegletal,
            // varelageret og hvert beloeb i modulet skulle huske at laegge
            // de to sammen, og de ville ikke.
            //
            // ⚠ BETALINGSFORMEN ER ET FELT, IKKE EN STATUS. fakturastatus
            // svarer paa "har vi faaet regningen"; det her svarer paa
            // "hvordan betalte vi". Laa "kontant" i fakturastatus, ville
            // koebet staa som en linje der mangler sin faktura for evigt.
            "betalingsform": { ".validate": "newData.isString() && newData.val().matches(/^(faktura|kontant)$/)" },
            // ⚠ HVEM DER LAGDE UD — et uid, fordi det er hvem der GJORDE
            // noget. Og det er IKKE oprettetAf: en kontorassistent taster en
            // kollegas bon, og pengene skal til kollegaen.
            "udlaegAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
            // Kvitteringen. Feltet findes, fillagringen goer ikke endnu —
            // manglen TAELLES af kontantUdenBilag() frem for at spaerre.
            "bilagId": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "oprettetAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "oprettetMs": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 250" },

            // Leverandoerens eget nummer — det man slaar op i naar man ringer,
            // og det der staar paa fakturaen der skal matches. Vores id duer
            // ikke til nogen af delene; leverandoeren kender det ikke.
            "reference": { ".validate": "newData.isString() && newData.val().length <= 60" },

            // ⚠ SPORET TILBAGE TIL VAERKSTEDSBESOEGET. Uden feltet kan
            // Vaerkstedskalenderen ikke vise sine egne omkostninger uden sit
            // EGET datasaet — og det var praecis den kopi der fandtes:
            // demo-vaerksted.js havde en DEMO_INDKOEB ved siden af den her
            // node, med fire poster den anden aldrig saa.
            "besoegId": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "formaal": { ".validate": "newData.isString() && newData.val().length <= 200" },

            "koeretoejId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('koeretoejer').child(newData.val()).exists()" },
            "lokationId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('lokationer').child(newData.val()).exists()" },

            "godkendtAf": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "godkendtMs": { ".validate": "newData.isNumber()" },

            // ⚠ MOMS ER ET SEPARAT FELT, og beloeb er ALTID ekskl. Bland dem
            // ikke — ellers laegges inkl.-tal sammen med ekskl.-tal i en
            // rapport, og ingen opdager det foer regnskabet ikke stemmer.
            "momsOere": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
            }
          }
        },

        // Bogførte poster slettes ALDRIG. Kun slettet: true med spor.
        // ⚠ SKIVE 4A — LÆSE-PERMISSIONEN DER MANGLEDE, ER NU fakturaer.laes.
        // De ti oevrige kommercielle noder havde laenge en (grundlag.laes,
        // satser.laes, indkoeb.laes). Fakturaer havde ikke: den roertes af
        // Procures Fakturaer OG Oekonomis Fakturacenter, og en permission
        // der hedder indkoeb.laes ville laase den ene skaerm bag det andet
        // moduls navn — samme fejl som en modulklausul her, eet lag hoejere
        // oppe. Loesningen var en permission der daekker BEGGE forbrugere,
        // ikke ingen permission. Den staar paa listen i
        // test/laeseadgang.test.mjs med netop den grund.
        "fakturaer": {
          // ⚠ INGEN MODULKLAUSUL — OG DET ER BESLUTTET, IKKE GLEMT.
          // Naboen "indkoeb" har en; her saa fravaeret ud som en forglemmelse,
          // og jeg satte den paa. To proever i rules.moduler.test.mjs blev
          // roede: fakturaer er en af de TRE TVETYDIGE NODER der staar i
          // basen, fordi den roeres af to skaerme — en klausul paa det ene
          // modul ville spaerre det andet. Samme grund som opgaver og satser.
          // Vil du gate den, skal den anden forbruger findes foerst.
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|fakturaer.laes|')",
          ".write": false,

          // ⚠ INDEKSET PEGEDE PAA ET FELT DER IKKE FINDES.
          // Der stod "godkendelsesstatus"; posterne har "status". Et indeks paa
          // et felt ingen post baerer, fejler ikke — RTDB henter hele noden ned
          // og filtrerer i klienten med en advarsel i konsollen. Samme fejl som
          // opgaver."dato". Feltnavnet stod ogsaa afskrevet i leverandoerer.js.
          // ⚠ destinationId KOM MED FORDI fakturamatch SPOERGER PAA DEN.
          // `orderByChild("ordreId")` uden indeks FEJLER IKKE — RTDB henter
          // hele noden ned og filtrerer i klienten med en advarsel i
          // konsollen. Det er noejagtig den fejl der stod her foer, hvor
          // indekset pegede paa "godkendelsesstatus", et felt ingen post bar.
          ".indexOn": ["fakturadatoMs", "leverandoerId", "status", "destinationId", "destinationArt"],

          "$fakturaId": {
            // Noden er .write: false, saa det her er ikke en spaerring mod en
            // klient — den kommer aldrig hertil. Det er formen den Cloud
            // Function der skriver fakturaen, skal skrive. Uden den ville
            // serveren vaere det eneste sted formen stod, og admin-SDK'et gaar
            // uden om reglerne: en fejl ville ligge i basen, ikke blive afvist.
            ".validate": "newData.hasChildren(['leverandoerId', 'fakturanummer', 'fakturadatoMs', 'status', 'beloebOere'])",

            // ⚠ HER STOD "INGEN EKSISTENSTJEK — ENDNU", fordi leverandoerer/
            // ikke fandtes i denne fil. Nu goer den, og tjekket er sat — samme
            // dag som naboen indkoeb.leverandoerId, som noten lovede.
            "leverandoerId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('leverandoerer').child(newData.val()).exists()" },
            "fakturanummer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "fakturadatoMs": { ".validate": "newData.isNumber()" },
            "forfaldMs": { ".validate": "newData.isNumber()" },

            // ⚠ IKKE SAMME ORDLISTE SOM indkoeb.fakturastatus. Der findes
            // "mangler" — en LINJE kan mangle sin faktura. En FAKTURA der
            // mangler, findes ikke; posten ville vaere paastanden om sit eget
            // fravaer. Samme ord i to noder med hver sin betydning er den fejl
            // beslutning 11 og 14 handler om.
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(modtaget|godkendt|bogfoert|afvist)$/)" },

            // Oere som integer, ekskl. moms; momsen er sit eget felt.
            "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() <= 10000000000" },
            "momsOere": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },

            // ⚠ EN HAENGENDE REFERENCE ER VAERRE END INGEN. Feltet maa vaere
            // fravaerende (fakturaen er ikke afstemt endnu), men peger den, skal
            // den ramme. Demoen havde "ik-001" hvor alle linjer hedder il-XXX,
            // og saa taeller ikkeLinkedeFakturaer den som linket.
            // ⚠ DEN HER ER IKKE DESTINATIONEN. indkoebId er hvilken LINJE
            // fakturaen daekker — hvad vi MODTOG. destinationArt/-Id er hvor
            // fakturaen HOERER HEN. De to kan pege forskellige steder, og gør
            // de det, er det en oplysning: en faktura der daekker en linje vi
            // aldrig bestilte, skal ses.
            "indkoebId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('indkoeb').child(newData.val()).exists()" },

            // ══════════════════════════════════════════════════════════
            // MATCHET (beslutning 83, planche 1)
            //
            // ══════════════════════════════════════════════════════════
            // DESTINATIONEN (beslutning 86) — hvor fakturaen hoerer HEN
            //
            // ⚠ HER STOD "ordreId", OG DET VAR ÉT MODULS SVAR PAA ET FAELLES
            // SPOERGSMAAL. En faktura kan hoere til en Fleet-sag, en
            // Facility-sag, en Procure-ordre eller en lagervare — og med et
            // felt pr. modul ville de fire vaere fire steder at spoerge, og
            // "hvor hoerer den hen" et spoergsmaal uden ét svar.
            //
            // ⚠ TO FLADE FELTER OG IKKE ET OBJEKT. .indexOn kan kun pege paa
            // et DIREKTE barn, og fakturamatch skal kunne spoerge "er den her
            // ordre allerede taget". Et destination/{art,id} ville vaere
            // paenere og uindekserbart.
            //
            // ⚠ OG OMDOEBNINGEN VAR BILLIG NU OG DYR SENERE. Maalt i den
            // udrullede base foer en linje blev roert: 20 fakturaer i alt,
            // alle seedede. Samme argument som modulomdoebningerne — det sker
            // foer den foerste kunde krydser feltet af, eller slet ikke.
            //
            // ⚠ SIDEGEVINST: "ordreId" betoed i forvejen TO ting i basen — en
            // indkoebsordre her og en PLUKORDRE i Warehouse. Det navn holder
            // op med at vaere tvetydigt.
            //
            // ⚠ MATCHSCOREN GEMMES STADIG IKKE. Den regnes af posterne hos
            // forbrugeren; et gemt tal driver fra sit grundlag foerste gang
            // nogen retter et beloeb. Det der gemmes, er AFGOERELSEN.
            "destinationArt": { ".validate": "newData.isString() && newData.val().matches(/^(fleet|facility|procure|lager|ingen)$/)" },
            // ⚠ EN HAENGENDE REFERENCE ER VAERRE END INGEN — og hvad den skal
            // ramme, afhaenger af arten. Fleet og Facility peger begge paa
            // "opgaver": det er SAMME node med hver sin art (CLAUDE.md).
            "destinationId": { ".validate": "newData.isString() && newData.val().length > 0 && ( (newData.parent().child('destinationArt').val() === 'procure' && root.child('tenants').child($tenantId).child('indkoebsordrer').child(newData.val()).exists()) || ((newData.parent().child('destinationArt').val() === 'fleet' || newData.parent().child('destinationArt').val() === 'facility') && root.child('tenants').child($tenantId).child('opgaver').child(newData.val()).exists()) || (newData.parent().child('destinationArt').val() === 'lager' && root.child('tenants').child($tenantId).child('forbrugsvarer').child(newData.val()).exists()) )" },
            // ⚠ "INGEN DESTINATION" KRAEVER EN GRUND. Uden den staar fakturaen
            // som uafklaret uden at nogen kan se hvorfor, og den naeste
            // begynder forfra paa det samme opslag.
            "destinationGrund": { ".validate": "newData.isString() && newData.val().length <= 250" },
            // ⚠ KILDEN ER IKKE DESTINATIONEN. Planchen siger det selv:
            // "Invoice-mail er kun én kanal, ikke fundamentet."
            "kilde": { ".validate": "newData.isString() && newData.val().matches(/^(mail|upload|mobil|sag|registreret)$/)" },
            "matchetAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "matchetMs": { ".validate": "newData.isNumber()" },
            // ⚠ "INGEN AF FORSLAGENE PASSER" ER ET SVAR, ikke en tom tilstand.
            // Uden flaget staar fakturaen for evigt paa listen over dem der
            // mangler et match — og en liste der ikke kan toemmes, holder man
            // op med at kigge paa.
            "ikkeMatchbar": { ".validate": "newData.isBoolean()" },
            "ikkeMatchbarGrund": { ".validate": "newData.isString() && newData.val().length <= 250" },

            // Godkendelsen af selve fakturaen — beslutning 82's anden kontakt,
            // som nu HAR en vej ind.
            "godkendtAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "godkendtMs": { ".validate": "newData.isNumber()" },
            "afvistAf": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "afvistMs": { ".validate": "newData.isNumber()" },
            "begrundelse": { ".validate": "newData.isString() && newData.val().length <= 250" },
            "bogfoertMs": { ".validate": "newData.isNumber()" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 250" },
            "modtagetMs": { ".validate": "newData.isNumber()" },
            "reference": { ".validate": "newData.isString() && newData.val().length <= 60" },

            // Beslutning 20: kom fakturaen ind paa en sag, skal sporet vaere der.
            "sagsnummer": { ".validate": "newData.isString() && newData.val().length <= 40" },

            // Totalen gemmes ikke — den er beloeb + moms. Se fakturaTotalOere().
            "totalOere": { ".validate": false },
            "$andet": { ".validate": false }
          }
        },

        // aktiv er indekseret fordi Kunder & Priser henter kundebasen med
        // orderByChild('aktiv').equalTo(true) gennem useListe. Uden indekset
        // FEJLER forespørgslen ikke — RTDB henter hele noden ned og filtrerer
        // i klienten, med en advarsel i konsollen. Vokser basen ud over ét
        // hent, skal sidsteAktivitetMs med, så listen kan skifte til et
        // tidsvindue.
        // ══════════════════════════════════════════════════════════════
        // UNITBOOKING — udlejning af transportkasser
        // ══════════════════════════════════════════════════════════════
        //
        // ⚠ IKKE lagre, IKKE bookinger, IKKE kunder. De tre navne var
        // taget: lagre er reservedelslageret under Indkoeb, bookinger er en
        // TRANSPORTOPGAVE med etaper og koeretoej, og kunder er
        // kundekartoteket. To ting med samme navn er beslutning 11 og 14
        // om igen. Se unitbooking.js.
        //
        // ⚠ FIRE NODER, IKKE ÉT BLOB. Prototypen gemte alt i
        // lagerstyring/state. Det kan ikke beskyttes (alt eller intet), ikke
        // valideres, og to lagermaend der klargoer hver sin kasse i samme
        // minut ville overskrive hinanden UDEN en fejlmeddelelse.

        "kassetyper": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('unitbooking').val() === true)",
          "$typeId": {
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('unitbooking').val() === true) && auth.token.perms != null && auth.token.perms.contains('|kasser.skriv|') && newData.exists()",
            ".validate": "newData.hasChildren(['navn'])",
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "beskrivelse": { ".validate": "newData.isString() && newData.val().length <= 200" },
            // ⚠ UNDERTYPEN LIGGER UNDER SIN TYPE — IKKE I EN NODE VED SIDEN AF.
            // En undertype hoerer til praecis een type (Alukasse → Standard,
            // Stor, XL), og med en egen node med et typeId kunne de to drive:
            // en undertype ville kunne pege paa en type der var slettet, eller
            // to typer kunne komme til at dele en undertype med samme navn.
            // Nestet er koblingen STRUKTUREL og kan ikke brydes.
            //
            // ⚠ "Har undertype: ja/nej" fra planchen er IKKE et felt. En type
            // uden undertyper har bare ingen boern her — et flag ved siden af
            // listen ville vaere den samme kendsgerning to steder, og de to
            // ville blive uenige foerste gang nogen slettede den sidste.
            "undertyper": {
              "$underId": {
                ".validate": "newData.hasChildren(['navn'])",
                "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
                "$andet": { ".validate": false }
              }
            },
            "$andet": { ".validate": false }
          }
        },

        // ⚠ PLADSEN ER ET ID MED FELTER — navnet UDLEDES af pladsnavn().
        // Prototypen brugte selve strengen som noegle OG som visningsnavn,
        // og den stod to gange paa hver kasse: omdoebtes en hal, pegede hver
        // eneste kasse paa en plads der ikke fandtes. Samme rettelse som
        // steder.js lavede for hjemsted.
        "reolpladser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('unitbooking').val() === true || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["hal"],
          "$pladsId": {
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|reolpladser.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('unitbooking').val() === true || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true) && newData.exists()",
            ".validate": "newData.hasChildren(['hal', 'reol', 'fag', 'hylde', 'plads'])",
            "hal": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "reol": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10" },
            "fag": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10" },
            "hylde": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10" },
            "plads": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10" },
            // ⚠ INTET navn-FELT. Det udledes; et gemt navn ville drive fra
            // sine felter, og saa kunne ingen se hvilket der var rigtigt.
            "navn": { ".validate": false },
            // ⚠ DE FEM FELTER HERUNDER ER WAREHOUSES, OG DE ER VALGFRIE.
            // Noden blev UDVIDET frem for kopieret, fordi transportkasser og
            // kundegods staar paa de samme hylder. Var de paakraevede, gik
            // Unitbooking i stykker — en plads uden dem opfoerer sig
            // praecis som foer. Se WAREHOUSE.md punkt 3.3.
            "zone": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "type": { ".validate": "newData.isString() && newData.val().matches(/^(hylde|gulvplads|bulk)$/)" },
            // ⚠ karantaene BLOKERER en pluk, den advarer ikke. En vare paa en
            // plads i karantaene er under mistanke.
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|karantaene|lukket)$/)" },
            "temperatur": { ".validate": "newData.isNumber() && newData.val() >= -60 && newData.val() <= 80" },
            "$andet": { ".validate": false }
          }
        },

        "kasser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('unitbooking').val() === true)",
          ".indexOn": ["status", "type", "pladsId"],
          "$kasseId": {
            // ⚠ SIDSTE LED: EN KASSE FORSVINDER IKKE — DEN FAAR EN STATUS.
            // .validate koeres ikke ved en sletning, saa uden leddet kunne en
            // kasse med et udlaan bag sig fjernes helt, mens udlaanet blev
            // staaende og pegede paa ingenting. Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('unitbooking').val() === true) && auth.token.perms != null && auth.token.perms.contains('|kasser.skriv|') && newData.exists()",
            // ⚠ EN KASSE SLETTES ALDRIG. Der haenger udlaanshistorik paa
            // id'et; en kasse der gaar i stykker, faar status udeAfDrift.
            // Samme regel som en solgt bil (beslutning 18).
            ".validate": "newData.hasChildren(['type', 'status', 'hjemPladsId'])",
            "type": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kassetyper').child(newData.val()).exists()" },
            // ⚠ UNDERTYPEN SKAL HOERE TIL KASSENS EGEN TYPE. Uden det sidste
            // led kunne en alukasse faa en traekasses undertype, og filtret
            // "Alukasse + Stor" ville vise en kasse der hverken var det ene
            // eller det andet. newData.parent() er postens tilstand EFTER
            // skrivningen, saa leddet holder ogsaa naar kun undertypen rettes.
            //
            // ⚠ FELTET ER IKKE PAAKRAEVET. En type kan have nul undertyper
            // (planchens "Har undertype: nej"), og en kasse af den slags har
            // ingen. Et paakraevet felt ville tvinge en opfundet undertype
            // frem paa hver eneste kasse.
            "undertype": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kassetyper').child(newData.parent().child('type').val()).child('undertyper').child(newData.val()).exists()" },
            // ⚠ MAALENE, IKKE m² OG m³. Planchen har volumen som TO indtastede
            // felter pr. kasse; to tal tastet af et menneske om den samme
            // fysiske kasse kan blive uenige, og saa er "hvor stor er kassen"
            // et spoergsmaal med to svar. Maalene kan de ikke: 120x80x95 cm ER
            // 0,96 m² og 0,91 m³. maalFraMm() i volumen.js regner dem.
            //
            // Feltnavnene er de SAMME som paa `varer` og `carriers`, saa de tre
            // kan laeses af een funktion — kubikFraLinjer() goer det allerede.
            "laengdeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "breddeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "hoejdeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            // ⚠ KLIENTEN MAA KUN SAETTE ledig OG udeAfDrift. "booket" er
            // slet ikke en kassestatus mere — en reservation ER et udlaan, og
            // to steder til samme kendsgerning bliver uenige.
            // klargjort og udlaant er FOELGER af et udlaansskifte og saettes
            // af kasseudlaanskriv, som gaar uden om reglerne (admin-SDK).
            // Sidste led lader en uaendret status blive staaende, saa man kan
            // rette note eller type paa en kasse der er ude.
            // ⚠ SIDSTE LED ER IKKE PYNT: BAADE den gamle og den nye vaerdi
            // skal vaere klientens egne. Uden det matcher "ledig" ogsaa naar
            // kassen kommer FRA udlaant — og saa kan en kasse meldes hjem
            // uden om udlaanet, mens udlaanet stadig siger at museet har den.
            // Foerste led lader en uaendret status blive staaende, saa man kan
            // rette note eller type paa en kasse der er ude.
            // ⚠ SIDSTE LED: EN KASSE DER ER UDE AF DRIFT, SKAL HAVE EN DATO.
            // Kravet staar HER og ikke paa udeAfDriftFra, fordi en `.validate`
            // paa et felt der ikke skrives, aldrig koeres: skrev nogen bare
            // status: "udeAfDrift" uden datoen, ville feltets egen regel ikke
            // blive spurgt, og posten ville slippe igennem. Statussen skrives
            // altid, saa kravet skal staa dér.
            // newData.parent() er postens tilstand EFTER skrivningen — samme
            // greb som paa undertypen og paa kasseudlaanets klargoerSenest.
            "status": { ".validate": "newData.isString() && (newData.val() === data.val() || (newData.val().matches(/^(ledig|udeAfDrift)$/) && (!data.exists() || data.val().matches(/^(ledig|udeAfDrift)$/)))) && (newData.val() !== 'udeAfDrift' || newData.parent().child('udeAfDriftFra').isNumber())" },
            "hjemPladsId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('reolpladser').child(newData.val()).exists()" },
            // Den nuvaerende plads. ⚠ FRAVAERENDE naar kassen er udlaant —
            // en kasse hos kunden optager ikke en hylde. Prototypen skrev
            // "Udlaant hos kunde" SOM PLADS, og saa kunne ledige pladser
            // ikke taelles.
            // ⚠ SIDSTE LED STOD KUN I valideKasse(). En kontrol der kun
            // findes i frontend, er ikke adgangskontrol — den blev fundet af
            // en proeve i etape 4, to etaper efter den blev skrevet.
            "pladsId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('reolpladser').child(newData.val()).exists() && newData.parent().child('status').val() !== 'udlaant'" },
            // ⚠ HVORNAAR GIK DEN I STYKKER. Uden datoen kan kalenderen ikke
            // tegne "ude af drift" som andet end et flag: planchen har den som
            // en BLOK paa kassens raekke, og en blok kraever et startpunkt.
            //
            // ⚠ PAAKRAEVET NAAR STATUS ER udeAfDrift, og kun dér. Krydsfeltet
            // staar paa STATUS frem for her, fordi en `.validate` paa et felt
            // der ikke skrives, aldrig koeres — en post hvor feltet manglede,
            // ville slippe igennem. Samme greb som pladsId-leddet ovenfor, hvor
            // sidste led stod KUN i valideKasse() og blev fundet to etaper
            // senere af en proeve.
            //
            // ⚠ OG DEN AENDRER IKKE HVAD DER ER LEDIGT. `ledigeKasser()` og
            // `kasseudlaanskriv` afviser paa status NU, ikke paa en periode —
            // og det bliver staaende. En forventet reparationsdato er en
            // FORVENTNING, og at love en kasse vaek paa den er at love et
            // museum en kasse der maaske stadig er i stykker. Datoen er
            // dokumentation, ikke en planlaegningsnoegle. Se UNITBOOKING 6.24.
            "udeAfDriftFra": { ".validate": "newData.isNumber()" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "$andet": { ".validate": false }
          }
        },

        // ⚠ IKKE EN BOOKING. Et kasseudlaan har en periode og en kasse; en
        // booking har etaper, koeretoej og chauffoer. At slaa dem sammen
        // ville vaere beslutning 16 om igen.
        "kasseudlaan": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('unitbooking').val() === true)",
          ".indexOn": ["kasseId", "sagsnummer", "tilstand", "fra"],
          "$udlaanId": {
            // ⚠ KUN SERVEREN. Et udlaan aendrer TO poster — udlaanet og
            // kassen — og de skal skrives sammen eller slet ikke. Dertil skal
            // perioden proeves mod de eksisterende udlaan, og to lagermaend
            // kan ramme samme sekund. Et konflikttjek i skaermen kan gaas
            // uden om med en direkte skrivning; derfor ligger det i
            // kasseudlaanskriv. Samme grund som reservationer.
            //
            // .validate herunder er formen serveren skal overholde. Den
            // haandhaeves ikke paa admin-SDK'et — det goer valideUdlaan() i
            // functions/delt/unitbooking.js, som er DEN SAMME fil klienten
            // proever mod.
            ".write": false,
            ".validate": "newData.hasChildren(['kasseId', 'sagsnummer', 'fra', 'til', 'tilstand'])",
            "kasseId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kasser').child(newData.val()).exists()" },
            // ⚠ DEN ENESTE NOEGLE UD AF SYSTEMET. Uden sagsnummer kan en
            // kasse ikke findes igen naar museet ringer.
            "sagsnummer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            "beskrivelse": { ".validate": "newData.isString() && newData.val().length <= 300" },
            // ⚠ TIDSPUNKTER SOM TAL. Samme grund som alle andre Ms-felter:
            // de kan sorteres, sammenlignes og regnes paa uden tidszone.
            "fra": { ".validate": "newData.isNumber()" },
            "til": { ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('fra').val()" },
            // ⚠ PLANCHENS TREDJE DATO — hvornaar kassen SENEST skal vaere
            // pakket. Uden den kan "Klargoeres snart (48 t)" ikke regnes: det
            // taeller dem der SKAL klargoeres inden for to doegn, og modellen
            // vidste ikke hvornaar.
            //
            // ⚠ VALGFRI, OG DET ER EN BESLUTNING. De udlaan der allerede
            // ligger i basen, har den ikke — et paakraevet felt ville goere
            // hver eneste af dem ugyldig efter reglerne. Uden datoen falder
            // udlaanet bare uden for taellingen, og noegletallet siger selv
            // hvor mange der ikke har den. Samme holdning som faktiskMin paa
            // opgaver: hullet TAELLES frem for at spaerre.
            //
            // ⚠ OG DEN KAN IKKE LIGGE EFTER AFHENTNINGEN. Man pakker foer
            // kassen koerer. newData.parent() er postens tilstand EFTER
            // skrivningen, saa reglen holder ogsaa ved en dyb skrivning af
            // kun det her felt — samme greb som paa `til`.
            "klargoerSenest": { ".validate": "newData.isNumber() && newData.val() <= newData.parent().child('fra').val()" },
            "tilstand": { ".validate": "newData.isString() && newData.val().matches(/^(booket|klargjort|udlaant|returneret|annulleret)$/)" },
            // ⚠ uid, IKKE personId. Det er hvem der GJORDE noget.
            "oprettetAf": { ".validate": "newData.isString()" },
            "oprettetMs": { ".validate": "newData.isNumber()" },
            // ⚠ HVORNAAR DET FAKTISK SKETE, ikke hvornaar det var planlagt.
            // fra/til er AFTALEN; de to her er kendsgerningen. Uden dem kan
            // historikken kun sige hvad der var meningen — og "MDT-101 har
            // vaeret ude 126 dage" ville vaere en paastand vi ikke kan staa
            // inde for, hvis kassen kom hjem i forvejen. Saettes af
            // kasseudlaanskriv i selve tilstandsskiftet.
            "udleveretMs": { ".validate": "newData.isNumber()" },
            "returneretMs": { ".validate": "newData.isNumber()" },
            // Den oprindelige fritekst fra prototypens Excel-import. Den
            // bevares saa intet gaar tabt, men der soeges ikke i den.
            "importtekst": { ".validate": "newData.isString() && newData.val().length <= 400" },
            "$andet": { ".validate": false }
          }
        },

        // ══ WAREHOUSE (WMS) — lagerhotel. Kundens gods. ══
        //
        // ⚠ IKKE `lagre`. Den node er reservedelslageret under Indkoeb —
        // VORES egne dele, hvor forbruget er en omkostning paa en bil. Her
        // er varen KUNDENS, og bevaegelsen er en indtaegt. To forskellige
        // ting, og derfor to noder frem for een med et flag.
        "varer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["kundeId", "varenummer", "varegruppe"],
          "$vareId": {
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|varer.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true) && newData.exists()",
            ".validate": "newData.hasChildren(['kundeId', 'varenummer', 'navn', 'enhed', 'sporing'])",
            // ⚠ VAREN ER KUNDENS. Uden en gyldig kunde kan bevaegelsen ikke
            // afregnes, og saa er varen paa lageret uden en modpart.
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            "varenummer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "enhed": { ".validate": "newData.isString() && newData.val().matches(/^(stk|kolli|palle|kasse|kg|m3)$/)" },
            // ⚠ SPORINGEN KAN IKKE LAVES OM BAGUD. Faar en vare batch et aar
            // senere, findes der bevaegelser uden — og saa kan et tilbagekald
            // ikke svare paa hvilke kolli der var i partiet.
            "sporing": { ".validate": "newData.isString() && newData.val().matches(/^(ingen|batch|serie)$/)" },
            "varegruppe": { ".validate": "newData.isString() && newData.val().length <= 60" },
            // Millimeter og gram som INTEGER — samme regel som
            // samletLaengdeMm() i flaade.js. En float ved en volumengraense
            // er en fejl der venter, og volumenkalkulatoren regner paa dem.
            "laengdeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "breddeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "hoejdeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "vaegtG": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "minimum": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "aktiv": { ".validate": "newData.isBoolean()" },
            "$andet": { ".validate": false }
          }
        },

        // CARRIEREN — beholderen kundens gods staar i.
        //
        // ⚠ DET ER `kasser` EN GANG TIL, OG SVARET BLEV ALLIGEVEL TO NODER.
        // Fysisk er en carrier og en transportkasse den samme ting, men de
        // baerer hver sin forretning: kassen udlejes pr. sag med sin egen
        // tilstandsmaskine (beslutning 37), carrieren baerer KUNDENS gods og
        // har ejerforhold og indhold. Se WAREHOUSE.md punkt 6.2.
        //
        // ⚠ PRISEN: begge staar paa de SAMME reolpladser. "Er hylden
        // optaget?" har derfor to kilder og besvares eet sted —
        // belaegningPaaPlads() i reolplads.js. Reglerne her holder den ene
        // halvdel af invarianten: en carrier der ikke staar paa lageret, har
        // ingen pladsId.
        //
        // ⚠ PERMISSIONEN ER carriers.skriv OG IKKE kasser.skriv. En
        // WMS-medarbejder hos en kunde uden Unitbooking skal kunne oprette
        // en beholder — samme faelde som reolpladser.skriv lukkede.
        "carriers": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["status", "pladsId", "kundeId", "etapeId"],
          "$carrierId": {
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|carriers.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true) && newData.exists()",
            // ⚠ EN CARRIER SLETTES ALDRIG. Bevaegelseshistorikken haenger paa
            // id'et, og et id der forsvinder, goer historikken uforklarlig.
            // En egen beholder der gaar i stykker, faar udeAfDrift; en
            // engangs der er brugt, faar opbrugt.
            //
            // De to KRYDSFELT-regler staar HER og ikke paa felterne, fordi de
            // skal gaelde uanset hvilket enkeltfelt der skrives. En .validate
            // paa en forfader koerer ogsaa ved en dyb skrivning — det er
            // proevet, se test/rules.kundepriser.test.mjs.
            //
            //  1. Kun en ENGANGS kan vaere opbrugt. En egen kommer retur.
            //  2. En carrier der ikke staar paa lageret, optager INGEN hylde.
            //     Praecis samme regel som en udlaant kasse, og den findes af
            //     samme grund: prototypen skrev "Udlaant hos kunde" SOM
            //     plads, og saa kunne ledige pladser ikke taelles.
            ".validate": "newData.hasChildren(['type', 'ejerforhold', 'status']) && (newData.child('status').val() !== 'opbrugt' || newData.child('ejerforhold').val() === 'engang') && (!newData.hasChild('pladsId') || newData.child('status').val().matches(/^(paaLager|udeAfDrift)$/))",
            "type": { ".validate": "newData.isString() && newData.val().matches(/^(pallekasse|gitterbur|plastkasse|kartonkasse|traekasse)$/)" },
            "ejerforhold": { ".validate": "newData.isString() && newData.val().matches(/^(ejet|engang)$/)" },
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(paaLager|iTransit|udeAfDrift|opbrugt)$/)" },
            // ⚠ FRAVAERENDE ER EN RIGTIG TILSTAND. En carrier der er scannet
            // ind men endnu ikke placeret, staar uden plads — det er de
            // elleve "uden lokation" paa planchen, og noegletallet findes
            // netop for at jage dem. Derfor er feltet ikke paakraevet.
            "pladsId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('reolpladser').child(newData.val()).exists()" },
            // Kundens faste omraade. Godset er KUNDENS (punkt 3.1), og en
            // beholder der peger paa en kunde der ikke findes, kan ikke
            // afregnes.
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            // ⚠ EN TRANSPORT ER EN ETAPE — BESLUTNING 46. Feltet hed
            // transportId og stod UDEN eksistenskontrol, fordi det ikke var
            // afgjort om en transport var en etape eller et nyt objekt
            // (WAREHOUSE.md punkt 6.4). Nu er det afgjort, og saa er baade
            // navnet og fremmednoeglen en del af svaret: et felt der hedder
            // transportId og peger paa etaper, er et navn der lyver om sin
            // node — og det er praecis den fejl CLAUDE.md kalder "et feltnavn
            // uden at holde det op mod noden".
            //
            // ⚠ ETAPER ER SPAERRET AF BOOKING-MODULET, carriers af warehouse.
            // En kunde uden Booking har ingen etaper, og kan derfor ikke saette
            // feltet overhovedet. Det er rigtigt: uden bookinger er der ingen
            // transport at knytte beholderen til. Labelen siger det samme —
            // byggLabel() spaerrer trykket frem for at gaette et slutmaal.
            "etapeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('etaper').child(newData.val()).exists()" },
            // Millimeter som INTEGER — samme regel som varens maal.
            "laengdeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "breddeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "hoejdeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },

            // ⚠ MAERKATETS FELTER — WAREHOUSE.md etape 16.
            //
            // Kolli er IKKE varelinjer. `beholdning` siger hvor meget af hvilke
            // VARER der ligger i beholderen; kolli siger hvor mange PAKKER en
            // lagermand kan taelle paa gulvet. Otte flyttekasser med toej i er
            // otte kolli og kan vaere een varelinje. De to kan ikke udledes af
            // hinanden, og et gaet paa maerkatet ville blive taelt ved
            // modtagelsen.
            "kolli": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            // "8 kolli + 1 stk." — det loese der ikke er pakket i noget.
            "loesEnheder": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            // ⚠ GRAM SOM INTEGER, som millimeter og oere. Et komma i en vaegt
            // er samme fejl som et komma i et beloeb: 74,5 kg bliver til 74 kg
            // eller 745 kg afhaengigt af hvem der laeser.
            "vaegtGram": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            // Godsbeskrivelsen paa maerkatet. Fri tekst, fordi det ER fri
            // tekst: "Flyttekasser med personlige ejendele" kan ikke laves om
            // til et katalog uden at tabe det den siger.
            "godsbeskrivelse": { ".validate": "newData.isString() && newData.val().length <= 600" },
            // ⚠ HAANDTERINGSMAERKER ER EN ALLOWLISTE, ikke fri tekst. Et
            // maerke der ikke findes, ville blive trykt som et tomt felt paa
            // pallen — og et haandteringsmaerke ingen forstaar, er vaerre end
            // ingen. `temperatur` betyder temperaturfoelsomt gods; den
            // konkrete graense hoerer i godsbeskrivelsen, indtil der er et
            // felt til den.
            "haandtering": {
              "$maerke": {
                ".validate": "newData.isBoolean() && $maerke.matches(/^(fragile|denneSideOp|holdToer|gaffeltruck|temperatur)$/)"
              }
            },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "oprettetMs": { ".validate": "newData.isNumber()" },
            "oprettetAf": { ".validate": "newData.isString()" },
            "$andet": { ".validate": false }
          }
        },

        // ⚠ KUN SERVEREN. En bevaegelse aendrer TO ting — bevaegelsen selv og
        // beholdningen paa en eller to pladser — og de skal skrives sammen
        // eller slet ikke. Skrives kun den ene, staar der varer paa en hylde
        // ingen har lagt der, eller de forsvinder uden spor.
        //
        // Dertil kan to lagermaend ramme samme sekund paa samme hylde. Et
        // laes-saa-skriv uden laas ville lade begge passere hver sin kontrol
        // og lande oven paa hinanden. Samme begrundelse som kasseudlaan.
        //
        // .validate herunder er FORMEN serveren skal overholde. Den
        // haandhaeves ikke paa admin-SDK'et — det goer valideBevaegelse() i
        // functions/delt/warehouse.js, som er DEN SAMME fil klienten
        // proever mod.
        "bevaegelser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["vareId", "kundeId", "tidspunktMs", "art", "reference", "carrierId"],
          "$bevaegelseId": {
            ".write": false,
            // ⚠ TO SLAGS BEVAEGELSER SIDEN ETAPE 12.
            //
            // En GODSBEVAEGELSE flytter varer mellem beholdere og har vare,
            // kunde og antal. En PLACERING (art putaway) flytter selve
            // beholderen hen paa en hylde og har hverken vare eller antal —
            // godset skifter ikke maengde af at blive baaret et andet sted
            // hen. Et antal paa en placering ville vaere et tal ingen kunne
            // forklare bagefter.
            ".validate": "newData.hasChildren(['art', 'tidspunktMs']) && ((newData.child('art').val() === 'putaway' && newData.hasChildren(['carrierId', 'tilPladsId']) && !newData.hasChild('vareId') && !newData.hasChild('antal')) || (newData.child('art').val() !== 'putaway' && newData.hasChildren(['vareId', 'kundeId', 'antal']) && !newData.hasChild('tilPladsId') && !newData.hasChild('fraPladsId')))",
            "art": { ".validate": "newData.isString() && newData.val().matches(/^(modtag|putaway|flyt|pluk|afsend|retur|optael|justering)$/)" },
            "vareId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('varer').child(newData.val()).exists()" },
            // ⚠ ET HISTORISK FAKTUM, IKKE ET OPSLAG. Hvem varen tilhoerte DA
            // den blev flyttet. Skifter varen ejer, maa sidste kvartals
            // fakturagrundlag ikke aendre sig med tilbagevirkende kraft.
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            // Maengden er skaleret med 1000, som ANTAL_SKALA i beloeb.js. En
            // anden skala her ville fakturere 1000x forkert paa den linje der
            // bandt de to sammen.
            "antal": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            // ⚠ GODSET FLYTTER MELLEM BEHOLDERE. Hylden er beholderens
            // adresse, ikke godsets — se beholdning-noden nedenfor.
            "fraCarrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "tilCarrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            // De to her hoerer KUN til en placering: hvilken beholder der blev
            // sat hvor. Krydsreglen ovenfor holder dem ude af en godsbevaegelse.
            "carrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "tilPladsId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('reolpladser').child(newData.val()).exists()" },
            "fraPladsId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('reolpladser').child(newData.val()).exists()" },
            // ⚠ INTET PUNKTUM. Batchen indgaar i en beholdningsnoegle, og
            // RTDB tillader hverken . # $ [ ] eller / i en noegle.
            "batch": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$/)" },
            "serienummer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "udloebMs": { ".validate": "newData.isNumber()" },
            "tidspunktMs": { ".validate": "newData.isNumber()" },
            // ⚠ uid, IKKE personId. Det er hvem der GJORDE noget.
            "oprettetAf": { ".validate": "newData.isString()" },
            "reference": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "$andet": { ".validate": false }
          }
        },

        // ⚠ SALDOEN. Noeglen er <pladsId>__<vareId>__<batch>, deterministisk,
        // saa den samme hylde og vare ALDRIG kan faa to poster. To poster for
        // samme hylde er DE-QR 777 mod DE-KL 404 igen, denne gang med et
        // lagertal.
        //
        // ⚠ DER FINDES INTET TOTALTAL PR. VARE. Det er en sum, hver gang.
        // Gemtes summen ved siden af, ville de to drive fra hinanden ved den
        // foerste skrivning der ramte den ene og ikke den anden — og saa er
        // det bemanding.ledig igen, med lagervaerdi paa.
        "beholdning": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["carrierId", "vareId", "batch"],
          "$noegle": {
            ".write": false,
            // ⚠ GODSET LIGGER I EN BEHOLDER, IKKE PAA EN HYLDE (etape 12).
            // Noeglen er <carrierId>__<vareId>__<batch>, og hylden er
            // carrierens adresse. Baerer posten OGSAA en pladsId, driver de to
            // fra hinanden foerste gang nogen flytter beholderen — og saa
            // viser hylden varer der fysisk staar et andet sted.
            ".validate": "newData.hasChildren(['carrierId', 'vareId', 'antal'])",
            "carrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "vareId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('varer').child(newData.val()).exists()" },
            "batch": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_][A-Za-z0-9_-]{0,39}$/)" },
            // ⚠ IKKE NEGATIV. En hylde kan ikke rumme minus tolv paller, og
            // en beholdning der kan gaa i minus, skjuler den bevaegelse der
            // manglede.
            "antal": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "senestMs": { ".validate": "newData.isNumber()" },
            "$andet": { ".validate": false }
          }
        },

        // ══ ENHEDEN — ét stykke gods med sit eget serienummer (etape 9) ══
        //
        // ⚠ NOEGLEN ER SERIENUMMERET SELV. Derfor gaelder samme tegnregel som
        // for batchen: hverken punktum, #, $, [, ] eller / — RTDB tillader dem
        // ikke i en noegle, og en skrivning ville fejle et helt andet sted end
        // der hvor fejlen blev lavet.
        //
        // ⚠ OG NODEN BAERER DEN SAMME KENDSGERNING SOM `beholdning`, bare pr.
        // enhed frem for som et tal. Det er bevidst valgt (WAREHOUSE.md 7), og
        // prisen betales tre steder: én atomisk skrivning i bevaegelseskriv,
        // antallet laast til én enhed pr. bevaegelse, og `enhedsafvigelse()`
        // der VISER en uenighed frem for at lade den staa. Derfor er .write
        // ogsaa false: to skrivere ville vaere to sandheder.
        "enheder": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["vareId", "kundeId", "carrierId", "tilstand"],
          "$serienummer": {
            ".write": false,
            ".validate": "newData.hasChildren(['vareId', 'kundeId', 'tilstand']) && $serienummer.matches(/^[A-Za-z0-9][A-Za-z0-9_-]{0,59}$/)",
            "vareId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('varer').child(newData.val()).exists()" },
            // ⚠ HISTORISK FAKTUM. Kunden skrives med, som paa bevaegelsen —
            // skifter varen ejer, maa sidste kvartals sporbarhedsudtraek ikke
            // pludselig pege paa en anden kunde.
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            "carrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "tilstand": { ".validate": "newData.isString() && newData.val().matches(/^(paaLager|afsendt)$/)" },
            "senestMs": { ".validate": "newData.isNumber()" },
            "$andet": { ".validate": false }
          }
        },

        // ══ PLUKORDREN — det udgaaende flow ══
        //
        // ⚠ DEN HEDDER plukordrer OG IKKE ordrer. `bookinger` er allerede en
        // ordre i dette hus: en transportopgave med etaper, koeretoej og
        // chauffoer. En plukordre siger hvad der skal UD AF LAGERET, ikke
        // hvem der koerer det hvorhen. En 3PL har begge dele.
        "plukordrer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["kundeId", "tilstand", "afgangMs", "prioritet"],
          "$ordreId": {
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|bevaegelser.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true) && newData.exists()",
            ".validate": "newData.hasChildren(['kundeId', 'nummer', 'tilstand', 'prioritet', 'afgangMs', 'afsendCarrierId', 'linjer'])",
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            "nummer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            // ⚠ KLIENTEN MAA IKKE SAETTE `afsendt`. En ordre bliver afsendt
            // fordi varerne FORLADER huset — altsaa fordi der skrives
            // afsendelsesbevaegelser. Kunne tilstanden saettes direkte, kunne
            // en ordre meldes afsendt uden at en palle var roert, og lageret
            // ville stadig staa med godset.
            //
            // Sidste led lader en UAENDRET tilstand blive staaende, saa man
            // kan rette en note paa en afsendt ordre. Samme greb som kassens
            // status i unitbooking.
            "tilstand": { ".validate": "newData.isString() && (newData.val() === data.val() || (newData.val().matches(/^(kladde|frigivet|annulleret)$/) && (!data.exists() || data.val().matches(/^(kladde|frigivet|annulleret)$/))))" },
            "prioritet": { ".validate": "newData.isString() && newData.val().matches(/^(lav|normal|hoej)$/)" },
            "afgangMs": { ".validate": "newData.isNumber()" },
            // ⚠ HVOR DET PLUKKEDE SKAL STAA. En pluk FLYTTER varen hen et
            // sted; uden pladsen ville godset ikke staa nogen steder mellem
            // hylden og bilen — og det er praecis dér det bliver vaek.
            // ⚠ EN BEHOLDER, IKKE EN PLADS. Det plukkede skal ligge i noget,
            // og efter etape 12 ligger alt gods i en beholder.
            "afsendCarrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "linjer": {
              "$linjeId": {
                ".validate": "newData.hasChildren(['vareId', 'antal'])",
                "vareId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('varer').child(newData.val()).exists()" },
                // Skaleret med 1000, som ANTAL_SKALA i beloeb.js.
                "antal": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0" },
                "$andet": { ".validate": false }
              }
            },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "oprettetAf": { ".validate": "newData.isString()" },
            "oprettetMs": { ".validate": "newData.isNumber()" },
            "afsendtMs": { ".validate": "newData.isNumber()" },
            "$andet": { ".validate": false }
          }
        },

        // ══ OPTAELLINGEN — beviset for at beholdningen passer ══
        //
        // ⚠ KUN SERVEREN. Forventningen skal laeses af DATABASEN i det
        // oejeblik der taelles; sendte klienten den med, ville afvigelsen
        // vaere forskellen mellem hvad brugeren TROEDE der stod og hvad han
        // talte — og saa maaler den ingenting.
        //
        // ⚠ OG POSTEN KAN IKKE RETTES BAGEFTER. En optaelling er en maaling,
        // ikke en holdning. Kunne afvigelsen redigeres, ville optaellingen
        // vaere vejen til at SKJULE et svind frem for vejen til at finde det.
        "optaellinger": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["carrierId", "vareId", "tidspunktMs", "aarsag"],
          "$optaellingId": {
            ".write": false,
            // ⚠ DER TAELLES I EN BEHOLDER, IKKE PAA EN HYLDE (etape 12). En
            // optaelling af hylden ville skulle summere alt hvad der stod paa
            // den, og saa kunne en afvigelse ikke henfoeres til den beholder
            // hvor den opstod.
            ".validate": "newData.hasChildren(['carrierId', 'vareId', 'forventet', 'taeltAntal', 'afvigelse', 'tidspunktMs'])",
            "carrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "vareId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('varer').child(newData.val()).exists()" },
            "batch": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$/)" },
            // ⚠ forventet KAN vaere negativ. Er saldoen gaaet i minus, er det
            // netop dét optaellingen skal fange — og et tal der ikke kunne
            // vaere negativt, ville skjule den fejl der udloeste taellingen.
            "forventet": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
            "taeltAntal": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "afvigelse": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
            // Allowliste, ikke fritekst: \"svind\" og \"Svind?\" ville blive to
            // kategorier, og saa kan ingen se om det er samme problem.
            "aarsag": { ".validate": "newData.isString() && newData.val().matches(/^(svind|fejlpluk|fejlmodtagelse|skade|fundet|tastefejl|ukendt)$/)" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "bevaegelseId": { ".validate": "newData.isString()" },
            "tidspunktMs": { ".validate": "newData.isNumber()" },
            "oprettetAf": { ".validate": "newData.isString()" },
            "$andet": { ".validate": false }
          }
        },

        "kunder": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|kunder.laes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('kunder').val() === true)",
          ".indexOn": ["navn", "aftaleUdloeberMs", "aktiv"],
          "$kundeId": {
            // ⚠ HER STOD hasChildren(['division']) — OG DET VAR NODENS ENESTE KRAV.
            // Da feltet blev fjernet (beslutning 70), forsvandt AL validering paa en
            // kunde med det, og en post blev gyldig som et tomt objekt. Det blev MAALT:
            // proeven "en pris paa en kunde der ikke findes, afvises" faldt, fordi
            // kaskaden ned i satser/ ikke laengere havde noget at fejle paa.
            // 
            // ⚠ ET FELT DER FJERNES, KAN VAERE DET ENESTE DER HOLDT NODEN OPPE.
            // Reglen kraever nu `navn` — det ene en kunde altid har, og det der goer
            // forskel paa en rigtig post og et tastefejlet kundeId.
            ".validate": "newData.hasChildren(['navn'])",
            // ⚠ .write LIGGER HER OG IKKE PAA NODEN, OG SIDSTE LED ER
            // newData.exists(). Begge dele er noedvendige, og de stopper hver
            // sin ting: laa reglen paa noden, kunne ET kald tomme hele
            // registret — og uden leddet kunne en enkelt post hardslettes.
            // En post tages ud af drift med en STATUS, ikke ved at forsvinde.
            // Se beslutning 53.
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|kunder.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('kunder').val() === true) && newData.exists()",
                        "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" },
            "division": { ".validate": false },
            // ⚠ KUNDENS ADRESSE — WAREHOUSE.md etape 16. Den staar paa
            // transportlabelen under kundenavnet, og indtil nu fandtes den
            // slet ikke: kartoteket bar navn, aftale og oekonomi, men ingen
            // adresse. Byen staar HER (modsat etapens adresser), fordi en
            // kunde ikke har et fraSted ved siden af.
            "adresse": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "postnr": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 80" },
            // KUNDENS PRISAFVIGELSE — enten en egen pris eller en rabat paa
            // standardprisen. To lag, ikke tre: prisgruppen baerer ikke
            // laengere en pris. Se PRISER.md.
            //
            // ⚠ HVORFOR DEN HAR EN .validate PAA PERMISSIONEN:
            // .write kaskaderer, og `kunder` er skrivbar med kunder.skriv —
            // som casehandler, disponent og koordinator alle har gennem
            // BASIS_DATA. satser.skriv har KUN admin. Uden det her led ville
            // en pris kunne saettes af flere end standardprisen kan, alene
            // fordi den ligger i en anden sti. En .validate kan laese auth og
            // kan stramme dér hvor en .write ikke kan loesnes fra oven.
            //
            // ⚠ HULLET DER BLIVER TILBAGE: .validate koerer IKKE ved en
            // sletning. kunder.skriv alene kan derfor FJERNE en afvigelse,
            // men hverken saette eller aendre den. Det staar skrevet her frem
            // for at blive opdaget, og det er grunden til at der ikke findes
            // en sletteknap i klienten — som skriv.js ikke har en slet().
            //
            // ⚠ OG DEN ARVER $kundeId's EGEN .validate: en pris paa en kunde
            // der ikke findes, mangler `division` efter fletningen og afvises.
            "priser": {
              ".validate": "auth != null && auth.token.perms != null && auth.token.perms.contains('|satser.skriv|')",
              "$ydelseId": {
                "satser": {
                  ".indexOn": ["gyldigFra"],
                  "$satsId": {
                    // ⚠ ENTEN beloebOere ELLER rabatBps — ALDRIG BEGGE.
                    // To felter der begge kan saette prisen, er to svar paa
                    // samme spoergsmaal, og saa bliver det tilfaeldigt hvilket
                    // der vinder.
                    ".validate": "newData.hasChild('gyldigFra') && ((newData.hasChild('beloebOere') && !newData.hasChild('rabatBps')) || (!newData.hasChild('beloebOere') && newData.hasChild('rabatBps')))",
                    "gyldigFra": { ".validate": "newData.isNumber()" },
                    "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                    // Basispoint som i ejerkonsollen: 1500 = 15,00 %. Hele
                    // tal, saa der ikke kommer en afrundingsregel mere.
                    "rabatBps": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000" },
                    "metode": { ".validate": "newData.isString() && newData.val().length <= 40" },
                    "valuta": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}$/)" },
                    "aktiv": { ".validate": "newData.isBoolean()" },
                    "oprettetAf": { ".validate": "newData.isString()" },
                    "oprettetMs": { ".validate": "newData.isNumber()" },
                    "$andet": { ".validate": false }
                  }
                },
                "$andet": { ".validate": false }
              }
            }
          }
        }
      }
    },

    // AUDITLOG — append-only.
    //
    // Hvorfor den ligger her og IKKE under tenants/<id>/audit: RTDB's .read
    // kaskaderer og kan ikke indsnaevres paa et barn. Reglen paa
    // tenants/$tenantId giver laeseadgang til alt nedenunder, og en log over
    // hvem der har set hvad er selv foelsom — den afsloerer hvilke kunder der
    // bliver kigget paa, og af hvem. Som topniveau-node kan den faa sin egen
    // laeseregel. Flyt den ikke ind under tenants/ for at "rydde op".
    //
    // .write: false for ALLE, ogsaa admin. Skrivning sker kun gennem en Cloud
    // Function med Admin SDK, som gaar uden om reglerne. Der findes derfor
    // ingen audit.skriv-permission, og den maa ikke tilfoejes: kan en
    // kompromitteret admin-konto redigere sit eget spor, er loggen vaerdiloes.
    //
    // Stien er audit/<tenantId>/<klasse>/<aar>/<maaned>/<id>. Klassen ligger i
    // stien, fordi retention varierer pr. klasse — saa er sletning "fjern hele
    // partitionen" og ikke en scanning. Se RETENTION_MAANEDER i audit.js.
    "audit": {
      "$tenantId": {
        ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|audit.laes|')",
        ".write": false,
        "$klasse": {
          "$aar": {
            "$maaned": {
              ".indexOn": ["ms", "brugerUid", "objekt", "korrelationsId"]
            }
          }
        }
      }
    },

    // Opslag uid → tenant. Skrives kun server-side. Bruges til at sætte custom
    // claims, ikke til autorisation i sig selv.
    "brugerTenants": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // ══════════════════════════════════════════════════════════════════
    // UDBYDEREN — den ANDEN krydsning af tenant-graensen
    // ══════════════════════════════════════════════════════════════════
    //
    // ⚠ DEN FOERSTE VAR SUPPORT (beslutning 24), og den blev tilladt ÉN
    // gang med vilje: hver krydsning er et sted hvor en fejl giver én kunde
    // adgang til en andens. Den her er den anden, og den er derfor holdt saa
    // smal som muligt.
    //
    // ⚠ NODEN INDEHOLDER INGEN KUNDEDATA. Den er et INDEKS: hvilke tenants
    // findes, hvornaar blev de oprettet, er de aktive. Navnet og modulerne
    // staar i tenants/<id>/virksomhed og /moduler — ét sted, ikke kopieret
    // herind. En kopi ville drive, og udbyderen ville se et andet navn end
    // kunden selv.
    //
    // ⚠ KUN LAESNING. Skrivning sker med Admin SDK gennem provisioneren
    // eller en udbyderfunktion. Et udbyder-claim i en browser kan ikke
    // oprette en kunde — og kan derfor heller ikke oprette sig selv adgang.
    //
    // ⚠ INGEN KUNDEROLLE MAA NOGENSINDE HAVE udbyder-claim'et. Der er en
    // proeve der fastholder at et claim uden det ikke naar noget her, og at
    // et claim MED det ikke naar kundedata. Se rules.udbyder.test.mjs.
    "udbyder": {
      // ══════════════════════════════════════════════════════════════
      // PRISLISTEN — versioneret, aldrig rettet
      // ══════════════════════════════════════════════════════════════
      //
      // ⚠ EN NY PRIS ER EN NY POST. Samme idiom som `gyldigFra` paa en
      // sats: rettede vi en liste, kunne en faktura fra marts ikke
      // genskabes efter en prisstigning i april. Noeglen er et push-id og
      // ikke "2026-01" — et navn nogen selv har skrevet, inviterer til at
      // blive genbrugt.
      //
      // ⚠ MEN VERSIONERINGEN ER IKKE DET DER BESKYTTER MARTS-FAKTURAEN.
      // Det goer FRYSNINGEN: et genereret grundlag gemmer sine egne satser
      // og regner aldrig igen. De to forveksles, og saa bygger man den ene
      // og tror man har den anden.
      //
      // ⚠ MOMSSATSEN STAAR PAA LISTEN OG GAETTES IKKE. Ikke 25, ikke 0 —
      // se validerLinje() i grundlag.js. Uden den kan der ikke eksporteres.
      // ══════════════════════════════════════════════════════════════
      // FAKTURAGRUNDLAGET — frosset, og derfor uskriveligt
      // ══════════════════════════════════════════════════════════════
      //
      // ⚠ ET GRUNDLAG ER ET DOKUMENT, IKKE EN BEREGNING. Genberegnede vi
      // det hver gang skaermen blev aabnet, ville et gammelt grundlag
      // aendre sig naar prislisten eller rabatten aendrede sig — og en
      // faktura fra marts ville faa nye tal i april.
      //
      // ⚠ .write: false OG INGEN VEJ TIL AT RETTE. En rettelse er et NYT
      // grundlag der henviser til det gamle — som erstat() i grundlag.js.
      //
      // ⚠ DEN HER REGEL LAA ÉT DOEGN I facility/sensorer/$zoneId, fordi et
      // anker matchede som UNDERSTRENG. Den gav ingen adgang — en .read
      // gaelder kun ved og under sin egen sti, og den sti findes ikke — men
      // grundlaget kunne ikke laeses, og skaermen viste "ingen prisliste".
      "fakturagrundlag": {
        ".read": "auth != null && auth.token.udbyder === true",
        ".write": false,
        "$periode": {
          "$kundeId": {
            ".validate": "newData.hasChildren(['periode', 'kundeId', 'laast', 'beloebOere'])",
            "laast": { ".validate": "newData.isBoolean() && newData.val() === true" },
            "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
            "momsOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
            "ialtOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" }
          }
        }
      },

      "prisliste": {
        ".read": "auth != null && auth.token.udbyder === true",
        ".write": false,
        ".indexOn": ["gyldigFraMs"],
        "$listeId": {
          ".validate": "newData.hasChildren(['gyldigFraMs', 'momssats'])",
          "gyldigFraMs": { ".validate": "newData.isNumber()" },
          "momssats": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "oprettetAf": { ".validate": "newData.isString()" },
          "oprettetMs": { ".validate": "newData.isNumber()" },

          // ══════════════════════════════════════════════════════════
          // PLATFORMSADGANGEN — en egen prislinje, ikke dashboard-modulet
          // ══════════════════════════════════════════════════════════
          //
          // ⚠ IKKE `dashboard`. Det modul er en SKAERMSEKTION i sidebaren.
          // Bruges samme id ogsaa som prislinje, er det én ting med to
          // betydninger — og linjen skulle hedde 'Platformsadgang' paa
          // fakturaen og 'Dashboard' i menuen.
          //
          // ⚠ INGEN BRUGERPRIS HER. Den saettes pr. modul; stod den ogsaa
          // her, var der to steder at rette den.
          //
          // ⚠ FRIMAENGDEN HOERER TIL ABONNEMENTET. En bruger er ét login hos
          // kunden, ikke ét pr. modul: laa den paa modulet, ville en kunde
          // med fire moduler à '3 inkluderet' have TOLV gratis brugere.
          "platform": {
            "basisOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "prBrugerOere": { ".validate": false },
            // ⚠ ET HELT ANTAL. En halv inkluderet bruger findes ikke.
            "inkluderetBrugere": {
              "chauffoer": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "desktop": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "$andet": { ".validate": false }
            },
            "$andet": { ".validate": false }
          },
          "moduler": {
            "$modul": {
              // ⚠ OERE SOM INTEGER. Ikke kroner, ikke float — beslutning 2,
              // og den gaelder ogsaa naar det er OS der sender regningen.
              "basisOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "prKoeretoejOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              // ⚠ PRISEN PR. BRUGER STAAR PAA MODULET. Fakturaen faar ÉN
              // linje pr. modul OG art, saa hver linje stadig har én
              // stk.pris. FRIMAENGDEN ligger derimod paa platformen — se
              // dér om hvorfor.
              "prBrugerOere": {
                "chauffoer": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "desktop": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "$andet": { ".validate": false }
              },
              "$andet": { ".validate": false }
            }
          },
          "$andet": { ".validate": false }
        }
      },

      // ══════════════════════════════════════════════════════════════
      // MAALINGERNE — det eneste der ikke kan laves bagud
      // ══════════════════════════════════════════════════════════════
      //
      // Abonnementet faktureres paa HOEJESTE antal aktive i perioden. Et
      // slutantal kan ikke rekonstruere en top: en kunde med 30 chauffoerer
      // den 3. og 8 den 31. ville blive faktureret for 8.
      //
      // ⚠ DER STAAR TAL, IKKE RAEKKER. To heltal og en modulliste pr. doegn
      // — ingen navne, ingen nummerplader, ingen mailadresser. Optaellingen
      // sker i en funktion med Admin SDK, saa der ikke skulle aabnes én
      // eneste regel: udbyder-claim'et naar fortsat kun tre noder pr. kunde.
      //
      // ⚠ .write: false. Maalingen skrives af maaldagligt. Kunne en klient
      // skrive den, kunne den skrive sin egen regning ned.
      "maalinger": {
        ".read": "auth != null && auth.token.udbyder === true",
        ".write": false,
        "$kundeId": {
          "$dato": {
            ".validate": "newData.hasChildren(['ms', 'status'])",
            "ms": { ".validate": "newData.isNumber()" },
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|paused|opsagt)$/)" },
            "koeretoejer": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "ukendteRoller": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "brugere": {
              "chauffoer": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "desktop": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "$andet": { ".validate": false }
            },
            "moduler": { "$modul": { ".validate": "newData.isBoolean()" } },
            "$andet": { ".validate": false }
          }
        }
      },

      // ══════════════════════════════════════════════════════════════
      // RETENTIONSRAPPORTEN — hvad der VILLE blive ryddet op
      // ══════════════════════════════════════════════════════════════
      //
      // Skrives af auditoprydning en gang om maaneden. Den sletter ingenting
      // saa laenge RETENTION_AFGJORT er falsk — se noten i audit-regler.js:
      // et job der slettede revisionsspor paa et tal ingen jurist har sagt
      // god for, kan ikke goere det om.
      //
      // ⚠ RAPPORTEN BAERER INGEN AUDITPOSTER. Kun tenant, klasse, aar,
      // maaned og et ANTAL. En auditpost kopieret ud i en rapport under
      // udbyder/ havde forladt kundens tenant — og det er den graense
      // beslutning 24 holder. $andet: false haandhaever det.
      //
      // ⚠ .write: false. Rapporten skrives af jobbet. Kunne en klient skrive
      // den, kunne den skrive "intet forfaldent" og lukke spoergsmaalet.
      "retention": {
        ".read": "auth != null && auth.token.udbyder === true",
        ".write": false,
        "$dato": {
          ".validate": "newData.hasChildren(['koertMs'])",
          "koertMs": { ".validate": "newData.isNumber()" },
          "iAlt": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
          "forfaldne": { "$i": { ".validate": "newData.hasChildren(['tenantId', 'klasse'])" } },
          "slettede": { "$i": { ".validate": "newData.hasChildren(['tenantId', 'klasse'])" } },
          "$andet": { ".validate": false }
        }
      },

      "kunder": {
        ".read": "auth != null && auth.token.udbyder === true",
        ".write": false,
        ".indexOn": ["oprettetMs", "status"]
      }
    }
  }
}

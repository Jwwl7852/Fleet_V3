// FleetControl 3.0 — Realtime Database security rules
//
// BEMÆRK om kommentarer: RTDB-regler tillader //-kommentarer som her, men
// IKKE "//": "tekst" som nøgle. En nøgle der ikke starter med '.' læses som
// et stinavn, og et stinavn skal pege på et objekt. Filen brugte den forkerte
// form indtil punkt 0 blev afprøvet i emulatoren — reglerne kunne altså slet
// ikke indlæses. Kør `npm run test:rules` efter hver ændring her.
//
// BESLUTNING 15 — division er et FELT, ikke en sti. Tre værdier:
//   gods | bus | faelles
// Transaktioner hører til én afdeling. Reservationer og fravær har INGEN
// division — de arver fra ressourcen. Gav man en reservation en division,
// ville en chauffør med C+D få to kalendere, og så er beslutning 4 brudt et
// niveau højere oppe.
//
// BESLUTNING 19 — stamdata har ikke en division. En medarbejder er defineret
// ved sine KOMPETENCER, et køretøj ved sin ART. Feltet er derfor FORBUDT på
// personale/ og koeretoejer/, ikke bare valgfrit. faelles bevares på kunder,
// hvor værdien betyder at kundens forretning går på tværs.
//
// Kræver division:  opgaver, indberetninger, etaper, lagre, indkoeb, kunder
// Forbyder den:     personale, koeretoejer, kompetencer, fravaer
{
  "rules": {
    ".read": false,
    ".write": false,

    "tenants": {
      // Tenant kommer fra custom claim, ALDRIG fra klienten. Rolleskift skal
      // følges af revokeRefreshTokens, ellers beholder brugeren sin gamle
      // adgang indtil tokenet udløber.
      //
      // _findes-MARKØREN. Hver regel herunder kræver at tenanten faktisk er
      // oprettet. Uden den sammenligner reglerne kun claim'et med
      // STISEGMENTET: en token med tenant "spoegelse" ville matche
      // tenants/spoegelse og dermed kunne skrive en helt ny tenant frem.
      // Det er ikke et adgangsbrud — man ser stadig ikke andres data — men
      // det forurener databasen med tenants ingen har oprettet, og de er
      // usynlige indtil nogen leder. Læsesiden er med af samme grund: et
      // opdigtet claim skal ikke kunne få bekræftet at en node er tom.
      //
      // Markøren kan kun sættes med Admin SDK, som går uden om reglerne. En
      // tenant kan derfor kun opstå ved provisionering — aldrig som
      // bivirkning af en skrivning.
      "$tenantId": {

        // Ingen .write. Kan markøren skrives eller slettes fra klienten, er
        // hele tjekket teater — og en sletning ville spærre ens egen tenant.
        "_findes": {
          ".write": false
        },

        // ══════════════════════════════════════════════════════════════
        // DE TO NODER UDBYDEREN OGSAA MAA LAESE
        // ══════════════════════════════════════════════════════════════
        //
        // ⚠ UDBYDERKONSOLLEN LAESER IKKE KUNDEDATA. Overhovedet. Den
        // administrerer kundeposten — navn, CVR, hvilke moduler — og de to
        // noder her er ALT hvad et udbyder-claim giver adgang til under
        // tenants/. Alt operationelt kraever stadig
        // auth.token.tenant === $tenantId, praecis som foer.
        //
        // Det er samme princip som beslutning 24: support fik ikke
        // audit.laes paa kundens tenant, den fik et bundet UDTRAEK paa
        // sagen. Giv ikke adgang — lever en afgraenset artefakt.
        //
        // ⚠ REGLERNE LIGGER PAA BOERNENE, ikke paa tenants/$tenantId. En
        // .read dér ville KASKADERE ned over alt, og saa havde udbyderen
        // adgang til hver eneste kundes drift med én linje. Se noten paa
        // tenants/$tenantId om hvorfor den bevidst ikke har nogen .read.
        //
        // .write er false BEGGE steder: kundeposten skrives kun af
        // provisioneren eller en udbyderfunktion med Admin SDK. Hverken
        // kunden eller udbyderen skriver den fra en browser.

        // Virksomhedens stamoplysninger. Kunden laeser sit eget navn i
        // sidebaren; udbyderen laeser det for at kunne vise kundelisten.
        "virksomhed": {
          ".read": "auth != null && ((auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()) || auth.token.udbyder === true)",
          ".write": false
        },

        // ⚠ MODULAFKRYDSNING ER EN KOMMERCIEL KONTROL, IKKE EN
        // SIKKERHEDSKONTROL. En kunde uden Facility der taster /facility,
        // ser SIN EGEN tomme facility-node — en salgsflade, ikke et
        // databrud. At kunder ikke kan naa HINANDENS data er en anden
        // mekanisme, og den maa ikke forveksles med den her. Se
        // fleet/moduler.js.
        // ══════════════════════════════════════════════════════════════
        // ABONNEMENTET — det ENE sted en kundes tilstand staar
        // ══════════════════════════════════════════════════════════════
        //
        // status: aktiv | paused | opsagt.
        //
        // ⚠ DEN LIGGER UNDER TENANTEN, IKKE I UDBYDERINDEKSET. Den stod i
        // udbyder/kunder/<id>/status, hvor KUNDEN ikke kan laese den — og
        // saa kan skaermen ikke fortaelle ham hvorfor han er lukket ude.
        // Samme begrundelse som navnet og modulerne: ét sted, ikke
        // kopieret ind i indekset hvor de to kunne drive fra hinanden.
        //
        // ⚠ LAESEREGLEN HAR IKKE aaben-KLAUSULEN. Den maa ikke have den:
        // det er DENNE node der lukker alle de andre, og kunne den ikke
        // laeses naar den var lukket, ville appen ikke kunne sige hvorfor.
        // En spaerring der ikke kan forklare sig selv, ligner en fejl.
        //
        // ⚠ .write ER false. Statussen saettes af en udbyderfunktion med
        // Admin SDK. En klient der maa skrive den for ÉN tenant, kan
        // skrive den for dem alle — reglen kan ikke kende forskel paa
        // "min kunde" og "en anden kunde", naar begge er kunder.
        "abonnement": {
          ".read": "auth != null && ((auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()) || auth.token.udbyder === true)",
          ".write": false,
          ".validate": "newData.hasChildren(['status', 'aendretMs'])",
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|paused|opsagt)$/)" },
          "aendretMs": { ".validate": "newData.isNumber()" },
          // Hvem der gjorde det. ⚠ uid, ikke personId: det er hvem der
          // GJORDE noget, og det er en ejer uden for kundens personale.
          "aendretAf": { ".validate": "newData.isString() && newData.val().length > 0" },
          // ⚠ ALLOWLISTE, IKKE FRITEKST. Aarsagen ender i auditloggen, og
          // fritekst dér er praecis det audit-regler.js findes for at
          // holde ude.
          "aarsag": { ".validate": "newData.isString() && newData.val().matches(/^(betaling|kundeoensket|proeveperiodeUdloebet|fejloprettet)$/)" },

          // ══════════════════════════════════════════════════════════
          // ABONNEMENTSVILKAAR — skrives af kundeabonnement
          // ══════════════════════════════════════════════════════════
          //
          // ⚠ RABAT I BASISPOINT SOM HELTAL. 1500 = 15,00 %. Samme
          // begrundelse som oere (beslutning 2) og millimeter paa et
          // koeretoej: 15.5 som float giver afrundingsfejl der foerst
          // dukker op paa faktura nummer fyrre.
          //
          // ⚠ 0-10000. En rabat over 100 % ville give en NEGATIV sats,
          // altsaa en kreditnota forkleaedt som et abonnement.
          "rabatBps": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000" },

          // ⚠ RABAT PR. MODUL. Noeglen er modulnavnet; en rabat paa et
          // modul der ikke findes, ville ligge og se ud som en aftale ingen
          // kunne finde igen.
          //
          // ⚠ DEN GENERELLE rabatBps OVERRULER DE HER. Reglen staar i
          // rabatFor() i priser.js — ikke to steder. Reglerne validerer kun
          // FORMEN; hvad der vinder, afgoeres ét sted i koden.
          "rabatModulBps": {
            "$modul": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0 && newData.val() <= 10000" }
          },

          // Kun maaned indtil videre. En kvartalsfaktura er ikke en anden
          // sats — det er en anden PERIODE, og generatoren skal kende den.
          // Et felt der lover noget der ikke virker, er vaerre end intet.
          "interval": { ".validate": "newData.isString() && newData.val().matches(/^(maaned)$/)" },
          "startetMs": { ".validate": "newData.isNumber()" },

          "$andet": { ".validate": false }
        },
        "moduler": {
          ".read": "auth != null && ((auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists()) || auth.token.udbyder === true)",
          ".write": false
        },

        // ROLLER — tenantens FAKTISKE rolledefinitioner.
        //
        // roller/<rolleId>/{ navn, perms: ["booking.foreslaa", ...] }
        //
        // perms er et ARRAY og ikke et map: RTDB-noegler maa ikke indeholde
        // punktum, og permission-navnene gor. perms/booking.foreslaa: true er
        // altsaa umuligt. Arrayet er ogsaa det permsFraRolle() returnerer.
        //
        // ROLLE_PERMS i permissions.js er provisioneringsstandarden: hvad en
        // NY tenant faar ved oprettelse. Denne node er hvad tenanten faktisk
        // har, og en kunde skal kunne fjerne fx booking.vaerdiLaes fra sin
        // disponent-rolle uden at nogen skriver kode.
        //
        // Claim'et forbliver haandhaevelsespunktet: reglerne slaar IKKE op
        // her ved hver skrivning. Den Cloud Function der udsteder claims
        // laeser noden, og en aendring traeder i kraft ved naeste
        // token-fornyelse — eller straks med revokeRefreshTokens.
        //
        // .write: false INDTIL den funktion findes, og det er med vilje haardt
        // frem for dokumenteret. Kunne man redigere en rolle nu, ville
        // claim'et ikke blive opdateret: man ville tro man havde fjernet en
        // permission, som stadig virkede. Det er den vaerste fejltilstand af
        // alle, for den ser ud som om den lykkedes. En fejl er bedre end
        // tavshed.
        //
        // Naar funktionen findes, aabnes den for admin med roller.skriv — og
        // aendringer skal auditeres.
        "roller": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false
        },

        // ══════════════════════════════════════════════════════════════
        // BRUGERINDEKSET — fordi en klient ikke kan liste konti
        // ══════════════════════════════════════════════════════════════
        //
        // ⚠ FIREBASE AUTH HAR INGEN listUsers PAA KLIENTSIDEN. Skaermen
        // kunne derfor ikke vise hvem der har adgang — og en opdigtet
        // brugerliste er vaerre end ingen: den viser konti der ikke findes
        // og skjuler dem der goer.
        //
        // Noden her er et INDEKS skrevet af den Cloud Function der opretter
        // brugeren. Den er ikke sandheden — Auth er sandheden — men den er
        // det eneste en klient kan laese, og funktionen skriver begge dele i
        // samme kald.
        //
        // Alternativet var at lade funktionen liste ALLE konti og filtrere
        // paa tenant. Det skanner hver eneste kundes brugere ved hvert
        // opslag, og en filtrering man selv skriver, er en filtrering man kan
        // komme til at glemme. Et indeks pr. tenant kan ikke laekke paa
        // tvaers, fordi det ligger UNDER tenanten.
        //
        // ⚠ INGEN LOESEN, INGEN CLAIMS. Kun navn, mail, rolle og om kontoen
        // er spaerret. Claims staar i tokenet, hvor de hoerer hjemme; laa de
        // ogsaa her, ville de to kunne drive fra hinanden — og indekset ville
        // vaere det man kiggede paa.
        //
        // .read er tenant-medlemskab som paa roller: hvem der arbejder her, er
        // ikke hemmeligt for kollegerne. .write er false — indekset skrives
        // kun af funktionen, sammen med den rigtige konto.
        "brugere": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false,
          ".indexOn": ["rolle", "spaerret"]
        },

        // KLASSIFICEREDE SATELLITTER (beslutning 17).
        // 
        // securityInformation, privatePickupAddress, sensitiveNotes, liveGPS,
        // og fravaerets art (sygdom vs. ferie — helbredsoplysning, GDPR art. 9).
        // 
        // De ligger som SOESKENDE og ikke som barn af objektet. Var sensitive et
        // barn af bookinger/<id>, skulle .read flyttes ned paa bookinger/<id>/general
        // for ikke at kaskadere — og saa kunne man ikke laengere FORESPOERGE paa
        // bookinger. RTDB kraever laeseadgang paa den node man forespoerger paa, saa
        // der ville ikke findes en bookingliste. Soeskende koster eet ekstra opslag
        // paa en detaljeskaerm og nul paa en liste.
        // 
        // Bemaerk at der IKKE er .read paa 'sensitive' selv. Laegges den der,
        // kaskaderer den ned over alle objekterne, og saa er hele opdelingen vaek.
        // 
        // Skrivning kraever BAADE objektets .skriv OG dets sensitiveLaes: kan man
        // ikke laese feltet, skal man heller ikke kunne overskrive det i blinde.
        // sensitive/bookinger er .write: false som bookinger selv.
        "sensitive": {
          "bookinger": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|booking.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
            ".write": false
          },
          "kunder": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|kunder.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('kunder').val() === true)",
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|kunder.skriv|') && auth.token.perms != null && auth.token.perms.contains('|kunder.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('kunder').val() === true)"
          },
          "koeretoejer": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)",
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.skriv|') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)"
          },
          "personale": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|personale.sensitiveLaes|')",
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|personale.skriv|') && auth.token.perms != null && auth.token.perms.contains('|personale.sensitiveLaes|')"
          },
          "fravaer": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|fravaer.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true)",
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|fravaer.skriv|') && auth.token.perms != null && auth.token.perms.contains('|fravaer.sensitiveLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true)"
          }
        },
        // VAERDIANSAETTELSE — eget undertrae, ikke en del af sensitive/.
        // 
        // cargoValue og andre beloeb paa selve godset.
        // 
        // Hvorfor ikke bare i sensitive/? Fordi .read er PR. NODE, og de to skal
        // have hver sin permission. Disponenten skal vide at godset kraever
        // foelgebil (sensitive) — ikke at det er 18 millioner vaerd (vaerdi). To
        // permissions kan ikke dele een node, saa de maa ligge hver for sig.
        // 
        // De er SIDEORDNEDE, ikke trin: sensitiveLaes giver ikke vaerdiLaes.
        "vaerdi": {
          "bookinger": {
            ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|booking.vaerdiLaes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
            ".write": false
          }
        },
        // PERSONALE — beslutning 18. Ligger i BASEN: enhver
        // abonnementskombination har medarbejdere.
        //
        // Noeglen er et personId, ikke et uid. En person findes foer sit login
        // og efter det — en chauffoer har maaske aldrig et, en vikar sjaeldent.
        // uid er hvem der GJORDE noget (indberetninger.oprettetAf, auditloggen);
        // personId er hvem det HANDLER OM (reservationer, fravaer, opgaver,
        // etaper, kompetencer). Bytter man om, holder ejerskabstjekket i
        // reglerne op med at virke.
        //
        // .write ligger paa $personId og ikke paa samlingen, saa
        // newData.exists() kan afvise en SLETNING. En fratraadt medarbejder
        // bliver staaende — der haenger reservationer og indberetninger paa
        // id'et. Paa samlingen ville newData stadig findes efter at een person
        // var slettet.
        //
        // INGEN DIVISION — beslutning 19. Stamdata har ikke en division. En
        // medarbejder er defineret ved sine KOMPETENCER, ikke ved en afdeling:
        // hun oprettes een gang og virker i alle moduler tenanten har adgang
        // til. Feltet er derfor forbudt her, ikke bare valgfrit — et felt der
        // maa staa der, men ikke betyder noget, bliver udfyldt og derefter
        // laest af nogen. Samme behandling som fravaer og kompetencer.
        "personale": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|personale.laes|')",
          ".indexOn": ["uid", "status"],
          "$personId": {
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|personale.skriv|') && newData.exists()",
            ".validate": "newData.hasChildren(['navn', 'status'])",
            "division": { ".validate": false },
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|orlov|fratraadt)$/)" },
            "ansaettelsesform": { ".validate": "newData.isString() && newData.val().matches(/^(fastansat|vikar|ekstern)$/)" },
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" },
            // ⚠ uid ER HVEM DER GJORDE NOGET. personId er hvem det HANDLER om,
            // og noeglen her ER et personId. Feltet er VALGFRIT med vilje: en
            // chauffoer har maaske aldrig et login, og en vikar har det
            // sjaeldent. Personen findes foer sin konto og efter den.
            "uid": { ".validate": "newData.isString() && newData.val().length > 0" },

            // Felterne herunder kom med skrivningen. De kunne laeses laenge
            // foer reglerne kendte dem — saa laenge ingen skrev, var det
            // harmloest.
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },

            // ⚠ FUNKTIONER ER ET MAP, IKKE ET ARRAY. funktioner/{chauffoer:true}
            // kan indekseres og forespoerges ("hvem er mekanikere"); et array
            // kan ikke. Noeglen skal vaere en kendt funktion — ellers staar en
            // tastefejl som en funktion ingen skaerm kender.
            "funktioner": {
              "$funktion": {
                ".validate": "newData.isBoolean() && $funktion.matches(/^(chauffoer|buschauffoer|mekaniker|lager|terminal|disponent|administration)$/)"
              }
            },

            // ⚠ IKKE EN ENUM — samme begrundelse som hjemsted paa et koeretoej.
            // Stederne er DENNE tenants, og et nyt depot maa ikke kraeve en
            // udrulning.
            "stationeret": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },

            "telefon": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "ansatMs": { ".validate": "newData.isNumber()" },
            // ⚠ EN FRATRAADT MEDARBEJDER HARDSLETTES ALDRIG. Der haenger
            // reservationer, indberetninger og bookinger paa personId'et —
            // .write kraever i forvejen newData.exists(). Datoen er sporet.
            "fratraadtMs": { ".validate": "newData.isNumber()" },

            // CPR og privatadresse hoerer i sensitive/personale, ikke her.
            "cpr": { ".validate": false },
            "privatAdresse": { ".validate": false }
          }
        },

        // KOMPETENCER — egen node, ikke en undernode af personale.
        //
        // Samme begrundelse som etaper i beslutning 16: "hvilke kompetencer
        // udloeber inden for 30 dage?" kan ikke stilles under
        // personale/<id>/kompetencer/, fordi RTDB kun forespoerger paa
        // boernene af een node. Man ville skulle hente hele personalet ned og
        // lede. Det er tredje gang samme argument afgoer en placering — se
        // moenstret i ARKITEKTUR.
        //
        // Ingen division: den arves fra personen, som reservationer og fravaer.
        // Ingen laes-permission: der er ingen klassificeret satellit at
        // kontrastere imod — se noten ved bookingLaes i permissions.js.
        "kompetencer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true)",
          ".indexOn": ["udloeberMs", "personId", "type"],
          "$kompetenceId": {
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|kompetencer.skriv|') && newData.exists() && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true)",
            ".validate": "newData.hasChildren(['personId', 'type', 'udloeberMs'])",
            "udloeberMs": { ".validate": "newData.isNumber()" },
            "division": { ".validate": false }
          }
        },

        // Aggregerede nøgletal. Skrives kun af Cloud Functions — ellers kan
        // Dashboard og modulerne komme til at vise forskellige tal igen.
        "kpi": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false
        },

        // Konfliktfrihed kan ikke garanteres fra klienten: to disponenter kan
        // ramme samme sekund. Skrivning går gennem en Cloud Function der
        // tjekker overlap i en transaction.
        // Ingen division her — reservationen arver fra ressourcen.
        "reservationer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
          ".write": false,
          "$ressourceType": {
            "$ressourceId": {
              ".indexOn": ["fra"]
            }
          }
        },

        // Tilstandsskift valideres server-side mod booking-state.js. En
        // disponent må ikke godkende sit eget forslag, og reservationen skal
        // oprettes atomisk sammen med skiftet.
        // historik under $bookingId er append-only og slettes aldrig.
        "bookinger": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|booking.laes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
          ".write": false,
          ".indexOn": ["tilstand", "oprettetMs", "kundeId"]
        },

        // BESLUTNING 16 — etaper ligger som EGEN node, ikke under bookingen.
        // RTDB forespoerger kun paa boernene af een node, og matchningen skal
        // kunne finde "alle aabne etaper paa tvaers af bookinger" med
        // orderByChild("tilstand").equalTo("aaben"). Laa de under hver sin
        // booking, skulle samtlige bookinger hentes ned og gennemsoeges.
        // Flyt dem ikke ind under bookinger — se README.
        //
        // .write: false af samme grund som bookinger: tilstandsskiftet skal
        // ske atomisk sammen med reservationen, ellers kan etapens
        // koeretoejId og dens reservation naa at vaere uenige.
        "etaper": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
          ".write": false,
          ".indexOn": ["tilstand", "bookingId", "senestMs"],
          "$etapeId": {
            ".validate": "newData.hasChildren(['division'])",
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            }
          }
        },

        // Lagerstamdata: kapacitet og satser. Kapaciteten laeses af
        // tjekLedig() naar den summerer belastningen over et tidsrum.
        "lagre": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|lagre.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true)",
          "$lagerId": {
            ".validate": "newData.hasChildren(['division'])",
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            },
            "satser": { ".indexOn": ["gyldigFra"] },
            "haandteringSatser": { ".indexOn": ["gyldigFra"] }
          }
        },

        // Booking-, fragtbrev- og fakturanumre. Kun via transaction i en
        // Cloud Function.
        "countere": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false
        },

        // FAKTURAGRUNDLAGET — beslutning 25.
        //
        // ⚠ .write: false FOR ALLE, OGSAA ADMIN. Et grundlag faar sit nummer
        // fra en counter i en transaction (beslutning 8), skifter tilstand
        // efter kanGodkende()'s regler, og et LAAST grundlag maa aldrig kunne
        // aendres. Ingen af de tre kan haandhaeves af en klient, og et
        // regnskabsdokument der kan rettes i haanden, beviser ingenting.
        // Skrivning sker gennem en Cloud Function — den findes endnu ikke, og
        // nummerserier staar som et kendt hul i README.
        //
        // ⚠ INGEN MODULKLAUSUL, som fakturaer og satser. Grundlaget roeres af
        // BOOKING (turen), WAREHOUSE (lagerafregningen) og OEKONOMI
        // (skaermen). En klausul paa eet af dem ville spaerre de to andre.
        //
        // ⚠ HARDSLETTES ALDRIG. Regnskabsdata tages ud af drift med en
        // tilstand og en erstatning — erstat() i grundlag.js — ikke ved at
        // forsvinde. Der er derfor heller ingen vej til en sletning her.
        "grundlag": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false,
          ".indexOn": ["kundeId", "bookingId", "tilstand", "udarbejdetMs"],
          "$grundlagId": {
            ".validate": "newData.hasChildren(['kundeId', 'tilstand', 'udarbejdetMs'])",
            // GRL-AAAA-NNNNN. Eet format, een mekanisme (beslutning 8).
            "nummer": { ".validate": "newData.isString() && newData.val().matches(/^GRL-[0-9]{4}-[0-9]{5}$/)" },
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            "bookingId": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "division": { ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)" },
            "tilstand": { ".validate": "newData.isString() && newData.val().matches(/^(kladde|godkendt|laast)$/)" },
            // ⚠ uid, IKKE personId. Det er hvem der GJORDE noget.
            "udarbejdetAf": { ".validate": "newData.isString()" },
            "udarbejdetMs": { ".validate": "newData.isNumber()" },
            "godkendtAf": { ".validate": "newData.isString()" },
            "godkendtMs": { ".validate": "newData.isNumber()" },
            "laastMs": { ".validate": "newData.isNumber()" },
            "eksportReference": { ".validate": "newData.isString() && newData.val().length <= 120" },
            // ⚠ REFERENCEN GAAR BEGGE VEJE. erstat() kraever nytId op front,
            // fordi et erstattet grundlag stadig findes og ellers ville taelle
            // med — en rettelse maa ikke vaere en fordobling.
            "erstatterId": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "erstattetAfId": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "linjer": {
              "$linjeId": {
                ".validate": "newData.hasChildren(['art', 'antal', 'satsOere'])",
                "art": { ".validate": "newData.isString() && newData.val().matches(/^(koersel|ventetid|tillaeg|materiale|manuel)$/)" },
                "tekst": { ".validate": "newData.isString() && newData.val().length <= 200" },
                // Maengder som TUSINDEDELE og beloeb i hele OERE — ANTAL_SKALA
                // i beloeb.js. To skalaer fakturerer 1000x forkert.
                "antal": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
                "satsOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
                "enhed": { ".validate": "newData.isString() && newData.val().length <= 20" },
                // ⚠ MOMSSATSEN GAETTES IKKE. Feltet maa MANGLE — det er det
                // rigtige svar indtil en bogholder har svaret — men staar den
                // der, skal den vaere et tal. Se validerLinje() i grundlag.js.
                "momssats": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
                "kilde": {
                  ".validate": "newData.hasChildren(['type', 'id'])",
                  "type": { ".validate": "newData.isString() && newData.val().matches(/^(etape|indberetning|bevaegelse)$/)" },
                  "id": { ".validate": "newData.isString() && newData.val().length <= 60" },
                  "$andet": { ".validate": false }
                },
                "$andet": { ".validate": false }
              }
            },
            "historik": {
              "$postId": {
                ".validate": "newData.hasChildren(['hvad', 'ms'])",
                "hvad": { ".validate": "newData.isString() && newData.val().matches(/^(oprettet|aendret|godkendt|laast|erstattet)$/)" },
                "af": { ".validate": "newData.isString()" },
                "ms": { ".validate": "newData.isNumber()" },
                "reference": { ".validate": "newData.isString() && newData.val().length <= 120" },
                "begrundelse": { ".validate": "newData.isString() && newData.val().length <= 300" },
                "$andet": { ".validate": false }
              }
            },
            "$andet": { ".validate": false }
          }
        },

        // OMKOSTNINGER — hvad turen KOSTER os. IKKE hvad kunden betaler.
        //
        // ⚠ TO NODER, FORDI TALLENE IKKE MAA BLANDES. `satser` er kundens
        // pris; her staar km-omkostningen paa bilen, faergen, broen,
        // agentparkeringen og vejafgiften. Beslutning 11 findes praecis for
        // den forskel: driftsomkostning pr. km er ikke kalkulationspris pr.
        // km. Storebaelt koster 887 kr og faktureres maaske til 950 — laa de
        // to i samme node, ville en sum blande indtaegt og udgift.
        //
        // ⚠ PERMISSIONEN ER SATSER.SKRIV, og det er en beslutning: det er den
        // samme person der saetter begge, og en permission mere skulle gives
        // til noejagtig de samme. Noderne er delt fordi tallene ikke maa
        // blandes, ikke fordi adgangen skulle deles.
        //
        // ⚠ SATSARKET STOD SOM EN const I Bookingopsaetning.jsx indtil
        // PRISER.md etape 5. Skaermen viste et satsark ingen kunne rette.
        "omkostninger": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|satser.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('booking').val() === true)",
          "$id": {
            // ⚠ EN BILOMKOSTNING BAERER INTET NAVN OG INGEN DIVISION.
            // Navnet staar paa koeretoejet — skrives det ogsaa her, driver de
            // to fra hinanden, og det var netop advarslen i den gamle
            // JSX-fil. Og en bil har ingen division (beslutning 19): et
            // koeretoej er defineret ved sin ART, ikke ved en afdeling, og
            // reglerne afviser feltet paa koeretoejer/. En km-sats maa ikke
            // indfoere det ad bagvejen.
            ".validate": "newData.hasChildren(['art']) && (newData.child('art').val() !== 'bil' || (!newData.hasChild('navn') && !newData.hasChild('division'))) && (newData.child('art').val() === 'bil' || newData.hasChild('navn'))",
            "art": { ".validate": "newData.isString() && newData.val().matches(/^(bil|passage|agent)$/)" },
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "kategori": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "division": { ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)" },
            // Vejafgiften kommer med uden at nogen vaelger den. Antallet af
            // faerger kommer fra RUTEN; vejafgiften goer ikke.
            "altidPaaBooking": { ".validate": "newData.isBoolean()" },
            "aktiv": { ".validate": "newData.isBoolean()" },
            "satser": {
              ".indexOn": ["gyldigFra"],
              "$satsId": {
                // Samme form som en kundesats — og samme regel: en sats
                // overskrives ALDRIG, den faar en ny post med gyldigFra.
                ".validate": "newData.hasChildren(['gyldigFra', 'beloebOere'])",
                "gyldigFra": { ".validate": "newData.isNumber()" },
                "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "metode": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "valuta": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}$/)" },
                "friDage": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "aktiv": { ".validate": "newData.isBoolean()" },
                "oprettetAf": { ".validate": "newData.isString()" },
                "oprettetMs": { ".validate": "newData.isNumber()" },
                "$andet": { ".validate": false }
              }
            },
            "$andet": { ".validate": false }
          }
        },

        // Satser overskrives ALDRIG — nye poster med gyldigFra. Ellers ændrer
        // en rettelse i dag prisen på en booking fra sidste kvartal.
        "satser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|satser.skriv|')",
          "$gruppe": {
            "$postId": {
              // ⚠ VALIDERINGEN KOM MED PRISERNE. Noden har vaeret her siden
              // beslutning 7, men INTET skrev til den — satsarket stod som en
              // const i Bookingopsaetning.jsx. Nu skal den baere kundepriser,
              // og en node uden validering er en node hvor et beloeb kan vaere
              // en streng.
              "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
              "kategori": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "aktiv": { ".validate": "newData.isBoolean()" },
              "satser": {
                ".indexOn": ["gyldigFra"],
                "$satsId": {
                  ".validate": "newData.hasChildren(['gyldigFra', 'beloebOere'])",
                  // ⚠ EN SATS OVERSKRIVES ALDRIG (beslutning 7). Rettes prisen
                  // i dag, kommer der en NY post med sin egen gyldigFra —
                  // ellers aendrer en rettelse prisen paa en booking fra sidste
                  // kvartal, og saa kan fakturaen ikke forklares.
                  //
                  // Reglen kan ikke forbyde en overskrivning uden ogsaa at
                  // forbyde en rettelse af en tastefejl samme dag. Den
                  // haandhaever formen; beslutningen haandhaeves af skaermen
                  // og af proeven paa den.
                  "gyldigFra": { ".validate": "newData.isNumber()" },
                  // Beloeb i hele OERE som alt andet. En float ville give en
                  // oere til eller fra paa hver eneste linje.
                  "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                  "metode": { ".validate": "newData.isString() && newData.val().length <= 40" },
                  "valuta": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}$/)" },
                  "aktiv": { ".validate": "newData.isBoolean()" },
                  "oprettetAf": { ".validate": "newData.isString()" },
                  "oprettetMs": { ".validate": "newData.isNumber()" },
                  "$andet": { ".validate": false }
                }
              },
              "$andet": { ".validate": false }
            }
          }
        },

        // BESLUTNING 21 — art styrer feltskemaet paa en opgave.
        //
        // ARTEN ER vaerksted | facility, IKKE vaerksted | langtur.
        // README sagde laenge det sidste, men den formulering er aeldre end
        // beslutning 16. Da etaper kom som egen node, blev langtur en DUBLET:
        // fraSted, tilSted, koeretoejId, personId, maengde og senestMs staar
        // allerede paa etapen, og matchAabneEtaper() soeger paa ETAPER. To
        // poster for een tildeling er praecis den fejl beslutning 16 lukkede
        // (DE-QR 777 mod DE-KL 404 i prototypen).
        //
        // Disponering laeser derfor BEGGE noder: dagsvisningen er opgaver med
        // art 'vaerksted', ugesvisningen er etaper.
        //
        // Feltskemaet pr. art staar i fleet/opgaver.js, ikke her. Reglerne
        // haandhaever kun det der vil oedelaegge en beregning eller en
        // forespoergsel — art og division. At kode hvert felts lovlige arter
        // ind i RTDB-regler ville goere filen ulaeselig uden at goere noget
        // sikrere. Samme afvejning som paa koeretoejer.
        //
        // .indexOn har faaet 'art'. Dagsvisningen henter dog paa 'dato' over
        // eet doegns vindue — naar langturene ligger i etaper, er der ingen
        // langture i opgaver at traekke med, og filtreringen paa art koster
        // derfor kun een dags raekker klientside.
        "opgaver": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|opgaver.skriv|')",
          ".indexOn": ["dato", "status", "art", "koeretoejId", "personId"],
          "$opgaveId": {
            ".validate": "newData.hasChildren(['art', 'division'])",
            "art": {
              ".validate": "newData.isString() && newData.val().matches(/^(vaerksted|facility)$/)"
            },
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            }
          }
        },

        // INGEN DIVISION — beslutning 19. Et koeretoej er defineret ved sin
        // ART, ikke ved en afdeling. En paahaengsvogn eller en varevogn kan
        // tilhoere begge slags vognmaend, og det er praecis derfor feltet ikke
        // siger noget: det ville skulle udfyldes paa hver bil uden at kunne
        // begrundes paa nogen af dem. Forbudt frem for valgfrit, af samme
        // grund som paa personale.
        //
        // Bemaerk at opgaver, indberetninger og etaper STADIG kraever
        // division. De er transaktioner (beslutning 15) — men vaerdien kan
        // ikke laengere kopieres fra bilen, og skriveren skal saette den selv.
        "koeretoejer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.laes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)",
          ".indexOn": ["status", "art", "naesteServiceMs"],
          "$koeretoejId": {
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|koeretoejer.skriv|') && newData.exists() && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)",
            ".validate": "newData.hasChildren(['art', 'status'])",
            "art": { ".validate": "newData.isString() && newData.val().matches(/^(traekker|lastbil|varevogn|bus|minibus|scooter|truck|trailer|paahaeng)$/)" },
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|vaerksted|udeAfDrift|solgt|skrottet)$/)" },
            "laengdeMm": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "driftPrKmOere": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "kapacitet": {
              "m3": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "kg": { ".validate": "newData.isNumber() && newData.val() >= 0" }
            },
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" },
            "division": { ".validate": false },

            // ⚠ FELTERNE HERUNDER KOM MED SKRIVNINGEN, IKKE FOER DEN.
            //
            // Skaermen kunne laese dem laenge foer reglerne kendte dem:
            // hjemsted og naesteServiceKm blev lagt i demo-saettet da Flaade
            // skulle vise lokation og "om 1.250 km". Saa laenge ingen skrev,
            // var det harmloest. I det oejeblik en formular skriver, er et
            // uvalideret felt en aaben doer.
            //
            // ⚠ hjemsted er IKKE en enum. Kolding, Aalborg, Vejle og Odense er
            // DENNE tenants steder — en anden vognmand har andre. Et katalog i
            // regelfilen ville betyde at et nyt depot krevede en udrulning.
            // Laengden begraenses i stedet, saa fritekst ikke havner i et felt
            // der vises i en tabel.
            "hjemsted": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },

            // Maalerstand og servicemaal er HELE kilometer. Et komma gav
            // "om 1.249,7 km" i tabellen, og floats summerer ikke praecist
            // over en flaade.
            "kmStand": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "naesteServiceKm": { ".validate": "newData.isNumber() && newData.val() >= 0" },

            // Fristerne er epoch-millisekunder. En dato som streng ville
            // sortere alfabetisk og stille 10-01 foer 9-12.
            "naesteServiceMs": { ".validate": "newData.isNumber()" },
            "synMs": { ".validate": "newData.isNumber()" },

            // Kaldenavnet er det man slaar op paa. Tomt er ikke et navn.
            "kaldenavn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },

            // ⚠ NUMMERPLADEN ER DEN MAN SLAAR OP PAA. Bil 104 havde to i
            // prototypen, og det er den fejl der er dyrest at opdage sent.
            "registrering": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },

            "tachografNr": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "saeder": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "kranTonmeter": { ".validate": "newData.isNumber() && newData.val() >= 0" },

            // ⚠ AFGANG SLETTER IKKE. En solgt bil beholder sin post — der
            // haenger indberetninger og omkostningshistorik paa id'et, og
            // .write kraever i forvejen newData.exists(). Felterne her er
            // sporet efter hvorfor den gik ud af drift.
            "afgangMs": { ".validate": "newData.isNumber()" },
            "afgangAarsag": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" }
          }
        },

        // Chauffører må oprette, men ikke redigere andres. km er TOTAL
        // målerstand, ikke km siden sidste tankning.
        "indberetninger": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)",
          ".indexOn": ["oprettetMs", "koeretoejId", "type"],
          "$id": {
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && ((auth.token.perms != null && auth.token.perms.contains('|indberetninger.skriv|')) && (!data.exists() || data.child('oprettetAf').val() === auth.uid) || auth.token.perms != null && auth.token.perms.contains('|indberetninger.skrivAlle|')) && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('flaade').val() === true)",
            ".validate": "newData.hasChildren(['division'])",
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            }
          }
        },

        // Skriver en reservation med kilde 'fravaer' på chaufføren, så en syg
        // chauffør ikke kan disponeres.
        // INGEN division: fraværet hænger på chaufføren, og en chauffør med
        // C+D er fælles — fraværet blokerer ham i begge afdelinger. Gav vi det
        // en division, ville han være syg i gods og rask i bus.
        "fravaer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|fravaer.laes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|fravaer.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('bemanding').val() === true)",
          ".indexOn": ["fra"],
          "$fravaerId": {
            ".validate": "newData.hasChildren(['personId'])",
            "division": { ".validate": false },
            "art": { ".validate": false },
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" }
          }
        },

        // ⚠ NODEN HAVDE INGEN VALIDERING OVERHOVEDET. Kun .write bag en
        // permission — alt derunder var frit. En lokation uden navn, et anlaeg
        // med en opdigtet art, et areal som streng: alt blev taget imod. Saa
        // laenge ingen skrev, var det harmloest. Piloten skriver.
        "facility": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('facility').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|facility.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('facility').val() === true)",

          "lokationer": {
            ".indexOn": ["type"],
            "$lokationId": {
              ".validate": "newData.hasChildren(['navn', 'type'])",
              "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "type": { ".validate": "newData.isString() && newData.val().matches(/^(hovedkontor|depot|lager|vaerksted)$/)" },
              // ⚠ sted er IKKE en enum — samme begrundelse som hjemsted paa et
              // koeretoej. Stederne er DENNE tenants; et katalog i regelfilen
              // ville betyde at et nyt depot krevede en udrulning.
              "sted": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
              // Kvadratmeter som HELT tal. Et areal maales i hele meter i BBR,
              // og et komma her ville antyde en praecision vi ikke har.
              "arealM2": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "adresse": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "division": { ".validate": false }
            }
          },

          "aktiver": {
            ".indexOn": ["lokationId", "status", "naesteServiceMs"],
            "$aktivId": {
              ".validate": "newData.hasChildren(['navn', 'art', 'status', 'lokationId'])",
              "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              // ⚠ art ER UDSTYRSTYPEN, ikke opgave.art. Samme feltnavn, to
              // vokabularer — se ARKITEKTUR. Blandes de, faar et koeleanlaeg
              // arten 'facility' og forsvinder ud af enhver liste.
              "art": { ".validate": "newData.isString() && newData.val().matches(/^(port|koeleanlaeg|ventilation|vaskehal|ladestander|alarm|truck)$/)" },
              "status": { ".validate": "newData.isString() && newData.val().matches(/^(idrift|fejl|service|udeAfDrift)$/)" },
              // Anlaegget SKAL staa et sted. Et anlaeg uden lokation kan ikke
              // vises i driftsstatus og taeller ikke med noget sted.
              "lokationId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('lokationer').child(newData.val()).exists()" },
              "zoneId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('zoner').child(newData.val()).exists()" },
              "serviceIntervalDage": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "naesteServiceMs": { ".validate": "newData.isNumber()" },
              // ⚠ personId, ALDRIG uid. Den ansvarlige er hvem det HANDLER om;
              // en facilityansvarlig har maaske intet login. Se beslutning 18.
              "ansvarligPersonId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('personale').child(newData.val()).exists()" },
              "division": { ".validate": false }
            }
          },

          // ⚠ ZONEN BAERER GRAENSERNE. Ligger taersklen paa sensoren, skriver
          // en justering i MAALEDATA — og saa er historikken aendret bagud.
          "zoner": {
            ".indexOn": ["lokationId"],
            "$zoneId": {
              ".validate": "newData.hasChildren(['navn', 'art', 'lokationId'])",
              "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "art": { ".validate": "newData.isString() && newData.val().matches(/^(frost|koel|tempereret|kontor)$/)" },
              "lokationId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('lokationer').child(newData.val()).exists()" },
              "graenser": {
                ".validate": "newData.hasChildren(['minC', 'maksC'])",
                // ⚠ MIN SKAL VAERE UNDER MAKS. En zone med byttede graenser
                // alarmerer ALDRIG — alarmTilstand() finder ingen maaling der
                // ligger uden for et interval der er tomt. Det ser ud som om
                // alt er i orden, og det er den vaerste fejltilstand.
                "minC": { ".validate": "newData.isNumber() && newData.val() < newData.parent().child('maksC').val()" },
                "maksC": { ".validate": "newData.isNumber() && newData.val() > newData.parent().child('minC').val()" }
              },
              "division": { ".validate": false }
            }
          },

          // ÉN kilde til sensorværdier. Både Facility-overblik og
          // Klima-skærmen læser herfra — i mockupsene viste de forskellige
          // temperaturer for samme zoner.
          "sensorer": {
            "$zoneId": {
              // ⚠ INGEN graenser HER. Se noten paa zoner. .validate: false
              // afviser feltet, saa fejlen ikke kan indfoeres ved et uheld.
              "graenser": { ".validate": false },
              "aktuel": {
                ".validate": "newData.hasChildren(['tempC', 'ms'])",
                "tempC": { ".validate": "newData.isNumber()" },
                "fugtPct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
                "ms": { ".validate": "newData.isNumber()" }
              },
                "maalinger": {
                ".indexOn": ["ms"],
                "$maalingId": {
                  "tempC": { ".validate": "newData.isNumber()" },
                  "fugtPct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
                  "ms": { ".validate": "newData.isNumber()" }
                }
              }
            }
          },

          "fejl": {
            ".indexOn": ["aktivId", "status", "meldtMs"],
            "$fejlId": {
              ".validate": "newData.hasChildren(['aktivId', 'status', 'alvor', 'meldtMs'])",
              "aktivId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('aktiver').child(newData.val()).exists()" },
              "status": { ".validate": "newData.isString() && newData.val().matches(/^(ny|planlagt|igang|udbedret)$/)" },
              // Samme tre trin som alvorTone() i format.js. Fire vaerdier her
              // og tre dér ville give en pille uden farve.
              "alvor": { ".validate": "newData.isString() && newData.val().matches(/^(hoej|mellem|lav)$/)" },
              "meldtMs": { ".validate": "newData.isNumber()" },
              "beskrivelse": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
              "meldtAf": { ".validate": "newData.isString() && newData.val().length <= 80" },
              "division": { ".validate": false }
            }
          },

          // Bygningsomkostningens KOMPONENTER. Totalen gemmes aldrig — den
          // beregnes af bygningsomkostningOere(). Et gemt totalfelt ville
          // kunne drive fra komponenterne; her er der ingen at drive fra.
          "omkostning": {
            "$post": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && $post.matches(/^(el|varme|vand|ventilation|alarm)$/)"
            }
          }
        },

        // beloebOere er ALTID ekskl. moms. momsOere er et separat felt. Bland
        // dem ikke — ellers lægges inkl.-tal sammen med ekskl.-tal i en rapport.
        // faelles er en lovlig division her: én dieselleverance dækker begge
        // afdelinger. Fordelingsnøglen for fælles omkostninger er udskudt.
        "indkoeb": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|indkoeb.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('indkoeb').val() === true)",
          ".indexOn": ["dato", "leverandoerId", "fakturastatus"],
          "$indkoebId": {
            ".validate": "newData.hasChildren(['division', 'dato', 'leverandoerId', 'vare', 'antal', 'prisPrEnhedOere', 'fakturastatus'])",
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            },

            // ⚠ NODEN VALIDEREDE KUN division. En pris kunne komme ind som
            // FLOAT — 18.5 i stedet for 1850 — og beslutning 2 stod dermed
            // kun i en kommentar. Det er den fejl der ender som 1849,999 i en
            // sum over hundrede linjer, og saa gaar afstemningen mod
            // leverandoerens faktura ikke op med en oere ingen kan forklare.
            //
            // ⚠ HELE OERE. isNumber() alene raekker ikke: 1850.5 er ogsaa et
            // tal. Loftet paa 10 mia. oere (100 mio. kr) er ikke en
            // forretningsregel — det fanger en tastefejl med tre nuller for
            // meget, og et beloeb over det er noget nogen skal se paa.
            "prisPrEnhedOere": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0 && newData.val() <= 10000000000"
            },
            // ⚠ LINJENS BELOEB GEMMES IKKE. Det beregnes af antal x pris —
            // to kilder til samme tal kan drive fra hinanden, og saa mangler
            // en post uden at totalen afsloerer det.
            "beloebOere": { ".validate": false },

            "antal": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "enhed": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "vare": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "varenummer": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "dato": { ".validate": "newData.isNumber()" },
            "aftaltLeveringMs": { ".validate": "newData.isNumber()" },
            "leveretMs": { ".validate": "newData.isNumber()" },

            // ⚠ LEVERANDOEREN ER EN ENTITET, ikke en fritekststreng. Feltet
            // har hele tiden vaeret indekseret; noden fandtes bare ikke.
            // Imens stod navnene i tre demo-filer med hver sin stavemaade.
            "leverandoerId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "kategori": { ".validate": "newData.isString() && newData.val().matches(/^(vaerksted|reservedele|daek|braendstof|facility|kontor|transport)$/)" },
            "fakturastatus": { ".validate": "newData.isString() && newData.val().matches(/^(mangler|modtaget|godkendt|bogfoert|afvist)$/)" },

            // Leverandoerens eget nummer — det man slaar op i naar man ringer,
            // og det der staar paa fakturaen der skal matches. Vores id duer
            // ikke til nogen af delene; leverandoeren kender det ikke.
            "reference": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "formaal": { ".validate": "newData.isString() && newData.val().length <= 200" },

            "koeretoejId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('koeretoejer').child(newData.val()).exists()" },
            "lokationId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('facility').child('lokationer').child(newData.val()).exists()" },

            "godkendtAf": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "godkendtMs": { ".validate": "newData.isNumber()" },

            // ⚠ MOMS ER ET SEPARAT FELT, og beloeb er ALTID ekskl. Bland dem
            // ikke — ellers laegges inkl.-tal sammen med ekskl.-tal i en
            // rapport, og ingen opdager det foer regnskabet ikke stemmer.
            "momsOere": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
            }
          }
        },

        // Bogførte poster slettes ALDRIG. Kun slettet: true med spor.
        "fakturaer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv')",
          ".write": false,
          ".indexOn": ["fakturadatoMs", "leverandoerId", "godkendelsesstatus"]
        },

        // aktiv er indekseret fordi Kunder & Priser henter kundebasen med
        // orderByChild('aktiv').equalTo(true) gennem useListe. Uden indekset
        // FEJLER forespørgslen ikke — RTDB henter hele noden ned og filtrerer
        // i klienten, med en advarsel i konsollen. Vokser basen ud over ét
        // hent, skal sidsteAktivitetMs med, så listen kan skifte til et
        // tidsvindue.
        // ══════════════════════════════════════════════════════════════
        // TURTLEBOOKING — udlejning af transportkasser
        // ══════════════════════════════════════════════════════════════
        //
        // ⚠ IKKE lagre, IKKE bookinger, IKKE kunder. De tre navne var
        // taget: lagre er reservedelslageret under Indkoeb, bookinger er en
        // TRANSPORTOPGAVE med etaper og koeretoej, og kunder er
        // kundekartoteket. To ting med samme navn er beslutning 11 og 14
        // om igen. Se turtlebooking.js.
        //
        // ⚠ FIRE NODER, IKKE ÉT BLOB. Prototypen gemte alt i
        // lagerstyring/state. Det kan ikke beskyttes (alt eller intet), ikke
        // valideres, og to lagermaend der klargoer hver sin kasse i samme
        // minut ville overskrive hinanden UDEN en fejlmeddelelse.

        "kassetyper": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('turtlebooking').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('turtlebooking').val() === true) && auth.token.perms != null && auth.token.perms.contains('|kasser.skriv|')",
          "$typeId": {
            ".validate": "newData.hasChildren(['navn'])",
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "beskrivelse": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "$andet": { ".validate": false }
          }
        },

        // ⚠ PLADSEN ER ET ID MED FELTER — navnet UDLEDES af pladsnavn().
        // Prototypen brugte selve strengen som noegle OG som visningsnavn,
        // og den stod to gange paa hver kasse: omdoebtes en hal, pegede hver
        // eneste kasse paa en plads der ikke fandtes. Samme rettelse som
        // steder.js lavede for hjemsted.
        "reolpladser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('turtlebooking').val() === true || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|reolpladser.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('turtlebooking').val() === true || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["hal"],
          "$pladsId": {
            ".validate": "newData.hasChildren(['hal', 'reol', 'fag', 'hylde', 'plads'])",
            "hal": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "reol": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10" },
            "fag": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10" },
            "hylde": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10" },
            "plads": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10" },
            // ⚠ INTET navn-FELT. Det udledes; et gemt navn ville drive fra
            // sine felter, og saa kunne ingen se hvilket der var rigtigt.
            "navn": { ".validate": false },
            // ⚠ DE FEM FELTER HERUNDER ER WAREHOUSES, OG DE ER VALGFRIE.
            // Noden blev UDVIDET frem for kopieret, fordi transportkasser og
            // kundegods staar paa de samme hylder. Var de paakraevede, gik
            // Turtlebooking i stykker — en plads uden dem opfoerer sig
            // praecis som foer. Se WAREHOUSE.md punkt 3.3.
            "zone": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "type": { ".validate": "newData.isString() && newData.val().matches(/^(hylde|gulvplads|bulk)$/)" },
            // ⚠ karantaene BLOKERER en pluk, den advarer ikke. En vare paa en
            // plads i karantaene er under mistanke.
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|karantaene|lukket)$/)" },
            "temperatur": { ".validate": "newData.isNumber() && newData.val() >= -60 && newData.val() <= 80" },
            "$andet": { ".validate": false }
          }
        },

        "kasser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('turtlebooking').val() === true)",
          ".indexOn": ["status", "type", "pladsId"],
          "$kasseId": {
            ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('turtlebooking').val() === true) && auth.token.perms != null && auth.token.perms.contains('|kasser.skriv|')",
            // ⚠ EN KASSE SLETTES ALDRIG. Der haenger udlaanshistorik paa
            // id'et; en kasse der gaar i stykker, faar status udeAfDrift.
            // Samme regel som en solgt bil (beslutning 18).
            ".validate": "newData.hasChildren(['type', 'status', 'hjemPladsId'])",
            "type": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kassetyper').child(newData.val()).exists()" },
            // ⚠ KLIENTEN MAA KUN SAETTE ledig OG udeAfDrift. "booket" er
            // slet ikke en kassestatus mere — en reservation ER et udlaan, og
            // to steder til samme kendsgerning bliver uenige.
            // klargjort og udlaant er FOELGER af et udlaansskifte og saettes
            // af kasseudlaanskriv, som gaar uden om reglerne (admin-SDK).
            // Sidste led lader en uaendret status blive staaende, saa man kan
            // rette note eller type paa en kasse der er ude.
            // ⚠ SIDSTE LED ER IKKE PYNT: BAADE den gamle og den nye vaerdi
            // skal vaere klientens egne. Uden det matcher "ledig" ogsaa naar
            // kassen kommer FRA udlaant — og saa kan en kasse meldes hjem
            // uden om udlaanet, mens udlaanet stadig siger at museet har den.
            // Foerste led lader en uaendret status blive staaende, saa man kan
            // rette note eller type paa en kasse der er ude.
            "status": { ".validate": "newData.isString() && (newData.val() === data.val() || (newData.val().matches(/^(ledig|udeAfDrift)$/) && (!data.exists() || data.val().matches(/^(ledig|udeAfDrift)$/))))" },
            "hjemPladsId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('reolpladser').child(newData.val()).exists()" },
            // Den nuvaerende plads. ⚠ FRAVAERENDE naar kassen er udlaant —
            // en kasse hos kunden optager ikke en hylde. Prototypen skrev
            // "Udlaant hos kunde" SOM PLADS, og saa kunne ledige pladser
            // ikke taelles.
            // ⚠ SIDSTE LED STOD KUN I valideKasse(). En kontrol der kun
            // findes i frontend, er ikke adgangskontrol — den blev fundet af
            // en proeve i etape 4, to etaper efter den blev skrevet.
            "pladsId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('reolpladser').child(newData.val()).exists() && newData.parent().child('status').val() !== 'udlaant'" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "$andet": { ".validate": false }
          }
        },

        // ⚠ IKKE EN BOOKING. Et kasseudlaan har en periode og en kasse; en
        // booking har etaper, koeretoej og chauffoer. At slaa dem sammen
        // ville vaere beslutning 16 om igen.
        "kasseudlaan": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('turtlebooking').val() === true)",
          ".indexOn": ["kasseId", "sagsnummer", "tilstand", "fra"],
          "$udlaanId": {
            // ⚠ KUN SERVEREN. Et udlaan aendrer TO poster — udlaanet og
            // kassen — og de skal skrives sammen eller slet ikke. Dertil skal
            // perioden proeves mod de eksisterende udlaan, og to lagermaend
            // kan ramme samme sekund. Et konflikttjek i skaermen kan gaas
            // uden om med en direkte skrivning; derfor ligger det i
            // kasseudlaanskriv. Samme grund som reservationer.
            //
            // .validate herunder er formen serveren skal overholde. Den
            // haandhaeves ikke paa admin-SDK'et — det goer valideUdlaan() i
            // functions/delt/turtlebooking.js, som er DEN SAMME fil klienten
            // proever mod.
            ".write": false,
            ".validate": "newData.hasChildren(['kasseId', 'sagsnummer', 'fra', 'til', 'tilstand'])",
            "kasseId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kasser').child(newData.val()).exists()" },
            // ⚠ DEN ENESTE NOEGLE UD AF SYSTEMET. Uden sagsnummer kan en
            // kasse ikke findes igen naar museet ringer.
            "sagsnummer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            "beskrivelse": { ".validate": "newData.isString() && newData.val().length <= 300" },
            // ⚠ TIDSPUNKTER SOM TAL. Samme grund som alle andre Ms-felter:
            // de kan sorteres, sammenlignes og regnes paa uden tidszone.
            "fra": { ".validate": "newData.isNumber()" },
            "til": { ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('fra').val()" },
            "tilstand": { ".validate": "newData.isString() && newData.val().matches(/^(booket|klargjort|udlaant|returneret|annulleret)$/)" },
            // ⚠ uid, IKKE personId. Det er hvem der GJORDE noget.
            "oprettetAf": { ".validate": "newData.isString()" },
            "oprettetMs": { ".validate": "newData.isNumber()" },
            // ⚠ HVORNAAR DET FAKTISK SKETE, ikke hvornaar det var planlagt.
            // fra/til er AFTALEN; de to her er kendsgerningen. Uden dem kan
            // historikken kun sige hvad der var meningen — og "MDT-101 har
            // vaeret ude 126 dage" ville vaere en paastand vi ikke kan staa
            // inde for, hvis kassen kom hjem i forvejen. Saettes af
            // kasseudlaanskriv i selve tilstandsskiftet.
            "udleveretMs": { ".validate": "newData.isNumber()" },
            "returneretMs": { ".validate": "newData.isNumber()" },
            // Den oprindelige fritekst fra prototypens Excel-import. Den
            // bevares saa intet gaar tabt, men der soeges ikke i den.
            "importtekst": { ".validate": "newData.isString() && newData.val().length <= 400" },
            "$andet": { ".validate": false }
          }
        },

        // ══ WAREHOUSE (WMS) — lagerhotel. Kundens gods. ══
        //
        // ⚠ IKKE `lagre`. Den node er reservedelslageret under Indkoeb —
        // VORES egne dele, hvor forbruget er en omkostning paa en bil. Her
        // er varen KUNDENS, og bevaegelsen er en indtaegt. To forskellige
        // ting, og derfor to noder frem for een med et flag.
        "varer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|varer.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["kundeId", "varenummer", "varegruppe"],
          "$vareId": {
            ".validate": "newData.hasChildren(['kundeId', 'varenummer', 'navn', 'enhed', 'sporing'])",
            // ⚠ VAREN ER KUNDENS. Uden en gyldig kunde kan bevaegelsen ikke
            // afregnes, og saa er varen paa lageret uden en modpart.
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            "varenummer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "navn": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "enhed": { ".validate": "newData.isString() && newData.val().matches(/^(stk|kolli|palle|kasse|kg|m3)$/)" },
            // ⚠ SPORINGEN KAN IKKE LAVES OM BAGUD. Faar en vare batch et aar
            // senere, findes der bevaegelser uden — og saa kan et tilbagekald
            // ikke svare paa hvilke kolli der var i partiet.
            "sporing": { ".validate": "newData.isString() && newData.val().matches(/^(ingen|batch|serie)$/)" },
            "varegruppe": { ".validate": "newData.isString() && newData.val().length <= 60" },
            // Millimeter og gram som INTEGER — samme regel som
            // samletLaengdeMm() i flaade.js. En float ved en volumengraense
            // er en fejl der venter, og volumenkalkulatoren regner paa dem.
            "laengdeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "breddeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "hoejdeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "vaegtG": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "minimum": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "aktiv": { ".validate": "newData.isBoolean()" },
            "$andet": { ".validate": false }
          }
        },

        // CARRIEREN — beholderen kundens gods staar i.
        //
        // ⚠ DET ER `kasser` EN GANG TIL, OG SVARET BLEV ALLIGEVEL TO NODER.
        // Fysisk er en carrier og en transportkasse den samme ting, men de
        // baerer hver sin forretning: kassen udlejes pr. sag med sin egen
        // tilstandsmaskine (beslutning 37), carrieren baerer KUNDENS gods og
        // har ejerforhold og indhold. Se WAREHOUSE.md punkt 6.2.
        //
        // ⚠ PRISEN: begge staar paa de SAMME reolpladser. "Er hylden
        // optaget?" har derfor to kilder og besvares eet sted —
        // belaegningPaaPlads() i reolplads.js. Reglerne her holder den ene
        // halvdel af invarianten: en carrier der ikke staar paa lageret, har
        // ingen pladsId.
        //
        // ⚠ PERMISSIONEN ER carriers.skriv OG IKKE kasser.skriv. En
        // WMS-medarbejder hos en kunde uden Turtlebooking skal kunne oprette
        // en beholder — samme faelde som reolpladser.skriv lukkede.
        "carriers": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|carriers.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["status", "pladsId", "kundeId", "transportId"],
          "$carrierId": {
            // ⚠ EN CARRIER SLETTES ALDRIG. Bevaegelseshistorikken haenger paa
            // id'et, og et id der forsvinder, goer historikken uforklarlig.
            // En egen beholder der gaar i stykker, faar udeAfDrift; en
            // engangs der er brugt, faar opbrugt.
            //
            // De to KRYDSFELT-regler staar HER og ikke paa felterne, fordi de
            // skal gaelde uanset hvilket enkeltfelt der skrives. En .validate
            // paa en forfader koerer ogsaa ved en dyb skrivning — det er
            // proevet, se test/rules.kundepriser.test.mjs.
            //
            //  1. Kun en ENGANGS kan vaere opbrugt. En egen kommer retur.
            //  2. En carrier der ikke staar paa lageret, optager INGEN hylde.
            //     Praecis samme regel som en udlaant kasse, og den findes af
            //     samme grund: prototypen skrev "Udlaant hos kunde" SOM
            //     plads, og saa kunne ledige pladser ikke taelles.
            ".validate": "newData.hasChildren(['type', 'ejerforhold', 'status']) && (newData.child('status').val() !== 'opbrugt' || newData.child('ejerforhold').val() === 'engang') && (!newData.hasChild('pladsId') || newData.child('status').val().matches(/^(paaLager|udeAfDrift)$/))",
            "type": { ".validate": "newData.isString() && newData.val().matches(/^(pallekasse|gitterbur|plastkasse|kartonkasse|traekasse)$/)" },
            "ejerforhold": { ".validate": "newData.isString() && newData.val().matches(/^(ejet|engang)$/)" },
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(paaLager|iTransit|udeAfDrift|opbrugt)$/)" },
            // ⚠ FRAVAERENDE ER EN RIGTIG TILSTAND. En carrier der er scannet
            // ind men endnu ikke placeret, staar uden plads — det er de
            // elleve "uden lokation" paa planchen, og noegletallet findes
            // netop for at jage dem. Derfor er feltet ikke paakraevet.
            "pladsId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('reolpladser').child(newData.val()).exists()" },
            // Kundens faste omraade. Godset er KUNDENS (punkt 3.1), og en
            // beholder der peger paa en kunde der ikke findes, kan ikke
            // afregnes.
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            // ⚠ INGEN EKSISTENSKONTROL PAA TRANSPORTEN ENDNU. Planchen bruger
            // baade TRP- og BK-numre, og om en transport ER en etape eller et
            // nyt objekt, er ikke afgjort (WAREHOUSE.md punkt 6.4). En
            // fremmednoegle der peger paa en node vi ikke har valgt, ville
            // laase valget.
            "transportId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            // Millimeter som INTEGER — samme regel som varens maal.
            "laengdeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "breddeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "hoejdeMm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "oprettetMs": { ".validate": "newData.isNumber()" },
            "oprettetAf": { ".validate": "newData.isString()" },
            "$andet": { ".validate": false }
          }
        },

        // ⚠ KUN SERVEREN. En bevaegelse aendrer TO ting — bevaegelsen selv og
        // beholdningen paa en eller to pladser — og de skal skrives sammen
        // eller slet ikke. Skrives kun den ene, staar der varer paa en hylde
        // ingen har lagt der, eller de forsvinder uden spor.
        //
        // Dertil kan to lagermaend ramme samme sekund paa samme hylde. Et
        // laes-saa-skriv uden laas ville lade begge passere hver sin kontrol
        // og lande oven paa hinanden. Samme begrundelse som kasseudlaan.
        //
        // .validate herunder er FORMEN serveren skal overholde. Den
        // haandhaeves ikke paa admin-SDK'et — det goer valideBevaegelse() i
        // functions/delt/warehouse.js, som er DEN SAMME fil klienten
        // proever mod.
        "bevaegelser": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["vareId", "kundeId", "tidspunktMs", "art", "reference", "carrierId"],
          "$bevaegelseId": {
            ".write": false,
            // ⚠ TO SLAGS BEVAEGELSER SIDEN ETAPE 12.
            //
            // En GODSBEVAEGELSE flytter varer mellem beholdere og har vare,
            // kunde og antal. En PLACERING (art putaway) flytter selve
            // beholderen hen paa en hylde og har hverken vare eller antal —
            // godset skifter ikke maengde af at blive baaret et andet sted
            // hen. Et antal paa en placering ville vaere et tal ingen kunne
            // forklare bagefter.
            ".validate": "newData.hasChildren(['art', 'tidspunktMs']) && ((newData.child('art').val() === 'putaway' && newData.hasChildren(['carrierId', 'tilPladsId']) && !newData.hasChild('vareId') && !newData.hasChild('antal')) || (newData.child('art').val() !== 'putaway' && newData.hasChildren(['vareId', 'kundeId', 'antal']) && !newData.hasChild('tilPladsId') && !newData.hasChild('fraPladsId')))",
            "art": { ".validate": "newData.isString() && newData.val().matches(/^(modtag|putaway|flyt|pluk|afsend|retur|optael|justering)$/)" },
            "vareId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('varer').child(newData.val()).exists()" },
            // ⚠ ET HISTORISK FAKTUM, IKKE ET OPSLAG. Hvem varen tilhoerte DA
            // den blev flyttet. Skifter varen ejer, maa sidste kvartals
            // fakturagrundlag ikke aendre sig med tilbagevirkende kraft.
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            // Maengden er skaleret med 1000, som ANTAL_SKALA i beloeb.js. En
            // anden skala her ville fakturere 1000x forkert paa den linje der
            // bandt de to sammen.
            "antal": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            // ⚠ GODSET FLYTTER MELLEM BEHOLDERE. Hylden er beholderens
            // adresse, ikke godsets — se beholdning-noden nedenfor.
            "fraCarrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "tilCarrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            // De to her hoerer KUN til en placering: hvilken beholder der blev
            // sat hvor. Krydsreglen ovenfor holder dem ude af en godsbevaegelse.
            "carrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "tilPladsId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('reolpladser').child(newData.val()).exists()" },
            "fraPladsId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('reolpladser').child(newData.val()).exists()" },
            // ⚠ INTET PUNKTUM. Batchen indgaar i en beholdningsnoegle, og
            // RTDB tillader hverken . # $ [ ] eller / i en noegle.
            "batch": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$/)" },
            "serienummer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "udloebMs": { ".validate": "newData.isNumber()" },
            "tidspunktMs": { ".validate": "newData.isNumber()" },
            // ⚠ uid, IKKE personId. Det er hvem der GJORDE noget.
            "oprettetAf": { ".validate": "newData.isString()" },
            "reference": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "$andet": { ".validate": false }
          }
        },

        // ⚠ SALDOEN. Noeglen er <pladsId>__<vareId>__<batch>, deterministisk,
        // saa den samme hylde og vare ALDRIG kan faa to poster. To poster for
        // samme hylde er DE-QR 777 mod DE-KL 404 igen, denne gang med et
        // lagertal.
        //
        // ⚠ DER FINDES INTET TOTALTAL PR. VARE. Det er en sum, hver gang.
        // Gemtes summen ved siden af, ville de to drive fra hinanden ved den
        // foerste skrivning der ramte den ene og ikke den anden — og saa er
        // det bemanding.ledig igen, med lagervaerdi paa.
        "beholdning": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["carrierId", "vareId", "batch"],
          "$noegle": {
            ".write": false,
            // ⚠ GODSET LIGGER I EN BEHOLDER, IKKE PAA EN HYLDE (etape 12).
            // Noeglen er <carrierId>__<vareId>__<batch>, og hylden er
            // carrierens adresse. Baerer posten OGSAA en pladsId, driver de to
            // fra hinanden foerste gang nogen flytter beholderen — og saa
            // viser hylden varer der fysisk staar et andet sted.
            ".validate": "newData.hasChildren(['carrierId', 'vareId', 'antal'])",
            "carrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "vareId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('varer').child(newData.val()).exists()" },
            "batch": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_][A-Za-z0-9_-]{0,39}$/)" },
            // ⚠ IKKE NEGATIV. En hylde kan ikke rumme minus tolv paller, og
            // en beholdning der kan gaa i minus, skjuler den bevaegelse der
            // manglede.
            "antal": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "senestMs": { ".validate": "newData.isNumber()" },
            "$andet": { ".validate": false }
          }
        },

        // ══ PLUKORDREN — det udgaaende flow ══
        //
        // ⚠ DEN HEDDER plukordrer OG IKKE ordrer. `bookinger` er allerede en
        // ordre i dette hus: en transportopgave med etaper, koeretoej og
        // chauffoer. En plukordre siger hvad der skal UD AF LAGERET, ikke
        // hvem der koerer det hvorhen. En 3PL har begge dele.
        "plukordrer": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|bevaegelser.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["kundeId", "tilstand", "afgangMs", "prioritet"],
          "$ordreId": {
            ".validate": "newData.hasChildren(['kundeId', 'nummer', 'tilstand', 'prioritet', 'afgangMs', 'afsendCarrierId', 'linjer'])",
            "kundeId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('kunder').child(newData.val()).exists()" },
            "nummer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            // ⚠ KLIENTEN MAA IKKE SAETTE `afsendt`. En ordre bliver afsendt
            // fordi varerne FORLADER huset — altsaa fordi der skrives
            // afsendelsesbevaegelser. Kunne tilstanden saettes direkte, kunne
            // en ordre meldes afsendt uden at en palle var roert, og lageret
            // ville stadig staa med godset.
            //
            // Sidste led lader en UAENDRET tilstand blive staaende, saa man
            // kan rette en note paa en afsendt ordre. Samme greb som kassens
            // status i turtlebooking.
            "tilstand": { ".validate": "newData.isString() && (newData.val() === data.val() || (newData.val().matches(/^(kladde|frigivet|annulleret)$/) && (!data.exists() || data.val().matches(/^(kladde|frigivet|annulleret)$/))))" },
            "prioritet": { ".validate": "newData.isString() && newData.val().matches(/^(lav|normal|hoej)$/)" },
            "afgangMs": { ".validate": "newData.isNumber()" },
            // ⚠ HVOR DET PLUKKEDE SKAL STAA. En pluk FLYTTER varen hen et
            // sted; uden pladsen ville godset ikke staa nogen steder mellem
            // hylden og bilen — og det er praecis dér det bliver vaek.
            // ⚠ EN BEHOLDER, IKKE EN PLADS. Det plukkede skal ligge i noget,
            // og efter etape 12 ligger alt gods i en beholder.
            "afsendCarrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "linjer": {
              "$linjeId": {
                ".validate": "newData.hasChildren(['vareId', 'antal'])",
                "vareId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('varer').child(newData.val()).exists()" },
                // Skaleret med 1000, som ANTAL_SKALA i beloeb.js.
                "antal": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0" },
                "$andet": { ".validate": false }
              }
            },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "oprettetAf": { ".validate": "newData.isString()" },
            "oprettetMs": { ".validate": "newData.isNumber()" },
            "afsendtMs": { ".validate": "newData.isNumber()" },
            "$andet": { ".validate": false }
          }
        },

        // ══ OPTAELLINGEN — beviset for at beholdningen passer ══
        //
        // ⚠ KUN SERVEREN. Forventningen skal laeses af DATABASEN i det
        // oejeblik der taelles; sendte klienten den med, ville afvigelsen
        // vaere forskellen mellem hvad brugeren TROEDE der stod og hvad han
        // talte — og saa maaler den ingenting.
        //
        // ⚠ OG POSTEN KAN IKKE RETTES BAGEFTER. En optaelling er en maaling,
        // ikke en holdning. Kunne afvigelsen redigeres, ville optaellingen
        // vaere vejen til at SKJULE et svind frem for vejen til at finde det.
        "optaellinger": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('warehouse').val() === true)",
          ".indexOn": ["carrierId", "vareId", "tidspunktMs", "aarsag"],
          "$optaellingId": {
            ".write": false,
            // ⚠ DER TAELLES I EN BEHOLDER, IKKE PAA EN HYLDE (etape 12). En
            // optaelling af hylden ville skulle summere alt hvad der stod paa
            // den, og saa kunne en afvigelse ikke henfoeres til den beholder
            // hvor den opstod.
            ".validate": "newData.hasChildren(['carrierId', 'vareId', 'forventet', 'taeltAntal', 'afvigelse', 'tidspunktMs'])",
            "carrierId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('carriers').child(newData.val()).exists()" },
            "vareId": { ".validate": "newData.isString() && root.child('tenants').child($tenantId).child('varer').child(newData.val()).exists()" },
            "batch": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$/)" },
            // ⚠ forventet KAN vaere negativ. Er saldoen gaaet i minus, er det
            // netop dét optaellingen skal fange — og et tal der ikke kunne
            // vaere negativt, ville skjule den fejl der udloeste taellingen.
            "forventet": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
            "taeltAntal": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "afvigelse": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
            // Allowliste, ikke fritekst: \"svind\" og \"Svind?\" ville blive to
            // kategorier, og saa kan ingen se om det er samme problem.
            "aarsag": { ".validate": "newData.isString() && newData.val().matches(/^(svind|fejlpluk|fejlmodtagelse|skade|fundet|tastefejl|ukendt)$/)" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "bevaegelseId": { ".validate": "newData.isString()" },
            "tidspunktMs": { ".validate": "newData.isNumber()" },
            "oprettetAf": { ".validate": "newData.isString()" },
            "$andet": { ".validate": false }
          }
        },

        "kunder": {
          ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|kunder.laes|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('kunder').val() === true)",
          ".write": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|kunder.skriv|') && (!root.child('tenants').child($tenantId).child('moduler').exists() || root.child('tenants').child($tenantId).child('moduler').child('kunder').val() === true)",
          ".indexOn": ["navn", "aftaleUdloeberMs", "aktiv"],
          "$kundeId": {
            ".validate": "newData.hasChildren(['division'])",
            "securityLevel": { ".validate": "newData.isString() && newData.val().matches(/^(normal|internal|confidential|restricted)$/)" },
            "division": {
              ".validate": "newData.isString() && newData.val().matches(/^(gods|bus|faelles)$/)"
            },
            // KUNDENS PRISAFVIGELSE — enten en egen pris eller en rabat paa
            // standardprisen. To lag, ikke tre: prisgruppen baerer ikke
            // laengere en pris. Se PRISER.md.
            //
            // ⚠ HVORFOR DEN HAR EN .validate PAA PERMISSIONEN:
            // .write kaskaderer, og `kunder` er skrivbar med kunder.skriv —
            // som casehandler, disponent og koordinator alle har gennem
            // BASIS_DATA. satser.skriv har KUN admin. Uden det her led ville
            // en pris kunne saettes af flere end standardprisen kan, alene
            // fordi den ligger i en anden sti. En .validate kan laese auth og
            // kan stramme dér hvor en .write ikke kan loesnes fra oven.
            //
            // ⚠ HULLET DER BLIVER TILBAGE: .validate koerer IKKE ved en
            // sletning. kunder.skriv alene kan derfor FJERNE en afvigelse,
            // men hverken saette eller aendre den. Det staar skrevet her frem
            // for at blive opdaget, og det er grunden til at der ikke findes
            // en sletteknap i klienten — som skriv.js ikke har en slet().
            //
            // ⚠ OG DEN ARVER $kundeId's EGEN .validate: en pris paa en kunde
            // der ikke findes, mangler `division` efter fletningen og afvises.
            "priser": {
              ".validate": "auth != null && auth.token.perms != null && auth.token.perms.contains('|satser.skriv|')",
              "$ydelseId": {
                "satser": {
                  ".indexOn": ["gyldigFra"],
                  "$satsId": {
                    // ⚠ ENTEN beloebOere ELLER rabatBps — ALDRIG BEGGE.
                    // To felter der begge kan saette prisen, er to svar paa
                    // samme spoergsmaal, og saa bliver det tilfaeldigt hvilket
                    // der vinder.
                    ".validate": "newData.hasChild('gyldigFra') && ((newData.hasChild('beloebOere') && !newData.hasChild('rabatBps')) || (!newData.hasChild('beloebOere') && newData.hasChild('rabatBps')))",
                    "gyldigFra": { ".validate": "newData.isNumber()" },
                    "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                    // Basispoint som i ejerkonsollen: 1500 = 15,00 %. Hele
                    // tal, saa der ikke kommer en afrundingsregel mere.
                    "rabatBps": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000" },
                    "metode": { ".validate": "newData.isString() && newData.val().length <= 40" },
                    "valuta": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}$/)" },
                    "aktiv": { ".validate": "newData.isBoolean()" },
                    "oprettetAf": { ".validate": "newData.isString()" },
                    "oprettetMs": { ".validate": "newData.isNumber()" },
                    "$andet": { ".validate": false }
                  }
                },
                "$andet": { ".validate": false }
              }
            }
          }
        }
      }
    },

    // AUDITLOG — append-only.
    //
    // Hvorfor den ligger her og IKKE under tenants/<id>/audit: RTDB's .read
    // kaskaderer og kan ikke indsnaevres paa et barn. Reglen paa
    // tenants/$tenantId giver laeseadgang til alt nedenunder, og en log over
    // hvem der har set hvad er selv foelsom — den afsloerer hvilke kunder der
    // bliver kigget paa, og af hvem. Som topniveau-node kan den faa sin egen
    // laeseregel. Flyt den ikke ind under tenants/ for at "rydde op".
    //
    // .write: false for ALLE, ogsaa admin. Skrivning sker kun gennem en Cloud
    // Function med Admin SDK, som gaar uden om reglerne. Der findes derfor
    // ingen audit.skriv-permission, og den maa ikke tilfoejes: kan en
    // kompromitteret admin-konto redigere sit eget spor, er loggen vaerdiloes.
    //
    // Stien er audit/<tenantId>/<klasse>/<aar>/<maaned>/<id>. Klassen ligger i
    // stien, fordi retention varierer pr. klasse — saa er sletning "fjern hele
    // partitionen" og ikke en scanning. Se RETENTION_MAANEDER i audit.js.
    "audit": {
      "$tenantId": {
        ".read": "auth != null && auth.token.tenant === $tenantId && root.child('tenants').child($tenantId).child('_findes').exists() && (!root.child('tenants').child($tenantId).child('abonnement').child('status').exists() || root.child('tenants').child($tenantId).child('abonnement').child('status').val() === 'aktiv') && auth.token.perms != null && auth.token.perms.contains('|audit.laes|')",
        ".write": false,
        "$klasse": {
          "$aar": {
            "$maaned": {
              ".indexOn": ["ms", "brugerUid", "objekt", "korrelationsId"]
            }
          }
        }
      }
    },

    // Opslag uid → tenant. Skrives kun server-side. Bruges til at sætte custom
    // claims, ikke til autorisation i sig selv.
    "brugerTenants": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // ══════════════════════════════════════════════════════════════════
    // UDBYDEREN — den ANDEN krydsning af tenant-graensen
    // ══════════════════════════════════════════════════════════════════
    //
    // ⚠ DEN FOERSTE VAR SUPPORT (beslutning 24), og den blev tilladt ÉN
    // gang med vilje: hver krydsning er et sted hvor en fejl giver én kunde
    // adgang til en andens. Den her er den anden, og den er derfor holdt saa
    // smal som muligt.
    //
    // ⚠ NODEN INDEHOLDER INGEN KUNDEDATA. Den er et INDEKS: hvilke tenants
    // findes, hvornaar blev de oprettet, er de aktive. Navnet og modulerne
    // staar i tenants/<id>/virksomhed og /moduler — ét sted, ikke kopieret
    // herind. En kopi ville drive, og udbyderen ville se et andet navn end
    // kunden selv.
    //
    // ⚠ KUN LAESNING. Skrivning sker med Admin SDK gennem provisioneren
    // eller en udbyderfunktion. Et udbyder-claim i en browser kan ikke
    // oprette en kunde — og kan derfor heller ikke oprette sig selv adgang.
    //
    // ⚠ INGEN KUNDEROLLE MAA NOGENSINDE HAVE udbyder-claim'et. Der er en
    // proeve der fastholder at et claim uden det ikke naar noget her, og at
    // et claim MED det ikke naar kundedata. Se rules.udbyder.test.mjs.
    "udbyder": {
      // ══════════════════════════════════════════════════════════════
      // PRISLISTEN — versioneret, aldrig rettet
      // ══════════════════════════════════════════════════════════════
      //
      // ⚠ EN NY PRIS ER EN NY POST. Samme idiom som `gyldigFra` paa en
      // sats: rettede vi en liste, kunne en faktura fra marts ikke
      // genskabes efter en prisstigning i april. Noeglen er et push-id og
      // ikke "2026-01" — et navn nogen selv har skrevet, inviterer til at
      // blive genbrugt.
      //
      // ⚠ MEN VERSIONERINGEN ER IKKE DET DER BESKYTTER MARTS-FAKTURAEN.
      // Det goer FRYSNINGEN: et genereret grundlag gemmer sine egne satser
      // og regner aldrig igen. De to forveksles, og saa bygger man den ene
      // og tror man har den anden.
      //
      // ⚠ MOMSSATSEN STAAR PAA LISTEN OG GAETTES IKKE. Ikke 25, ikke 0 —
      // se validerLinje() i grundlag.js. Uden den kan der ikke eksporteres.
      // ══════════════════════════════════════════════════════════════
      // FAKTURAGRUNDLAGET — frosset, og derfor uskriveligt
      // ══════════════════════════════════════════════════════════════
      //
      // ⚠ ET GRUNDLAG ER ET DOKUMENT, IKKE EN BEREGNING. Genberegnede vi
      // det hver gang skaermen blev aabnet, ville et gammelt grundlag
      // aendre sig naar prislisten eller rabatten aendrede sig — og en
      // faktura fra marts ville faa nye tal i april.
      //
      // ⚠ .write: false OG INGEN VEJ TIL AT RETTE. En rettelse er et NYT
      // grundlag der henviser til det gamle — som erstat() i grundlag.js.
      //
      // ⚠ DEN HER REGEL LAA ÉT DOEGN I facility/sensorer/$zoneId, fordi et
      // anker matchede som UNDERSTRENG. Den gav ingen adgang — en .read
      // gaelder kun ved og under sin egen sti, og den sti findes ikke — men
      // grundlaget kunne ikke laeses, og skaermen viste "ingen prisliste".
      "fakturagrundlag": {
        ".read": "auth != null && auth.token.udbyder === true",
        ".write": false,
        "$periode": {
          "$kundeId": {
            ".validate": "newData.hasChildren(['periode', 'kundeId', 'laast', 'beloebOere'])",
            "laast": { ".validate": "newData.isBoolean() && newData.val() === true" },
            "beloebOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
            "momsOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
            "ialtOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" }
          }
        }
      },

      "prisliste": {
        ".read": "auth != null && auth.token.udbyder === true",
        ".write": false,
        ".indexOn": ["gyldigFraMs"],
        "$listeId": {
          ".validate": "newData.hasChildren(['gyldigFraMs', 'momssats'])",
          "gyldigFraMs": { ".validate": "newData.isNumber()" },
          "momssats": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "oprettetAf": { ".validate": "newData.isString()" },
          "oprettetMs": { ".validate": "newData.isNumber()" },

          // ══════════════════════════════════════════════════════════
          // PLATFORMSADGANGEN — en egen prislinje, ikke dashboard-modulet
          // ══════════════════════════════════════════════════════════
          //
          // ⚠ IKKE `dashboard`. Det modul er en SKAERMSEKTION i sidebaren.
          // Bruges samme id ogsaa som prislinje, er det én ting med to
          // betydninger — og linjen skulle hedde 'Platformsadgang' paa
          // fakturaen og 'Dashboard' i menuen.
          //
          // ⚠ INGEN BRUGERPRIS HER. Den saettes pr. modul; stod den ogsaa
          // her, var der to steder at rette den.
          //
          // ⚠ FRIMAENGDEN HOERER TIL ABONNEMENTET. En bruger er ét login hos
          // kunden, ikke ét pr. modul: laa den paa modulet, ville en kunde
          // med fire moduler à '3 inkluderet' have TOLV gratis brugere.
          "platform": {
            "basisOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "prBrugerOere": { ".validate": false },
            // ⚠ ET HELT ANTAL. En halv inkluderet bruger findes ikke.
            "inkluderetBrugere": {
              "chauffoer": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "desktop": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "$andet": { ".validate": false }
            },
            "$andet": { ".validate": false }
          },
          "moduler": {
            "$modul": {
              // ⚠ OERE SOM INTEGER. Ikke kroner, ikke float — beslutning 2,
              // og den gaelder ogsaa naar det er OS der sender regningen.
              "basisOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "prKoeretoejOere": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              // ⚠ PRISEN PR. BRUGER STAAR PAA MODULET. Fakturaen faar ÉN
              // linje pr. modul OG art, saa hver linje stadig har én
              // stk.pris. FRIMAENGDEN ligger derimod paa platformen — se
              // dér om hvorfor.
              "prBrugerOere": {
                "chauffoer": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "desktop": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "$andet": { ".validate": false }
              },
              "$andet": { ".validate": false }
            }
          },
          "$andet": { ".validate": false }
        }
      },

      // ══════════════════════════════════════════════════════════════
      // MAALINGERNE — det eneste der ikke kan laves bagud
      // ══════════════════════════════════════════════════════════════
      //
      // Abonnementet faktureres paa HOEJESTE antal aktive i perioden. Et
      // slutantal kan ikke rekonstruere en top: en kunde med 30 chauffoerer
      // den 3. og 8 den 31. ville blive faktureret for 8.
      //
      // ⚠ DER STAAR TAL, IKKE RAEKKER. To heltal og en modulliste pr. doegn
      // — ingen navne, ingen nummerplader, ingen mailadresser. Optaellingen
      // sker i en funktion med Admin SDK, saa der ikke skulle aabnes én
      // eneste regel: udbyder-claim'et naar fortsat kun tre noder pr. kunde.
      //
      // ⚠ .write: false. Maalingen skrives af maaldagligt. Kunne en klient
      // skrive den, kunne den skrive sin egen regning ned.
      "maalinger": {
        ".read": "auth != null && auth.token.udbyder === true",
        ".write": false,
        "$kundeId": {
          "$dato": {
            ".validate": "newData.hasChildren(['ms', 'status'])",
            "ms": { ".validate": "newData.isNumber()" },
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(aktiv|paused|opsagt)$/)" },
            "koeretoejer": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "ukendteRoller": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "brugere": {
              "chauffoer": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "desktop": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "$andet": { ".validate": false }
            },
            "moduler": { "$modul": { ".validate": "newData.isBoolean()" } },
            "$andet": { ".validate": false }
          }
        }
      },

      "kunder": {
        ".read": "auth != null && auth.token.udbyder === true",
        ".write": false,
        ".indexOn": ["oprettetMs", "status"]
      }
    }
  }
}
